# 환경변수 이름 목록(값은 적지 않는다. 실제 값은 대표님이 GitHub Secrets·운영 환경에 넣는다)

# DB
DATABASE_URL=
# LISTEN용 직접 연결 주소(PgBouncer transaction 모드를 쓰면 필요)
DATABASE_DIRECT_URL=

# 접속 IP(신뢰 프록시 단계 수, 0이면 X-Forwarded-For를 믿지 않음)
TRUSTED_PROXY_HOPS=

# 휴대폰 본인확인 CI 해시 키(32자 이상)
IDENTITY_HASH_KEY=

# 휴대폰 본인확인 대행사(포트원 V2 + KCP API 방식, 계약 전). 운영에서 셋 중 하나라도 없으면 본인확인 라우트는 503
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_IDENTITY_CHANNEL_KEY=

# 플랫폼 구독 결제(빌링키 암호화 키 32자 이상, 공급자 이름: 개발·테스트는 fake)
BILLING_KEY_SECRET=
BILLING_PROVIDER=

# 판매자 가입 자동 점검(개발·테스트는 BUSINESS_STATUS_PROVIDER=fake)
BUSINESS_STATUS_PROVIDER=
NTS_BUSINESS_STATUS_API_KEY=
MAIL_ORDER_PROVIDER=
FTC_MAIL_ORDER_API_KEY=

# 메일(AWS SES)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
MAIL_FROM_ADDRESS=

# 알림톡·문자
ALIMTALK_API_KEY=
ALIMTALK_API_SECRET=
ALIMTALK_SENDER_KEY=
SMS_SENDER_NUMBER=

# 도우미(Gemini). 없으면 도우미는 「준비 중」으로 꺼진다. 모델·단가·월 한도는 마스터 관리자 도우미 설정(MA-084)에서 정한다
GEMINI_API_KEY=
