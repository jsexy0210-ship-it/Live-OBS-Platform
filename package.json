{
  "name": "live-obs-platform",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "check": "npm run typecheck && npm run build",
    "postinstall": "prisma generate",
    "test": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration --no-file-parallelism",
    "db:migrate": "prisma migrate deploy",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "design:preview": "next dev design/preview --port 3001",
    "design:check": "node scripts/design-map-check.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.19.3",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.0",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "prisma": "6.19.3",
    "typescript": "^5.9.0",
    "vitest": "4.0.18"
  }
}
