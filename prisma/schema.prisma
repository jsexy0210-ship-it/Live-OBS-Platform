// 데이터 모델 정본: docs/ARCHITECTURE.md 4절.
// Prisma 문법으로 표현할 수 없는 제약(부분 유니크 인덱스, CHECK)은 마이그레이션 SQL에 직접 추가한다.
// 판매자 데이터 자식 테이블은 (sellerId, 부모 id) 복합 외래키로 부모를 참조해 다른 판매자 데이터와 묶일 수 없게 한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── 플랫폼 ─────────────

enum PlatformAdminRole {
  SUPER_ADMIN
  OPERATIONS
  CS
  READ_ONLY
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
}

model PlatformAdmin {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String              @unique
  passwordHash String
  name         String
  role         PlatformAdminRole
  status       PlatformAdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?           @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  sessions        AdminSession[]
  approvedSellers Seller[]
}

model AdminSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String    @db.Uuid
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([adminId])
}

// ───────────── 판매자(쇼핑몰)·직원 ─────────────

// 쇼핑몰 운영 상태(SA-060, 대표님 결정 2026-10-05). 파트너스가 바꾼다. 준비 중·일시 정지면 구매자에게 안내 화면만 보이고
// 주문 조회만 열린다(새 주문·결제·장바구니·가입 등은 shopOpen이 막음). 이용 정지·구독 만료와 별개다.
enum ShopOperatingState {
  OPEN
  PREPARING
  PAUSED
}

// 쇼핑몰 대표 주소(SA-060): 기본 주소(플랫폼 주소) 또는 소유 확인이 끝난 내 도메인. CUSTOM은 확인된 도메인이 있어야 저장된다.
enum PrimaryAddressKind {
  DEFAULT
  CUSTOM
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

model Seller {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                     String       @unique
  shopName                 String
  // 한 줄 소개(SA-060, 40자). 쇼핑몰 홈·공유 설명 기본값. 비어 있으면 null.
  shopTagline              String?
  // SA-060 공지·이용안내·대표 주소. 상단 공지(한 줄 60자)·홈 혜택 배너 보이기(기본 보이기)·이용안내/교환/환불 정책 글(1000자)·대표 주소 종류.
  shopTopNotice            String?
  homeBenefitBannerVisible Boolean      @default(true)
  shopUsageGuide           String?
  primaryAddressKind       PrimaryAddressKind @default(DEFAULT)
  // 쇼핑몰 홈 배너 자동 넘김 간격(초, SA-064). 0=끔(기본), 5, 8.
  homeBannerIntervalSec    Int          @default(0)
  // 공유 미리보기(og:title·og:description) 제목·설명. 비어 있으면 쇼핑몰 이름(제목)·없음(설명). 파트너스 쇼핑몰 설정(SHOP_SETTINGS)에서 바꾼다.
  shareTitle               String?
  shareDescription         String?
  status                   SellerStatus @default(PENDING)
  operatingState           ShopOperatingState @default(OPEN)
  businessInfo             Json?
  approvedAt               DateTime?    @db.Timestamptz(3)
  // 체험하기 종료 시각 = 마스터 승인 시각(DB 시계) + 판매자 플랜의 체험 일수(SubscriptionPlan.trialDays, 오버레이 전용 7일·통합 없음,
  // lib/server/sellers/approval.ts). 체험이 없는 플랜은 null. 지나면 구독 전까지 판매자 API를 막는다.
  trialEndsAt              DateTime?    @db.Timestamptz(3)
  // 판매자 플랜(가입 신청 때 정함, ONQ 1-C). 구독 행이 생기면 구독의 planId가 청구 기준이다. 기존 판매자는 INTEGRATED로 옮겼다.
  planId                   String?      @db.Uuid
  // 런칭 할인을 쓴 시각(런칭가 청구가 처음 확정된 때, 대표님 결정 2026-10-04). 이 뒤 해지하고 다시 구독하면 정가다.
  // 이전 전 STANDARD 결제는 사용으로 세지 않는다(ONQ 1-C-2).
  launchDiscountUsedAt     DateTime?    @db.Timestamptz(3)
  // 잠긴 지 30일이 지나 자동 해지된 시각. 이때부터 90일 보관 뒤 삭제 대상(삭제는 별도 작업). 다시 구독하면 비운다.
  serviceEndedAt           DateTime?    @db.Timestamptz(3)
  approvedByAdminId        String?      @db.Uuid
  suspendedReason          String?
  // 가입 자동 점검에서 걸린 항목(「확인 필요」 사유). 자동 승인·마스터 승인 때 비운다.
  reviewReasons            String[]     @default([])
  // 가입 반려 사유·시각(정지 사유와 따로 둔다)
  rejectedReason           String?
  rejectedAt               DateTime?    @db.Timestamptz(3)
  // 대표자 PASS 본인인증 CI의 HMAC-SHA256 값(원문 CI는 저장하지 않음). 대표자 1명당 쇼핑몰 1개는 마이그레이션 SQL 부분 유니크.
  representativeCiHash     String?
  representativeVerifiedAt DateTime?    @db.Timestamptz(3)
  liveVersion              Int          @default(0)
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)

  approvedBy PlatformAdmin?    @relation(fields: [approvedByAdminId], references: [id])
  plan       SubscriptionPlan? @relation(fields: [planId], references: [id])

  domains                  SellerDomain[]
  adminNotes               SellerAdminNote[]
  users                    SellerUser[]
  sellerSessions           SellerSession[]
  passwordResetGrants      PasswordResetGrant[]
  grades                   MemberGrade[]
  buyers                   BuyerMember[]
  buyerAddresses           BuyerAddress[]
  identityVerifications    IdentityVerification[]
  buyerSessions            BuyerSession[]
  buyerPasswordResets      BuyerPasswordReset[]
  products                 Product[]
  productImages            ProductImage[]
  productOptions           ProductOption[]
  stockMovements           StockMovement[]
  orders                   Order[]
  orderItems               OrderItem[]
  orderConsents            OrderConsent[]
  orderPolicy              SellerOrderPolicy?
  messageBalance           SellerMessageBalance?
  messageLedger            SellerMessageLedger[]
  messageShortages         MessageShortage[]
  messageFeeConsents       SellerMessageFeeConsent[]
  messageCharges           MessageCharge[]
  overlayLayouts           OverlayLayout[]
  overlayTemplates         OverlayTemplate[]
  mailDeliveries           MailDelivery[]
  memberPolicy             SellerMemberPolicy?
  brandColor               SellerBrandColor?
  favicon                  SellerFavicon?
  businessLicense          SellerBusinessLicense?
  shopSeo                  ShopSeo?
  orderNotificationPolicy  SellerOrderNotificationPolicy?
  rejoinBlocks             BuyerRejoinBlock[]
  purchaseRestrictions     BuyerPurchaseRestriction[]
  shippingPolicy           SellerShippingPolicy?
  orderShippingAddresses   OrderShippingAddress[]
  shipments                Shipment[]
  orderStatusHistories     OrderStatusHistory[]
  broadcastSessions        BroadcastSession[]
  youtubeChannel           YoutubeChannelLink?
  youtubeLives             YoutubeLiveLink[]
  audienceEvents           AudienceEvent[]
  queueItems               QueueItem[]
  queueItemStatusHistories QueueItemStatusHistory[]
  hitCards                 HitCard[]
  rewardPolicy             RewardPolicy?
  rewardLedger             RewardLedger[]
  rewardBalances           RewardBalance[]
  overlayTokens            OverlayToken[]
  subscription             SellerSubscription?
  subscriptionPayments     SubscriptionPayment[]
  auditLogs                AuditLog[]
  shopBanners              ShopBanner[]
  shopPopups               ShopPopup[]
  // 「모든 팝업 잠시 끄기」(SA-065): 끈 시각과 끈 직원. null이면 켜짐.
  popupsPausedAt           DateTime?    @db.Timestamptz(3)
  popupsPausedById         String?      @db.Uuid
  shopContentImages        ShopContentImage[]
  coupons                  Coupon[]
  buyerCoupons             BuyerCoupon[]
  couponRedemptions        CouponRedemption[]
  logo                     SellerLogo?
  productReviews           ProductReview[]
  buyerInquiries           BuyerInquiry[]
  buyerInquiryImages       BuyerInquiryImage[]
  shopSearchSynonyms       ShopSearchSynonym[]
  shopSearchTerms          ShopSearchTerm[]
  shopSearchBlockedTerms   ShopSearchBlockedTerm[]
  productReviewImages      ProductReviewImage[]
  productReviewReports     ProductReviewReport[]
  productReviewPolicy      ProductReviewPolicy?
  cartItems                CartItem[]
  wishItems                WishItem[]
  restockAlerts            RestockAlert[]
  bulkJobs                 BulkJob[]
  shopNotices              ShopNotice[]
  shopLegalDocs            ShopLegalDoc[]
  shopLegalNotice          ShopLegalNotice?
  returnRequests           ReturnRequest[]
  memberGradePolicy        MemberGradePolicy?
  memberGradeOverrides     MemberGradeOverride[]
  memberGradeHistory       MemberGradeHistory[]
  memberGradeRuns          MemberGradeRun[]
  returnRequestItems       ReturnRequestItem[]
  returnRequestImages      ReturnRequestImage[]
  bankAccount              SellerBankAccount?
  memberMessages           MemberMessage[]
  memberMessageRecipients  MemberMessageRecipient[]
  subscriptionRefunds      SubscriptionRefund[]
  platformInquiries        PlatformInquiry[]
  platformInquiryMessages  PlatformInquiryMessage[]
  platformInquiryImages    PlatformInquiryImage[]
  platformInquiryFiles     PlatformInquiryFile[]
  externalShopConnections  ExternalShopConnection[]
  receiptIssuer            SellerReceiptIssuer?
  receiptSetting           SellerReceiptSetting?
  shipmentInvoices         ShipmentInvoice[]
  shipmentInvoiceOrders    ShipmentInvoiceOrder[]
  shipmentInvoiceEvents    ShipmentInvoiceEvent[]
  externalOrders ExternalOrder[]
}

model SellerDomain {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String    @db.Uuid
  hostname    String    @unique
  verifiedAt  DateTime? @db.Timestamptz(3)
  certStatus  String?
  // 자동 해지로 연결을 푼 시각(비활성). 다시 구독하면 되살린다.
  suspendedAt DateTime? @db.Timestamptz(3)
  // 소유 확인 값: 도메인 DNS에 _onq-verify TXT 레코드로 넣게 한다(SA-060 도메인 연결). 마지막 확인 시각은 연속 확인(DNS 조회) 제한용.
  verifyToken   String    @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  lastCheckedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
}

// 판매자 직원 권한 항목(대표님 결정 2026-10-02: 고정 역할 대신 항목별로 켜고 끔).
// PG 연결·구독·직원 관리·적립금 실지급 스위치는 대표자 전용이라 항목으로 줄 수 없다.
enum SellerStaffPermission {
  BROADCAST_RUN
  OVERLAY_EDIT
  PRODUCT_MANAGE
  ORDER_SHIPPING
  CUSTOMER_PII_VIEW
  MEMBER_POINTS
  INQUIRY_REPLY
  RECEIPT_TAX
  SALES_VIEW
  SHOP_SETTINGS
}

enum SellerUserStatus {
  ACTIVE
  DISABLED
}

model SellerUser {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String                  @db.Uuid
  email              String
  passwordHash       String
  name               String
  // 대표자 여부. 대표자는 모든 권한과 대표자 전용 기능을 가진다.
  isOwner            Boolean                 @default(false)
  // 직원 권한 항목(대표자는 비워 둔다)
  permissions        SellerStaffPermission[] @default([])
  // 비밀번호가 바뀔 때마다 1씩 올린다. 세션은 만들 때의 값을 들고 있고, 다르면 무효(재설정 중 진행된 옛 비밀번호 로그인 차단).
  credentialVersion  Int                     @default(0)
  status             SellerUserStatus        @default(ACTIVE)
  lastLoginAt        DateTime?               @db.Timestamptz(3)
  // 직원 휴대폰 번호(숫자만, 대표자가 직원 관리에서 등록, 기존 행은 null). 직원 본인확인 연결 때 결과와 대조한다.
  phone              String?
  // 직원이 본인확인으로 연결한 CI의 HMAC 해시(등록한 이름·휴대폰과 결과가 맞을 때만). 직원 셀프 아이디·비밀번호 찾기에만 쓴다.
  // 대표자가 휴대폰 번호를 바꾸면 지운다. 대표자는 쇼핑몰 대표자 CI(Seller.representativeCiHash)를 쓰고 여기는 비워 둔다.
  identityCiHash     String?
  identityLinkedAt   DateTime?               @db.Timestamptz(3)
  // 연결돼 있다가 대표자가 휴대폰 번호를 바꿔 연결이 풀린 시각(다시 연결하면 비움). 처음부터 미연결인 직원과 구별한다.
  identityUnlinkedAt DateTime?               @db.Timestamptz(3)
  // 대표자 가입 신청 필수 동의 기록(본인확인 시작 때 받은 문서 버전·시각, sellers/signupConsent.ts). 직원·이 기능 전 대표자는 비어 있다.
  signupConsent      Json?
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)

  seller      Seller               @relation(fields: [sellerId], references: [id])
  sessions    SellerSession[]
  resetGrants PasswordResetGrant[]

  @@unique([sellerId, id])
  @@unique([sellerId, email])
  @@index([identityCiHash])
}

// 판매자 대표 비밀번호 재설정 권한(일회용·10분). 토큰은 해시만 저장한다.
model PasswordResetGrant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String    @db.Uuid
  sellerUserId   String    @db.Uuid
  tokenHash      String    @unique
  // 발급 때 확인한 CI 해시(대표자는 쇼핑몰 대표자 CI, 직원은 연결 CI). 쓸 때 그 값이 바뀌었으면 거부한다.
  ciHash         String
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)
  // 이 권한으로 새 비밀번호 저장에 성공한 시각(실패로 소진되거나 다른 권한 사용으로 무효가 된 권한은 비어 있음).
  // 응답을 잃고 같은 새 비밀번호로 다시 보낸 요청을 성공으로 돌려주는 데 쓴다(auth/passwordReset.ts).
  completedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  // 아이디 찾기로 준 권한: 발급에 쓴 본인확인과 토큰을 다시 만드는 무작위 값(토큰 = 서버 비밀키 HMAC(nonce), 원문은 저장하지 않음).
  // 응답을 잃은 재시도에 같은 토큰을 다시 돌려준다(auth/accountRecovery.ts).
  verificationId String?   @db.Uuid
  nonce          String?

  seller     Seller     @relation(fields: [sellerId], references: [id])
  sellerUser SellerUser @relation(fields: [sellerId, sellerUserId], references: [sellerId, id])

  @@index([verificationId])
  @@index([sellerId, sellerUserId])
}

model SellerSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerUserId      String    @db.Uuid
  sellerId          String    @db.Uuid
  tokenHash         String    @unique
  credentialVersion Int       @default(0)
  ip                String?
  userAgent         String?
  expiresAt         DateTime  @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  seller     Seller     @relation(fields: [sellerId], references: [id])
  sellerUser SellerUser @relation(fields: [sellerId, sellerUserId], references: [sellerId, id])

  @@index([sellerId, sellerUserId])
}

// ───────────── 구매자 회원 (판매자 쇼핑몰별) ─────────────

enum GradeSystemKey {
  BASIC
  SPROUT
  SILVER
  GOLD
  VIP
}

// 등급 혜택(SA-044): 배송비 혜택 없음 / 정액 할인(shippingDiscount원, 배송비를 넘으면 0원) / 무료
enum GradeShippingBenefit {
  NONE
  DISCOUNT
  FREE
}

// 등급은 id·displayName·sortOrder로 식별한다. systemKey는 기본 5개 표시용(판매자가 추가한 등급은 null).
model MemberGrade {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String          @db.Uuid
  displayName String
  sortOrder   Int
  systemKey   GradeSystemKey?
  // 자동 재산정 승급 기준: 최근 6개월 결제 금액이 이 값 이상이면 이 등급 이상(member-grades). 기본 등급은 항상 0.
  minAmount   Int             @default(0)
  // 등급 혜택: 배송비(주문 견적·주문 생성이 같은 계산을 씀, shop-member-grades/benefits.ts)와 승급 쿠폰(직접 지급 방식 쿠폰 id, 승급할 때 한 번 지급. 쿠폰 존재·방식은 저장할 때 검사)
  shippingBenefit   GradeShippingBenefit @default(NONE)
  shippingDiscount  Int                  @default(0)
  promotionCouponId String?              @db.Uuid
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  seller  Seller        @relation(fields: [sellerId], references: [id])
  members BuyerMember[]

  @@unique([sellerId, id])
  @@unique([sellerId, displayName])
  @@unique([sellerId, systemKey])
}

enum BuyerMemberStatus {
  ACTIVE
  DORMANT
  WITHDRAWN
}

// CI·휴대폰·아이디·방송 닉네임 유니크는 deletedAt IS NULL 행에만 적용 (마이그레이션 SQL 부분 유니크 인덱스).
model BuyerMember {
  id                          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId                    String            @db.Uuid
  loginId                     String
  passwordHash                String
  name                        String
  phone                       String
  // PASS 본인인증 CI의 HMAC-SHA256 값(원문 CI는 저장하지 않음). 같은 쇼핑몰 중복 가입 차단 기준.
  ciHash                      String
  identityVerifiedAt          DateTime          @db.Timestamptz(3)
  // PASS 생년월일. 미성년자 구매 정책 판정에 쓴다. 탈퇴하면 지운다(null).
  birthDate                   DateTime?         @db.Date
  broadcastNickname           String
  // 방송 닉네임을 마지막으로 바꾼 시각(회원정보 수정 SH-024, 30일에 1번). 가입 뒤 한 번도 안 바꿨으면 null(바로 바꿀 수 있다).
  broadcastNicknameChangedAt  DateTime?         @db.Timestamptz(3)
  gradeId                     String            @db.Uuid
  status                      BuyerMemberStatus @default(ACTIVE)
  marketingConsentAt          DateTime?         @db.Timestamptz(3)
  // 지금 마케팅 수신 동의의 문서 버전(동의 중일 때만). 마지막으로 철회한 시각(다시 동의하면 비움). buyers/marketingConsent.ts
  marketingConsentVersion     String?
  marketingWithdrawnAt        DateTime?         @db.Timestamptz(3)
  // 가입 때 재가입 제한이 켜져 있었으면 그때 기간(일). 가입하며 안내받은(동의한) 기간보다 길게 CI 해시를 보관하지 않으려고 남긴다.
  // 없으면(제한이 꺼져 있을 때 가입) 탈퇴해도 재가입을 제한하지 않는다(buyers/rejoin.ts).
  rejoinRestrictionDaysAgreed Int?
  // 「재가입 제한 정보 보관 동의」(개인정보 수집·이용 동의와 별도, 재가입 제한을 켠 쇼핑몰에서만 받음) 시각·문서 버전
  rejoinRetentionAgreedAt     DateTime?         @db.Timestamptz(3)
  rejoinRetentionVersion      String?
  // 위 보관 동의를 마지막으로 철회한 시각(회원 정보에서 언제든 철회, buyers/rejoinConsent.ts). 철회하면 위 세 칸을 비운다.
  rejoinRetentionWithdrawnAt  DateTime?         @db.Timestamptz(3)
  // 가입 필수 동의 기록(본인확인 시작 때 받은 문서 버전·시각, buyers/consent.ts SignupConsent)
  signupConsent               Json?
  lastLoginAt                 DateTime?         @db.Timestamptz(3)
  createdAt                   DateTime          @default(now()) @db.Timestamptz(3)
  deletedAt                   DateTime?         @db.Timestamptz(3)

  seller               Seller                     @relation(fields: [sellerId], references: [id])
  grade                MemberGrade                @relation(fields: [sellerId, gradeId], references: [sellerId, id])
  sessions             BuyerSession[]
  passwordResets       BuyerPasswordReset[]
  orders               Order[]
  purchaseRestrictions BuyerPurchaseRestriction[]
  memo                 MemberMemo?
  hitCards             HitCard[]
  rewardLedger         RewardLedger[]
  rewardBalances       RewardBalance[]
  rewardExpiryNotices  RewardExpiryNotice[]
  addresses            BuyerAddress[]
  coupons              BuyerCoupon[]
  productReviews       ProductReview[]
  buyerInquiries       BuyerInquiry[]
  buyerInquiryImages   BuyerInquiryImage[]
  productReviewImages  ProductReviewImage[]
  productReviewReports ProductReviewReport[]
  cartItems            CartItem[]
  wishItems            WishItem[]
  notificationPrefs    BuyerNotificationPref[]
  restockAlerts        RestockAlert[]
  returnRequests       ReturnRequest[]
  refundRequests       RefundRequest[]
  receiptRequests      OrderReceiptRequest[]
  returnRequestImages  ReturnRequestImage[]
  gradeOverrides       MemberGradeOverride[]
  gradeHistory         MemberGradeHistory[]
  memberMessageRecipients MemberMessageRecipient[]
  eventEntrants           AudienceEventEntrant[]

  @@unique([sellerId, id])
  @@index([sellerId, gradeId])
  @@index([sellerId, createdAt])
  @@index([sellerId, deletedAt])
}

// 구매자 저장 배송지(2026-10-03 대표님 결정). 주문 때 입력한 배송지를 저장하고(구매자가 끌 수 있음), 주문서에서 고른다.
// 구매자당 20개까지. 배송지가 있으면 기본 배송지는 항상 1개(부분 유니크 인덱스 BuyerAddress_one_default_per_buyer, 마이그레이션 SQL).
// lastUsedAt: 마지막으로 주문에 쓴 시각. 기본 배송지를 지우면 가장 최근에 사용한 배송지가 기본이 된다.
// 주문에는 OrderShippingAddress 스냅숏이 따로 남으므로 여기 값을 고치거나 지워도 지난 주문은 바뀌지 않는다.
model BuyerAddress {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @db.Uuid
  buyerMemberId String    @db.Uuid
  label         String?
  recipientName String
  phone         String
  zipCode       String
  address1      String
  address2      String?
  memo          String?
  isDefault     Boolean   @default(false)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @db.Timestamptz(3)

  seller Seller      @relation(fields: [sellerId], references: [id])
  member BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)

  @@index([sellerId, buyerMemberId])
}

enum IdentityVerificationPurpose {
  BUYER_SIGNUP
  SELLER_REPRESENTATIVE
  PASSWORD_RESET
  STAFF_LINK // 직원 본인확인 연결(로그인한 직원, subjectId = 직원 계정)
  ACCOUNT_RECOVERY // 쇼핑몰을 모르는 아이디 찾기·계정 고르기 비밀번호 찾기
}

enum IdentityVerificationMethod {
  PASS_APP
  SMS
}

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

// PASS 본인인증 요청·결과. 연동은 IdentityProvider 인터페이스 뒤에 둔다(개발·테스트는 가짜 공급자).
// CI 원문은 저장하지 않고 서버 비밀키(IDENTITY_HASH_KEY) HMAC-SHA256 값만 저장한다. 판매자 대표자 인증은 sellerId가 없다.
model IdentityVerification {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String?                     @db.Uuid
  purpose         IdentityVerificationPurpose
  provider        String
  // 본인확인 방식. 기존 행은 실제 쓴 방식(PASS_APP) 그대로 두고, 휴대폰 본인확인(문자)부터 SMS로 남긴다.
  method          IdentityVerificationMethod
  requestId       String
  status          IdentityVerificationStatus  @default(PENDING)
  // 문자 본인확인: 요청 때 받은 휴대폰번호(숫자만). 대행사 결과의 번호가 이와 다르면 실패로 본다.
  requestedPhone  String?
  // 인증번호 보낸 횟수(처음 포함)·마지막으로 보낸 시각·틀린 횟수. 한도는 identity/verification.ts 상수.
  sendCount       Int                         @default(0)
  lastSentAt      DateTime?                   @db.Timestamptz(3)
  otpFailCount    Int                         @default(0)
  // 확인을 마친 뒤 이 본인확인으로 가입을 시도한 횟수(실패 포함). 한도를 넘으면 처음부터 다시(buyers/signup.ts).
  useAttemptCount Int                         @default(0)
  ciHash          String?
  name            String?
  phone           String?
  birthDate       DateTime?                   @db.Date
  verifiedAt      DateTime?                   @db.Timestamptz(3)
  // 인증을 시작한 브라우저에 준 일회용 값의 해시. 완료할 때 같은 값이 있어야 한다(다른 사람이 id만 알아서는 못 씀).
  ownerTokenHash  String?
  // 구매자 가입: 본인확인 전에 받은 필수 동의(buyers/consent.ts SignupConsent). 가입하면 회원으로 옮긴다.
  signupConsent   Json?
  // 비밀번호 찾기: 재설정 대상 계정(없는 계정이면 null, 응답은 같게)
  subjectId       String?                     @db.Uuid
  // 구매자 가입 시작 멱등 키(클라이언트가 만든 attemptKey의 해시). 같은 쇼핑몰·같은 키로 다시 시작하면 새로 만들지 않는다.
  attemptKeyHash  String?
  // 첫 인증번호를 보내기 시작한 시각(구매자 가입). sendCount가 0인 채 오래 지나면 같은 attemptKey 재요청이 발송을 넘겨받는다.
  sendStartedAt   DateTime?                   @db.Timestamptz(3)
  // 인증을 시작한 접속 IP(신뢰 프록시 기준, 없으면 null). 판매자 가입 PASS 시작 하루 횟수 제한에 쓴다.
  requestIp       String?
  // 이 인증으로 가입·재설정 권한을 이미 발급했으면 기록(한 번만 쓰임)
  consumedAt      DateTime?                   @db.Timestamptz(3)
  // 식별 항목(이름·휴대폰·요청 휴대폰·생년월일·CI 해시·subjectId·동의·대행사 요청 id)을 비운 시각. 행은 한도 계산에 쓰여 남긴다
  // (쇼핑몰·상태·요청 시각·요청 IP). 비식별된 VERIFIED 행은 CI 해시가 없어도 된다(CHECK).
  anonymizedAt    DateTime?                   @db.Timestamptz(3)
  expiresAt       DateTime                    @db.Timestamptz(3)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)

  seller Seller? @relation(fields: [sellerId], references: [id])

  @@unique([provider, requestId])
  @@unique([sellerId, attemptKeyHash])
  @@index([purpose, requestIp, createdAt])
  @@index([sellerId, ciHash])
}

model BuyerSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerMemberId String    @db.Uuid
  sellerId      String    @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime  @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@index([sellerId, buyerMemberId])
}

// 구매자 비밀번호 재설정 링크(buyers/passwordReset.ts). 토큰 원문은 저장하지 않고 해시만 둔다. 유효 30분·한 번만 쓴다.
model BuyerPasswordReset {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @db.Uuid
  buyerMemberId String    @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime  @db.Timestamptz(3)
  usedAt        DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  seller Seller      @relation(fields: [sellerId], references: [id])
  member BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)

  @@index([sellerId, buyerMemberId])
}

// ───────────── 상품·옵션·재고 ─────────────

enum StockDeductMode {
  ORDER
  PAYMENT
}

enum ProductStatus {
  DRAFT
  ON_SALE
  SOLD_OUT
  HIDDEN
}

enum EventDiscountType {
  RATE
  AMOUNT
}

model Product {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String             @db.Uuid
  name               String
  description        String?
  price              Int
  status             ProductStatus      @default(DRAFT)
  // 재고 차감 시점(카페24 방식, 대표님 결정 2026-10-03): ORDER=주문할 때, PAYMENT=결제 확인 때(기본)
  stockDeductMode    StockDeductMode    @default(PAYMENT)
  // 이벤트 할인(대표님 결정 2026-10-03): 할인율(RATE, %) 또는 할인 금액(AMOUNT, 원)과 시작·종료 시각. 넷 다 있거나 넷 다 없다(CHECK).
  // 기간 안에 주문하면 서버가 DB 시계로 판단해 할인가로 주문을 만든다. 끝나면 자동으로 정가.
  eventDiscountType  EventDiscountType?
  eventDiscountValue Int?
  eventStartsAt      DateTime?          @db.Timestamptz(3)
  eventEndsAt        DateTime?          @db.Timestamptz(3)
  sortOrder          Int                @default(0)
  // 검색 태그(상품 이름 밖 키워드, 최대 10개·각 20자). 쇼핑몰 검색과 자동완성이 이름과 함께 본다.
  searchTags         String[]           @default([])
  // 상품 코드 번호(카페24식 자동 상품 코드, MASTER 결정 2026-10-04). 판매자별 1부터 순번, 화면·API는 「P」 + 7자리(P0000001).
  // 넣을 때 0(기본)이면 DB 트리거(product_assign_code_no)가 ProductCodeCounter로 다음 번호를 매긴다. 지운 상품 번호도 다시 쓰지 않는다.
  codeNo             Int                @default(0)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  deletedAt          DateTime?          @db.Timestamptz(3)

  seller        Seller            @relation(fields: [sellerId], references: [id])
  images        ProductImage[]
  options       ProductOption[]
  orderItems    OrderItem[]
  reviews       ProductReview[]
  categories    ProductCategory[]
  detail        ProductDetail?
  displayItems  ShopDisplayItem[]
  wishItems     WishItem[]
  restockAlerts RestockAlert[]
  buyerInquiries BuyerInquiry[]

  @@unique([sellerId, id])
  @@unique([sellerId, codeNo])
}

// 상품 사진(PR-A, 2026-10-04 대표님 지시). 첫 번째(sortOrder 0)가 대표 사진(썸네일). 상품당 10장(lib/server/products/images.ts).
// 바이트는 공통 저장소(lib/server/storage, storageKey)에 두고 여기에는 형식·크기·해시만 둔다(저장 방식이 바뀌어도 이 표는 그대로).
model ProductImage {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String           @db.Uuid
  productId   String           @db.Uuid
  storageKey  String           @unique
  contentType String
  byteSize    Int
  width       Int
  height      Int
  sha256      String
  // GALLERY: 상품 사진(10장, 첫 장이 대표), DETAIL: 상세 페이지 블록에 쓰는 사진(30장, ProductDetail.blocks가 가리킴)
  kind        ProductImageKind @default(GALLERY)
  sortOrder   Int              @default(0)
  // 썸네일로 지정한 사진(GALLERY, 상품마다 하나, 부분 유니크 인덱스는 마이그레이션 SQL). 지정이 없으면 첫 번째 사진이 썸네일이다.
  thumbnail   Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  seller  Seller  @relation(fields: [sellerId], references: [id])
  product Product @relation(fields: [sellerId, productId], references: [sellerId, id])

  @@index([sellerId, productId])
}

// 옵션 없는 상품도 기본 옵션 1개를 둬 재고를 한 곳에서 관리한다. stock >= 0 CHECK는 마이그레이션 SQL.
model ProductOption {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String    @db.Uuid
  productId  String    @db.Uuid
  name       String
  priceDelta Int       @default(0)
  stock      Int       @default(0)
  sku        String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  // 지운 옵션(소프트 삭제). 지난 주문 품목이 참조하므로 행은 남긴다. 새 주문에서는 고를 수 없다.
  deletedAt  DateTime? @db.Timestamptz(3)

  seller         Seller          @relation(fields: [sellerId], references: [id])
  product        Product         @relation(fields: [sellerId, productId], references: [sellerId, id])
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@unique([sellerId, id])
  @@index([sellerId, productId])
}

enum StockMovementReason {
  ORDER
  CANCEL
  REFUND
  MANUAL
  // 교환 상품을 다시 보낼 때 뺀 재고(교환·반품, shop-returns)
  EXCHANGE
}

enum ActorType {
  PLATFORM_ADMIN
  SELLER_USER
  BUYER
  SYSTEM
}

model StockMovement {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String              @db.Uuid
  optionId   String              @db.Uuid
  delta      Int
  reason     StockMovementReason
  orderId    String?             @db.Uuid
  // 수동 증감 사유(MANUAL). 예) 「이벤트 증정」
  note       String?
  // 이 이동 뒤 옵션 재고. DB 트리거(StockMovement_set_stock_after)가 넣는다: 이동은 언제나 재고를 바꾼 뒤 같은 트랜잭션에서 기록한다.
  // 트리거 전 기록은 null(화면은 표시하지 않음).
  stockAfter Int?
  // 기록 순서. 이동은 옵션 행을 잠근 UPDATE 뒤에 넣으므로 옵션마다 seq 순서가 실제 적용 순서와 같다(createdAt은 트랜잭션 시작 시각이라 뒤바뀔 수 있음).
  seq        BigInt              @unique @default(autoincrement())
  actorType  ActorType
  actorId    String?             @db.Uuid
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  seller Seller        @relation(fields: [sellerId], references: [id])
  option ProductOption @relation(fields: [sellerId, optionId], references: [sellerId, id])
  order  Order?        @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@index([sellerId, optionId])
  @@index([sellerId, seq(sort: Desc)])
}

// ───────────── 쇼핑몰 꾸미기: 홈 배너·이벤트 팝업 (2026-10-04 대표님 지시) ─────────────
// 파트너스 관리자에서 대표자·「쇼핑몰 설정」(SHOP_SETTINGS) 직원만 바꾼다(lib/server/shop-content). 노출 기간은 DB 시계로 판단한다.
// 이미지는 대표님 저장 방식 결정 전이라 비용 없는 A안(DB bytea). 형식·크기·해시 CHECK는 마이그레이션 SQL.
// 배너·팝업은 (sellerId, 이미지 id) 복합 외래키로 같은 쇼핑몰 이미지만 가리킨다.

// 노출 페이지(SA-065, 단일 선택). HOME=홈, ALL=모든 구매자 화면, PRODUCT=상품 상세, CART_ORDER=장바구니·주문서, SIGNUP_DONE=회원가입 완료.
enum ShopPopupTarget {
  HOME
  ALL
  PRODUCT
  CART_ORDER
  SIGNUP_DONE
}

// 이미지·글 팝업 위치. 상단 띠(BAR)는 항상 맨 위라 이 값을 쓰지 않는다.
enum ShopPopupPosition {
  CENTER
  BOTTOM_SHEET
  BOTTOM_RIGHT
}

// IMAGE=이미지 팝업(가운데), TEXT=글 팝업(가운데), BAR=상단 띠(화면 맨 위 한 줄)
enum ShopPopupKind {
  IMAGE
  TEXT
  BAR
}

model ShopContentImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String   @db.Uuid
  data        Bytes
  // 바이트로 확인한 형식(image/png만, 2026-10-04 MASTER 결정). 올린 쪽이 보낸 Content-Type은 쓰지 않는다.
  contentType String
  byteSize    Int
  width       Int
  height      Int
  // 주소 버전(v=)과 캐시 판단용 SHA-256(hex)
  sha256      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  seller        Seller       @relation(fields: [sellerId], references: [id])
  bannersPc     ShopBanner[] @relation("ShopBannerPcImage")
  bannersMobile ShopBanner[] @relation("ShopBannerMobileImage")
  popups        ShopPopup[]

  @@unique([sellerId, id])
  @@index([sellerId, createdAt])
}

// 홈 배너 슬라이드. 모바일 이미지가 없으면 PC 이미지를 쓴다. linkUrl은 쇼핑몰 안 경로(/로 시작) 또는 http(s) 주소만.
model ShopBanner {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @db.Uuid
  // 관리용 이름이자 이미지 대체 글
  title         String
  pcImageId     String    @db.Uuid
  mobileImageId String?   @db.Uuid
  linkUrl       String?
  // 게시 기간. 비어 있으면 그쪽 제한 없음.
  startsAt      DateTime? @db.Timestamptz(3)
  endsAt        DateTime? @db.Timestamptz(3)
  showOnPc      Boolean   @default(true)
  showOnMobile  Boolean   @default(true)
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  seller      Seller            @relation(fields: [sellerId], references: [id])
  pcImage     ShopContentImage  @relation("ShopBannerPcImage", fields: [sellerId, pcImageId], references: [sellerId, id], onDelete: Restrict)
  mobileImage ShopContentImage? @relation("ShopBannerMobileImage", fields: [sellerId, mobileImageId], references: [sellerId, id], onDelete: Restrict)

  @@index([sellerId, sortOrder])
}

// 이벤트 팝업. target HOME=쇼핑몰 홈만, ALL=모든 구매자 화면. 이미지 팝업은 이미지, 글 팝업은 내용이 있어야 한다(CHECK).
// dismissDays: 구매자가 「보지 않기」를 고르면 숨기는 날 수(0=닫기만·매번 표시, 1=오늘 하루, 7=7일). 구매자 브라우저에 저장한다.
model ShopPopup {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String          @db.Uuid
  kind         ShopPopupKind   @default(IMAGE)
  title        String
  body         String?
  imageId      String?         @db.Uuid
  linkUrl      String?
  linkLabel    String?
  startsAt     DateTime?       @db.Timestamptz(3)
  endsAt       DateTime?       @db.Timestamptz(3)
  target       ShopPopupTarget @default(HOME)
  showOnPc     Boolean         @default(true)
  showOnMobile Boolean         @default(true)
  dismissDays  Int             @default(1)
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  position     ShopPopupPosition @default(CENTER)
  // 방송이 시작되면 끝낸다(기준: 시작 시각, 없으면 만든 시각 이후 처음 시작한 방송). 방송 중에는 띄우지 않음(hideDuringLive).
  endsAtBroadcastStart Boolean  @default(false)
  hideDuringLive       Boolean  @default(false)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller            @relation(fields: [sellerId], references: [id])
  image  ShopContentImage? @relation(fields: [sellerId, imageId], references: [sellerId, id], onDelete: Restrict)
  stats  ShopPopupStat[]

  @@index([sellerId, sortOrder])
}

// 팝업 노출·반응 집계(SA-065, 외부 서비스 없이 자체 기록). 팝업·일(KST) 단위 한 줄에 합산해 저장량이 늘지 않는다.
model ShopPopupStat {
  popupId     String   @db.Uuid
  day         DateTime @db.Date
  impressions Int      @default(0)
  closes      Int      @default(0)
  clicks      Int      @default(0)

  popup ShopPopup @relation(fields: [popupId], references: [id], onDelete: Cascade)

  @@id([popupId, day])
}

// ───────────── 쿠폰 (SA-035 쿠폰 관리 · SH-028 내 쿠폰함, 2026-10-04 대표님 확정 11건 중 1) ─────────────
// 대표자·적립금(MEMBER_POINTS) 권한 직원이 만들고 고친다(lib/server/shop-coupons). 할인 금액은 주문 생성 때 서버가 계산한다.
// 규칙(MASTER 2026-10-04): 주문당 1장, 1인 1장, 적립금 병용은 쿠폰별 옵션, 전체 취소면 복구·부분 취소는 복구 없음.
// 발급 수량·사용 여부는 조건부 UPDATE로 막아 동시 요청에도 한도를 넘지 않는다. 형식·범위 CHECK는 마이그레이션 SQL.

// AMOUNT=금액 할인(원), RATE=비율 할인(%, 최대 할인 선택), FREE_SHIPPING=배송비 무료
enum CouponBenefit {
  AMOUNT
  RATE
  FREE_SHIPPING
}

// DOWNLOAD=쇼핑몰에서 내려받기, CODE=코드 입력, MANUAL=직접 지급(등급·회원 선택)
enum CouponIssueMethod {
  DOWNLOAD
  CODE
  MANUAL
}

// ISSUED=쓸 수 있음(기간은 expiresAt), USED=주문에 씀. 전체 취소면 ISSUED로 되돌린다.
enum BuyerCouponStatus {
  ISSUED
  USED
}

model Coupon {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String            @db.Uuid
  name              String
  issueMethod       CouponIssueMethod
  // 코드 입력 방식의 코드(대문자 영문·숫자 4~16자). 쇼핑몰 안에서 겹치지 않는다(부분 유니크 인덱스, 마이그레이션 SQL).
  code              String?
  benefit           CouponBenefit
  // AMOUNT: 할인 금액(원), RATE: 할인율(1~90 %), FREE_SHIPPING: 없음
  value             Int?
  // RATE만: 최대 할인 금액(원, 비우면 제한 없음)
  maxDiscount       Int?
  // 최소 주문 금액(적용 상품 금액 기준, 배송비 제외)
  minOrderAmount    Int               @default(0)
  // 받을 수 있고 쓸 수 있는 기간. validDays가 있으면 받은 쿠폰은 받은 때부터 그 날 수까지(사용 종료를 넘지 않음).
  startsAt          DateTime          @db.Timestamptz(3)
  endsAt            DateTime          @db.Timestamptz(3)
  validDays         Int?
  // 발급 수량 한도(비우면 제한 없음)와 지금까지 발급한 수
  issueLimit        Int?
  issuedCount       Int               @default(0)
  // 적용 상품: productIds가 비어 있으면 전체 상품
  productIds        String[]          @default([]) @db.Uuid
  // 이벤트 할인 중인 상품은 할인 대상에서 뺀다
  excludeDiscounted Boolean           @default(true)
  // 적립금과 함께 쓰기 허용(적립금 사용 기능이 생기면 주문 생성에서 판정)
  allowWithReward   Boolean           @default(true)
  // 발급 중지(false)여도 이미 받은 쿠폰은 기간 안에 쓸 수 있다
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  seller      Seller             @relation(fields: [sellerId], references: [id])
  issued      BuyerCoupon[]
  redemptions CouponRedemption[]

  @@unique([sellerId, id])
  @@index([sellerId, createdAt])
}

// 구매자가 받은 쿠폰(1인 1장). 탈퇴하면 쓰지 않은 쿠폰은 지우고, 쓴 쿠폰은 주문 할인 기록이라 주문과 함께 남긴다.
model BuyerCoupon {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String            @db.Uuid
  couponId      String            @db.Uuid
  buyerMemberId String            @db.Uuid
  status        BuyerCouponStatus @default(ISSUED)
  issuedAt      DateTime          @db.Timestamptz(3)
  expiresAt     DateTime          @db.Timestamptz(3)
  usedAt        DateTime?         @db.Timestamptz(3)

  seller      Seller             @relation(fields: [sellerId], references: [id])
  coupon      Coupon             @relation(fields: [sellerId, couponId], references: [sellerId, id])
  buyerMember BuyerMember        @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])
  redemptions CouponRedemption[]

  @@unique([couponId, buyerMemberId])
  @@unique([sellerId, id])
  @@index([sellerId, buyerMemberId, status])
}

// 주문에 쓴 쿠폰과 할인 금액(주문당 1장). 전체 취소로 쿠폰을 되돌리면 restoredAt을 남긴다(기록은 지우지 않음).
model CouponRedemption {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String        @db.Uuid
  orderId        String        @unique @db.Uuid
  couponId       String        @db.Uuid
  buyerCouponId  String        @db.Uuid
  benefit        CouponBenefit
  discountAmount Int
  // 상품 할인 쿠폰의 품목별 배분액 { 옵션 id: 원 }(적용 품목 금액 비율, 원 단위 끝수는 마지막 품목). 부분 환불·적립 기준에 쓴다.
  // 배송비 무료 쿠폰은 빈 값({}).
  itemDiscounts  Json          @default("{}")
  restoredAt     DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  seller      Seller      @relation(fields: [sellerId], references: [id])
  order       Order       @relation(fields: [sellerId, orderId], references: [sellerId, id])
  coupon      Coupon      @relation(fields: [sellerId, couponId], references: [sellerId, id])
  buyerCoupon BuyerCoupon @relation(fields: [sellerId, buyerCouponId], references: [sellerId, id])

  @@unique([sellerId, orderId])
  @@index([sellerId, couponId])
  @@index([sellerId, buyerCouponId])
}

// 쇼핑몰 로고(SA-060 쇼핑몰 정보, 2026-10-04 대표님 지시). 쇼핑몰당 1개. PNG만, 2MB 이하, 정사각형 512~1440px(마이그레이션 CHECK).
// 구매자 쇼핑몰 머리(ShopFrame)에 보이고, 없으면 쇼핑몰 이름 첫 글자를 보인다. 저장은 대표님 결정 전까지 A안(DB bytea).
model SellerLogo {
  sellerId    String   @id @db.Uuid
  data        Bytes
  contentType String
  byteSize    Int
  width       Int
  height      Int
  // 주소 버전(v=)과 캐시 판단용 SHA-256(hex)
  sha256      String
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 쇼핑몰 대표 색상(SA-060). 쇼핑몰당 1행, 없으면 플랫폼 기본 강조색. #RRGGBB 대문자. 강조색(버튼·가격)에만 쓰고 흰 바탕 대비 3:1 이상만 받는다(서버 검사).
model SellerBrandColor {
  sellerId  String   @id @db.Uuid
  color     String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 쇼핑몰 파비콘 원본(SA-060). 쇼핑몰당 1개. 8비트 PNG, 정사각형 64~1024px, 256KB 이하(코드 검사). 32·180·512px 크기는 서버가 이 원본에서 그려 쓴다.
// 없으면 로고에서 자동으로 만들고, 로고도 없으면 ONQ 기본 아이콘(화면 쪽)을 쓴다.
model SellerFavicon {
  sellerId  String   @id @db.Uuid
  data      Bytes
  byteSize  Int
  width     Int
  sha256    String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 파트너스 가입 신청의 사업자등록증 파일(PF-007-4). 비용 없는 DB 저장(파비콘과 같은 방식). JPG·PNG·PDF, 10MB 이하(서버가 파일 앞부분 바이트로 확인).
// 신청 전에는 본인확인 기록(verificationId)에 묶인 임시 파일이고, 신청을 만들 때 sellerId로 옮긴다(verificationId는 비움).
// 마스터 조회·내려받기는 최고관리자·운영만이며 열람은 로그 추적에 남긴다. 보관 기간·삭제는 대표님 결정 전이라 지우는 작업을 두지 않는다.
model SellerBusinessLicense {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificationId String?  @unique @db.Uuid
  sellerId       String?  @unique @db.Uuid
  fileName       String
  mimeType       String
  byteSize       Int
  sha256         String
  data           Bytes
  uploadedAt     DateTime @default(now()) @db.Timestamptz(3)

  seller Seller? @relation(fields: [sellerId], references: [id])
}

// ───────────── 상품 리뷰 (SA-048 리뷰 관리 · SH-029 리뷰 쓰기, 2026-10-04 대표님 확정 11건 중 2) ─────────────
// 구매자가 배송 완료된 주문 상품마다 1번 쓴다(작성 기간은 쇼핑몰 설정, 기본 30일). 답글·숨김·공개·설정은 대표자·구매자 문의(INQUIRY_REPLY) 직원.
// 사진은 화면에서 JPEG로 다시 저장해 올리고, 서버는 JPEG·PNG 바이트를 확인한 뒤 위치 정보 등 메타데이터를 지우고 DB에 둔다(A안).
// 리뷰 적립금은 쇼핑몰 설정(기본 0원=끔). 공개될 때 지급, 숨김·삭제 때 회수(적립금 원장 RewardLedger, idempotencyKey review_*).

// VISIBLE=공개, PENDING=공개 대기(확인 뒤 공개 쇼핑몰), HELD=보류(금지어·신고 누적), HIDDEN=숨김(작성자에게만 보임, 별점 평균 제외)
enum ProductReviewStatus {
  VISIBLE
  PENDING
  HELD
  HIDDEN
}

// 리뷰를 숨기거나 신고하는 사유
enum ProductReviewReason {
  PRIVACY
  OFF_TOPIC
  ABUSE
  AD
  OTHER
}

// 공개 방식: 바로 공개(금지어가 있으면 보류) · 확인 뒤 공개
enum ProductReviewPublishMode {
  IMMEDIATE
  REVIEW
}

model ProductReviewPolicy {
  sellerId     String                   @id @db.Uuid
  publishMode  ProductReviewPublishMode @default(IMMEDIATE)
  // 리뷰 적립금(원): 글만·사진 1장 이상. 0이면 지급하지 않는다.
  rewardText   Int                      @default(0)
  rewardPhoto  Int                      @default(0)
  // 배송 완료 뒤 쓸 수 있는 날 수
  writableDays Int                      @default(30)
  // 판매자 금지어(연락처·외부 주소는 따로 자동 검사)
  bannedWords  String[]                 @default([])
  updatedAt    DateTime                 @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

model ProductReview {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String               @db.Uuid
  orderId        String               @db.Uuid
  orderItemId    String               @unique @db.Uuid
  productId      String               @db.Uuid
  buyerMemberId  String               @db.Uuid
  // 작성할 때 방송 닉네임. 탈퇴하면 「탈퇴 회원」으로 바꾼다(리뷰는 남김).
  authorNickname String
  // 작성자가 고른 공개 옵션(SH-029): 닉네임 공개(끄면 공개 화면엔 「구매자」), 개봉 결과 함께 보여 주기
  showNickname      Boolean              @default(true)
  showOpeningResult Boolean              @default(false)
  rating         Int
  body           String
  status         ProductReviewStatus  @default(VISIBLE)
  // 보류 이유(금지어·신고 누적)와 숨김 사유(작성자에게 보임)
  heldBy         String?
  hiddenReason   ProductReviewReason?
  hiddenNote     String?
  reply          String?
  repliedAt      DateTime?            @db.Timestamptz(3)
  // 지금 지급된 리뷰 적립금(회수하면 0)과 지급 회차(다시 공개하면 새 회차로 지급)
  rewardRound    Int                  @default(0)
  // 지금 회차 적립이 사진 리뷰 자격으로 지급됐는지(금액은 원장이 사실 기준). 자격이 그대로면 설정이 바뀌어도 그 지급을 유지한다
  rewardForPhoto Boolean              @default(false)
  // 지운 리뷰의 묘비(주문 상품 1개당 1번이라 행은 남기고 본문·사진은 지운다)
  deletedAt      DateTime?            @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @db.Timestamptz(3)

  seller      Seller                @relation(fields: [sellerId], references: [id])
  order       Order                 @relation(fields: [sellerId, orderId], references: [sellerId, id])
  orderItem   OrderItem             @relation(fields: [sellerId, orderItemId], references: [sellerId, id])
  product     Product               @relation(fields: [sellerId, productId], references: [sellerId, id])
  buyerMember BuyerMember           @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])
  images      ProductReviewImage[]
  reports     ProductReviewReport[]

  @@unique([sellerId, id])
  @@unique([sellerId, orderItemId])
  @@index([sellerId, status, createdAt])
  @@index([sellerId, productId, status])
  @@index([sellerId, buyerMemberId])
}

// 리뷰 사진. 먼저 올리고(reviewId 없음) 리뷰를 저장할 때 붙인다. 붙지 않은 사진은 회원당 10장까지 두고 오래된 것부터 지운다.
model ProductReviewImage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String   @db.Uuid
  buyerMemberId String   @db.Uuid
  reviewId      String?  @db.Uuid
  data          Bytes
  contentType   String
  byteSize      Int
  width         Int
  height        Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  seller      Seller         @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember    @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)
  review      ProductReview? @relation(fields: [sellerId, reviewId], references: [sellerId, id], onDelete: Cascade)

  @@unique([sellerId, id])
  @@index([sellerId, reviewId])
  @@index([sellerId, buyerMemberId, reviewId])
}

// 구매자 신고(리뷰당 1인 1번). 3건이 쌓이면 공개 리뷰를 보류한다.
model ProductReviewReport {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String              @db.Uuid
  reviewId      String              @db.Uuid
  buyerMemberId String              @db.Uuid
  reason        ProductReviewReason
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  // 판매자가 확인해 공개한 시각. 현재 신고 수·보류 판정·사유 집계는 resolvedAt이 비어 있는 신고로만 계산한다
  resolvedAt    DateTime?           @db.Timestamptz(3)
  // 신고자가 스스로 철회한 시각. 철회한 신고는 미확인 신고 수·사유 집계에서 빠지지만 행은 남는다(같은 리뷰를 다시 신고할 수 없다). 리뷰 상태는 바꾸지 않는다
  withdrawnAt   DateTime?           @db.Timestamptz(3)

  seller      Seller        @relation(fields: [sellerId], references: [id])
  review      ProductReview @relation(fields: [sellerId, reviewId], references: [sellerId, id], onDelete: Cascade)
  buyerMember BuyerMember   @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)

  @@unique([reviewId, buyerMemberId])
  @@index([sellerId, reviewId])
}

// ───────────── 주문·주문 품목 ─────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

// 환불 사유 주체. 구매자 사정(단순 변심)이면 반품 배송비를 받고, 판매자 사정(불량·오배송)이면 받지 않는다.
enum RefundFault {
  BUYER
  SELLER
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
}

model Order {
  id                        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId                  String            @db.Uuid
  orderNo                   Int
  buyerMemberId             String            @db.Uuid
  status                    OrderStatus       @default(PENDING_PAYMENT)
  broadcastNicknameSnapshot String
  totalAmount               Int
  rewardUsedAmount          Int               @default(0)
  // 배송(MVP는 즉시 발송만). 배송비는 주문할 때 판매자 배송비 정책으로 계산해 고정한다(totalAmount에 포함, 적립 기준에서는 제외).
  fulfillmentType           FulfillmentType   @default(IMMEDIATE)
  shippingFee               Int               @default(0)
  paymentMethod             PaymentMethod?
  pgProvider                String?
  pgTxId                    String?
  paidAt                    DateTime?         @db.Timestamptz(3)
  stockShortageAt           DateTime?         @db.Timestamptz(3)
  cancelledAt               DateTime?         @db.Timestamptz(3)
  refundedAt                DateTime?         @db.Timestamptz(3)
  // 구매 확정 시각(배송 완료 n일 뒤 자동). 주문 상태(status)는 결제 완료(PAID) 그대로 둔다.
  purchaseConfirmedAt       DateTime?         @db.Timestamptz(3)
  // 판매자가 구매 확정을 취소한 시각(대표님 결정 2026-10-03). 있으면 자동 구매 확정이 다시 확정하지 않는다(환불하려고 푼 주문).
  purchaseUnconfirmedAt     DateTime?         @db.Timestamptz(3)
  // 적립 스냅숏(결제 때 판정, MASTER 결정 2026-10-03): 지급 시점·회원 등급·적립률(%)·적립 예정액. 결제 때 0원이면 나중에도 적립하지 않는다.
  // 배송 완료 때는 rewardEarnTiming이 ON_DELIVERY인 주문만 rewardEarnAmount로 기록한다. 적립 정책이 없던 주문·이 기능 전 주문은 null.
  rewardEarnTiming          RewardEarnTiming?
  rewardGradeId             String?           @db.Uuid
  rewardRate                Float?
  rewardEarnAmount          Int?
  // 주문할 때 판매자 반품 배송비(편도). 정책을 나중에 바꿔도 이 주문은 그대로다. 이 기능 전 주문은 null(환불 때 현재 정책을 쓴다).
  returnFeeSnapshot         Int?
  // 환불 결과: 돌려준 금액, 사유 주체(구매자·판매자 사정, 발송 전 환불은 null일 수 있음), 환불액에서 뺀 반품 배송비
  refundAmount              Int?
  refundFault               RefundFault?
  returnFeeDeducted         Int?
  createdAt                 DateTime          @default(now()) @db.Timestamptz(3)
  // 입금 기한(주문 시각 + 판매자 설정 시간, 기본 24시간). 지나면 결제 대기 주문을 자동 취소한다(lib/server/orders/overdue.ts).
  paymentDueAt              DateTime?         @db.Timestamptz(3)
  // 입금 기한이 지나 시스템이 자동 취소한 시각. 자동 구매 제한 횟수를 셀 때 쓴다.
  autoCancelledAt           DateTime?         @db.Timestamptz(3)
  // 법정 보관(buyers/legalHold.ts): 끝난 주문의 보관 만료일(끝난 날 + 5년, 모든 회원)과, 탈퇴 회원의 끝난 주문에 다는 분리 보관 표시.
  // 분리된 주문은 판매자·구매자 일반 조회(목록·검색·상세)에서 뺀다. 보관 만료 뒤 파기는 별도 함수.
  legalHoldAt               DateTime?         @db.Timestamptz(3)
  legalRetainUntil          DateTime?         @db.Timestamptz(3)

  seller           Seller                @relation(fields: [sellerId], references: [id])
  buyerMember      BuyerMember           @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])
  items            OrderItem[]
  consents         OrderConsent[]
  shippingAddress  OrderShippingAddress?
  invoiceLink      ShipmentInvoiceOrder?
  shipment         Shipment?
  statusHistory    OrderStatusHistory[]
  stockMovements   StockMovement[]
  queueItems       QueueItem[]
  rewardLedger     RewardLedger[]
  notifications    OrderNotification[]
  couponRedemption CouponRedemption?
  productReviews   ProductReview[]
  returnRequests   ReturnRequest[]
  payments         Payment[]
  refunds          OrderRefund[]
  refundRequests   RefundRequest[]
  receiptRequests  OrderReceiptRequest[]

  @@unique([sellerId, id])
  @@unique([sellerId, orderNo])
  @@index([sellerId, buyerMemberId])
  @@index([sellerId, status])
  @@index([status, paymentDueAt])
  @@index([sellerId, buyerMemberId, autoCancelledAt])
  // 판매자 주문 목록(주문 시각 내림차순 + id 커서)
  @@index([sellerId, createdAt(sort: Desc), id(sort: Desc)])
  // 마스터 파트너스 목록의 「이번 달 주문」(MA-011)
  @@index([sellerId, paidAt])
}

model OrderItem {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId            String    @db.Uuid
  orderId             String    @db.Uuid
  productId           String    @db.Uuid
  optionId            String    @db.Uuid
  productNameSnapshot String
  optionNameSnapshot  String
  unitPrice           Int
  // 할인 전 단가(상품 가격 + 옵션 추가금). unitPrice는 주문 때 이벤트 할인을 반영한 단가다. 이 기능 전 주문은 null.
  listUnitPrice       Int?
  quantity            Int
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  // 이 품목의 재고를 뺀 시각(주문 때 또는 결제 때)과 되돌린 시각. 두 번 빼거나 두 번 되돌리지 않게 품목마다 남긴다.
  stockDeductedAt     DateTime? @db.Timestamptz(3)
  stockRestoredAt     DateTime? @db.Timestamptz(3)
  // 환불한 수량(부분 환불, queue/service.ts refundOrder). 0 이상 quantity 이하(DB CHECK).
  refundedQuantity    Int       @default(0)

  seller      Seller              @relation(fields: [sellerId], references: [id])
  order       Order               @relation(fields: [sellerId, orderId], references: [sellerId, id])
  product     Product             @relation(fields: [sellerId, productId], references: [sellerId, id])
  option      ProductOption       @relation(fields: [sellerId, optionId], references: [sellerId, id])
  queueItems  QueueItem[]
  review      ProductReview?
  returnItems ReturnRequestItem[]

  @@unique([sellerId, id])
  @@index([sellerId, orderId])
}

model OrderStatusHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String       @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  ActorType
  actorId    String?      @db.Uuid
  reason     String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@index([sellerId, orderId])
}

// ───────────── 방송·주문대기·HIT ─────────────

enum BroadcastStatus {
  LIVE
  ENDED
}

// 판매자당 LIVE 1개는 마이그레이션 SQL 부분 유니크 인덱스.
model BroadcastSession {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String          @db.Uuid
  status    BroadcastStatus @default(LIVE)
  title     String?
  startedAt DateTime        @default(now()) @db.Timestamptz(3)
  endedAt   DateTime?       @db.Timestamptz(3)
  // 방송 중 오버레이가 처음 요청한 레이아웃("9x16" 세로형 | "16x9" 가로형, SA-054 「레이아웃」 열). 이 기록 전의 방송·요청이 없던 방송은 null.
  layoutAspect String?
  // 방송 메모(SA-055, 방송당 한 칸, 최대 1,000자). 비우면 null.
  memo String?
  // 방송을 시작한 사람(SA-055 「진행」, 시작 때 스냅숏 「쇼핑몰 이름 · 직원 이름」). 이 기록 전의 방송은 null.
  hostName String?

  seller       Seller            @relation(fields: [sellerId], references: [id])
  queueItems   QueueItem[]
  events       BroadcastEvent[]
  hitCards     HitCard[]
  youtubeLives YoutubeLiveLink[]
  audienceEvents AudienceEvent[]

  @@unique([sellerId, id])
  @@index([sellerId, status])
  @@index([sellerId, startedAt])
}

enum BroadcastEventKind {
  CONNECTED
  LIVE_STARTED
  DISCONNECTED
  RECOVERED
  ENDED
}

// 방송 화면·연결 로그(SA-055). 오버레이 실시간 채널 연결·끊김·복구와 방송 시작·종료만 남긴다(자체 기록, 무료).
// 방송 시작 전 연결은 broadcastSessionId가 null이고, 그 방송 시작 직전 30분 안이면 그 방송 로그에 함께 보인다.
model BroadcastEvent {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String                 @db.Uuid
  broadcastSessionId String?                @db.Uuid
  kind               BroadcastEventKind
  at                 DateTime               @default(now()) @db.Timestamptz(3)
  // 복구(RECOVERED)에서 끊겨 있던 초, 종료(ENDED)에서 남은 대기 건수
  downSeconds Int?
  waiting     Int?

  broadcastSession BroadcastSession? @relation(fields: [sellerId, broadcastSessionId], references: [sellerId, id], onDelete: Cascade)

  @@index([broadcastSessionId, at])
  @@index([sellerId, at])
}

enum QueueItemStatus {
  WAITING
  OPENING
  DONE
  CANCELLED
}

// 판매자당 OPENING 1건은 마이그레이션 SQL 부분 유니크 인덱스. timerSeconds 0~3600, quantity > 0 CHECK.
model QueueItem {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String          @db.Uuid
  // 내부 주문(orderId·orderItemId)이거나 외부 쇼핑몰 주문(externalOrderId·externalLineNo) 중 정확히 한쪽만 채운다(DB CHECK QueueItem_source_check).
  // 외부 주문은 재고·결제·적립금·배송을 이 쪽에서 다루지 않는다(외부 쇼핑몰이 한다). 가짜 회원·상품 행을 만들지 않는다.
  orderId            String?         @db.Uuid
  orderItemId        String?         @db.Uuid
  externalOrderId    String?         @db.Uuid
  externalLineNo     Int?
  broadcastSessionId String?         @db.Uuid
  status             QueueItemStatus @default(WAITING)
  position           Int
  receivedAt         DateTime        @db.Timestamptz(3)
  nicknameSnapshot   String
  gradeSnapshot      String?
  productLabel       String
  quantity           Int
  timerSeconds       Int             @default(0)
  openingStartedAt   DateTime?       @db.Timestamptz(3)
  doneAt             DateTime?       @db.Timestamptz(3)
  cancelledAt        DateTime?       @db.Timestamptz(3)
  cancelReason       String?
  version            Int             @default(0)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)

  seller           Seller                   @relation(fields: [sellerId], references: [id])
  order            Order?                   @relation(fields: [sellerId, orderId], references: [sellerId, id])
  orderItem        OrderItem?               @relation(fields: [sellerId, orderItemId], references: [sellerId, id])
  externalOrder    ExternalOrder?           @relation(fields: [sellerId, externalOrderId], references: [sellerId, id])
  broadcastSession BroadcastSession?        @relation(fields: [sellerId, broadcastSessionId], references: [sellerId, id])
  statusHistory    QueueItemStatusHistory[]
  hitCards         HitCard[]

  @@unique([sellerId, id])
  @@unique([sellerId, orderItemId])
  // 같은 외부 주문 줄은 한 번만 대기열에 오른다(웹훅 재전송·누락 보정 중복 방지)
  @@unique([sellerId, externalOrderId, externalLineNo])
  @@index([sellerId, status, position])
  @@index([sellerId, broadcastSessionId])
}

model QueueItemStatusHistory {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String           @db.Uuid
  queueItemId String           @db.Uuid
  fromStatus  QueueItemStatus?
  toStatus    QueueItemStatus
  actorType   ActorType
  actorId     String?          @db.Uuid
  reason      String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  seller    Seller    @relation(fields: [sellerId], references: [id])
  queueItem QueueItem @relation(fields: [sellerId, queueItemId], references: [sellerId, id])

  @@index([sellerId, queueItemId])
}

model HitCard {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String   @db.Uuid
  broadcastSessionId String?  @db.Uuid
  queueItemId        String?  @db.Uuid
  buyerMemberId      String?  @db.Uuid
  nicknameSnapshot   String
  cardName           String
  // 등급(SA-053 「등급」 열). 정해 둔 목록(HIT_GRADES: SAR·SR·UR·SE·SP·AA) 중 하나, 비워 둘 수 있다.
  grade              String?
  note               String?
  createdByUserId    String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  seller           Seller            @relation(fields: [sellerId], references: [id])
  broadcastSession BroadcastSession? @relation(fields: [sellerId, broadcastSessionId], references: [sellerId, id])
  queueItem        QueueItem?        @relation(fields: [sellerId, queueItemId], references: [sellerId, id])
  buyerMember      BuyerMember?      @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@index([sellerId, broadcastSessionId])
}

// ───────────── 적립금 ─────────────

enum RevokeMode {
  AUTO
  MANUAL
}

// rates: { [gradeId]: { card: 퍼센트, bankTransfer: 퍼센트 } }. 실지급 스위치는 기본 꺼짐.
model RewardPolicy {
  sellerId            String           @id @db.Uuid
  rates               Json             @default("{}")
  earnStartsAt        DateTime?        @db.Timestamptz(3)
  revokeMode          RevokeMode       @default(AUTO)
  livePayoutEnabled   Boolean          @default(false)
  livePayoutChangedAt DateTime?        @db.Timestamptz(3)
  livePayoutChangedBy String?          @db.Uuid
  rankingBonusEnabled Boolean          @default(false)
  rankingBonusAmount  Int              @default(0)
  // 적립금 지급 시점(대표님 결정 2026-10-03): 결제 즉시 또는 배송 완료 후(기본)
  earnTiming          RewardEarnTiming @default(ON_DELIVERY)
  // 적립금 사용 조건(SA-031, MASTER 2026-10-06): 최소 사용 금액(원, 기본 1,000)과 주문당 최대 사용 비율(%, 0=제한 없음). 설정 저장은 rewards/policyAdmin.ts, 견적·주문 적용은 결제 쪽.
  useMinAmount        Int              @default(1000)
  useMaxRatio         Int              @default(0)
  updatedAt           DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

enum RewardEarnTiming {
  ON_PAYMENT
  ON_DELIVERY
}

enum RewardLedgerType {
  EARN
  REVOKE
  USE
  RANKING_BONUS
  ADJUST
  // 소멸(탈퇴 때 남은 잔액, 마지막 적립 뒤 3년). 음수 금액, 바로 SUCCEEDED로 잔액에 반영한다.
  EXPIRE
}

enum RewardLedgerStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model RewardLedger {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String             @db.Uuid
  buyerMemberId  String             @db.Uuid
  orderId        String?            @db.Uuid
  type           RewardLedgerType
  amount         Int
  status         RewardLedgerStatus @default(PENDING)
  testMode       Boolean
  failureReason  String?
  // 수동 조정(ADJUST) 사유(SA-033, 필수 입력 최대 200자). 다른 유형은 null.
  reason         String?
  idempotencyKey String
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?          @db.Timestamptz(3)

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])
  order       Order?      @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([sellerId, idempotencyKey])
  @@index([sellerId, buyerMemberId])
}

// balance >= 0 CHECK는 마이그레이션 SQL.
model RewardBalance {
  sellerId      String   @db.Uuid
  buyerMemberId String   @db.Uuid
  balance       Int      @default(0)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@id([sellerId, buyerMemberId])
}

// ───────────── 오버레이·감사 로그 ─────────────

model OverlayToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String    @db.Uuid
  tokenHash  String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  // 오버레이 주소로 마지막 접속한 시각(1분에 한 번만 갱신, 마스터 관리자 운영 현황 MA-041·042)
  lastSeenAt DateTime? @db.Timestamptz(3)
  // 발급·재발급한 사람(SA-052 재발급 이력, 발급 때 스냅숏 「쇼핑몰 이름 · 직원 이름」). 이 기록 전 토큰은 null.
  issuedByName String?

  seller   Seller          @relation(fields: [sellerId], references: [id])
  accesses OverlayAccess[]

  @@index([sellerId])
}

// 방송 화면 주소 접속 기록(SA-052). 화면을 열 때(레이아웃 요청) 한 줄, 같은 접속 환경·레이아웃이 10분 안에 다시 열면 새로 남기지 않는다.
// 사용자 에이전트 원문은 저장하지 않고 읽기 쉬운 이름(「OBS 30.1 · Windows」)만 남긴다. 판매자당 최근 100건만 보관.
model OverlayAccess {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String   @db.Uuid
  tokenId  String   @db.Uuid
  at       DateTime @default(now()) @db.Timestamptz(3)
  client   String
  isObs    Boolean
  layout   String?

  token OverlayToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([sellerId, at])
  @@index([tokenId, at])
}

// 추가만 한다. 수정·삭제하지 않는다. 비밀번호 해시·토큰·TOTP 비밀키는 before/after에 넣지 않는다.
model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType   ActorType
  actorId     String?   @db.Uuid
  sellerId    String?   @db.Uuid
  action      String
  targetType  String?
  targetId    String?
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  // 구매자 회원이 행위자·대상인 행: 회원 id를 둘 기한(retainUntil, 기록 시각 + 거래 관련 5년·거래 무관 3개월, audit/log.ts)과
  // 탈퇴 때 거래 관련 행에 다는 분리 보관 표시(legalHoldAt, buyers/legalHold.ts). 기한 뒤 회원 id 비식별은 별도 함수.
  legalHoldAt DateTime? @db.Timestamptz(3)
  retainUntil DateTime? @db.Timestamptz(3)

  seller Seller? @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt])
  @@index([action, createdAt])
}

// ───────────── 플랫폼 구독 (판매자 → 플랫폼) ─────────────

// 요금제. 가격은 코드에 두지 않고 여기서 바꾼다(마스터). 금액은 부가세 포함 원 단위, 청구액은 salePrice.
model SubscriptionPlan {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String    @unique
  name               String
  listPrice          Int
  salePrice          Int
  // 체험하기 중 한도(대표님 결정 2026-10-02). 코드 수정 없이 마스터가 바꾼다.
  trialMessageLimit  Int       @default(100)
  trialIdentityLimit Int       @default(50)
  trialStorageMb     Int       @default(1024)
  // 마스터 승인 시각부터의 체험 일수(오버레이 전용 7, 통합 0 = 체험 없음, ARCHITECTURE 4.8.0)
  trialDays          Int       @default(0)
  // 월 거래 메일 제공량(통, KST 달 기준, 대표님 결정 2026-10-05). 넘는 거래 메일은 발송 충전 잔액에서 차감한다.
  // 최고관리자만 바꾸고(billing.price), 적용 예정일을 두면 그때부터 새 값(next*). lib/server/mail/quota.ts
  mailMonthlyQuota   Int       @default(100)
  nextMailQuota      Int?
  nextMailQuotaAt    DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  subscriptions SellerSubscription[]
  priceChanges  SubscriptionPriceChange[]
  sellers       Seller[]
  pendingFor    SellerSubscription[]      @relation("PendingPlan")
  targetOf      SubscriptionPayment[]     @relation("PaymentTargetPlan")
}

// 판매가 변경 기록(대표님 결정 2026-10-02). 새 가입자는 바로 새 가격, 기존 구독자는 구독을 시작할 때 적용되던 가격을 내다가
// 변경 시각 + 30일 이후 첫 결제부터 새 가격을 낸다. 청구 금액은 이 기록으로 계산한다(priceFor).
model SubscriptionPriceChange {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId           String   @db.Uuid
  listPrice        Int
  salePrice        Int
  changedAt        DateTime @db.Timestamptz(3)
  changedByAdminId String?  @db.Uuid

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([planId, changedAt])
}

enum SellerSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

// 쇼핑몰당 하나. 카드 자동결제(빌링키)만 쓴다. 빌링키는 서버 비밀키로 암호화해서만 저장한다.
model SellerSubscription {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId                String                   @unique @db.Uuid
  planId                  String                   @db.Uuid
  status                  SellerSubscriptionStatus @default(ACTIVE)
  billingKeyCipher        String?
  cardLabel               String?
  currentPeriodStart      DateTime?                @db.Timestamptz(3)
  currentPeriodEnd        DateTime?                @db.Timestamptz(3)
  cancelAtPeriodEnd       Boolean                  @default(false)
  // 다음 결제(또는 해지 처리)를 할 시각. 예약 실행이 이 시각이 지난 구독을 처리한다. 없으면 할 일 없음.
  nextChargeAt            DateTime?                @db.Timestamptz(3)
  // 매달 기간을 세는 기준 시각(첫 결제 기간의 시작). KST 날짜·시각으로 다음 달 같은 날(없으면 말일)을 센다.
  billingAnchorAt         DateTime?                @db.Timestamptz(3)
  // 지금 구독을 시작한 시각(처음 등록, 또는 해지 뒤 다시 구독). 기존 구독자 가격 판단에 쓴다.
  subscribedAt            DateTime                 @default(now()) @db.Timestamptz(3)
  // 해지(CANCELED)된 시각. 이 뒤에 만든 청구만 구독을 되살릴 수 있다(해지 전 청구가 늦게 확정돼도 되살리지 않음).
  canceledAt              DateTime?                @db.Timestamptz(3)
  // 자동결제 실패 뒤 다시 시도한 횟수(최대 3번)와 계속 쓸 수 있는 유예 끝(실패한 날 + 7일)
  retryCount              Int                      @default(0)
  graceUntil              DateTime?                @db.Timestamptz(3)
  // STANDARD → INTEGRATED 이전 전 가격 스냅숏(ONQ 1-C, ARCHITECTURE 4.8.0). 결제가 이어지는 구독에만 남긴다.
  // 고지 발송 완료 시각(legacyPriceNoticeSentAt) + 30일 전까지는 이 금액으로 청구하고, 발송 전(null)이면 계속 이 금액이다.
  // 해지 뒤 다시 구독하면 비운다(새 가입자 가격).
  legacyPrice             Int?
  legacyPriceNoticeSentAt DateTime?                @db.Timestamptz(3)
  // 다음 결제일에 바꿀 플랜(하위 변경, ONQ 1-C-2). 갱신 결제 직전에 planId로 옮기고 비운다. 다시 지금 플랜을 고르면 비운다.
  pendingPlanId           String?                  @db.Uuid
  // 이 구독은 정가로 청구한다(런칭 할인을 이미 쓴 계정이 해지 뒤 다시 구독, 대표님 결정 2026-10-04). 구독이 이어지는 동안 그대로다.
  regularPrice            Boolean                  @default(false)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)

  seller      Seller                @relation(fields: [sellerId], references: [id])
  plan        SubscriptionPlan      @relation(fields: [planId], references: [id])
  pendingPlan SubscriptionPlan?     @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  payments    SubscriptionPayment[]

  @@unique([sellerId, id])
  @@index([status, nextChargeAt])
}

// PERIOD: 이용 기간 결제(첫 결제·갱신·재시도·카드 등록·체험 중 상위 변경). PRORATION: 결제 중 상위 변경의 남은 기간 차액(기간을 바꾸지 않음).
enum SubscriptionPaymentKind {
  PERIOD
  PRORATION
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
}

// 청구 내역. 같은 구독·같은 이용 기간에는 진행 중이거나 결제된 청구가 하나만 있다(마이그레이션 SQL 부분 유니크).
model SubscriptionPayment {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String                    @db.Uuid
  subscriptionId    String                    @db.Uuid
  amount            Int
  status            SubscriptionPaymentStatus @default(PENDING)
  periodStart       DateTime                  @db.Timestamptz(3)
  periodEnd         DateTime                  @db.Timestamptz(3)
  providerPaymentId String?
  receiptUrl        String?
  failureReason     String?
  // 예약 실행이 만든 청구(true)인지, 판매자가 카드 등록으로 직접 낸 청구(false)인지
  scheduled         Boolean                   @default(false)
  kind              SubscriptionPaymentKind   @default(PERIOD)
  // 상위 변경 청구면 결제가 확정될 때 옮길 플랜(실패·대기면 지금 플랜 유지, ONQ 1-C-2)
  targetPlanId      String?                   @db.Uuid
  // 런칭가(판매가)로 낸 청구인지. 확정되면 판매자에 런칭 할인 사용을 남긴다(정가·이전 전 가격 청구는 false)
  launchDiscount    Boolean                   @default(false)
  paidAt            DateTime?                 @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)

  seller       Seller               @relation(fields: [sellerId], references: [id])
  subscription SellerSubscription   @relation(fields: [sellerId, subscriptionId], references: [sellerId, id])
  targetPlan   SubscriptionPlan?    @relation("PaymentTargetPlan", fields: [targetPlanId], references: [id])
  refunds      SubscriptionRefund[]

  @@index([sellerId, createdAt])
  // 마스터 청구·결제 내역(MA-024)의 기간 조회와 구독별 최신 청구 판정
  @@index([createdAt])
  @@index([subscriptionId, createdAt])
}

// 주문 단위 결제 전 동의(대표님 결정 2026-10-02): 「개봉하면 취소·환불이 안 돼요」. 동의하지 않으면 주문을 만들지 않는다.
// 동의 시각은 DB 시계, 고지 문구 버전을 함께 남긴다(법정 동의 기록, ARCHITECTURE).
model OrderConsent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String   @db.Uuid
  orderId       String   @db.Uuid
  kind          String
  noticeVersion String
  agreedAt      DateTime @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([orderId, kind])
  @@index([sellerId, orderId])
}

enum FulfillmentType {
  IMMEDIATE
  STORAGE
}

// 판매자 배송비 정책(판매자당 1행, 없으면 기본값). 금액은 원, 부가세 포함.
// 배송비 = 기본 배송비(상품 금액이 무료 기준 이상이면 0) + 도서산간이면 추가 배송비(무료 기준과 상관없이).
// 도서산간은 우편번호 범위 목록(remoteZipRanges: [[시작, 끝], ...])으로 판정한다.
model SellerShippingPolicy {
  sellerId        String   @id @db.Uuid
  // 무료 배송(0원) 유형. 켜면 기본 배송비·무료 기준을 쓰지 않고, 도서산간 추가비는 그대로 붙는다.
  freeShipping    Boolean  @default(false)
  baseFee         Int      @default(3000)
  freeOverAmount  Int?
  remoteSurcharge Int      @default(3000)
  remoteZipRanges Json     @default("[[63000, 63644], [40200, 40240]]")
  // 반품 배송비(편도)·교환 배송비(왕복). 구매자 사정일 때만 받는다(PRODUCT_SCOPE 「반품·교환 배송비」).
  returnFee       Int      @default(3000)
  exchangeFee     Int      @default(6000)
  // 구매자가 고를 수 있는 받는 방법(FulfillmentType 값). 지금은 즉시 발송(IMMEDIATE)만 켤 수 있다(보관 후 합배송은 출시 후 1차).
  receiveMethods  String[] @default(["IMMEDIATE"])
  // 결제 확인 뒤 발송까지 안내하는 기한(일, 1~30)
  dispatchDeadlineDays Int @default(3)
  // 발송 처리 화면에서 처음 고르는 택배사(COURIERS 코드). 없으면 null.
  defaultCourier  String?
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 주문할 때 받은 배송지(스냅숏). 회원 정보가 바뀌어도 그대로 남는다. 받는 분 이름·연락처·주소는 CUSTOMER_PII_VIEW가 있을 때만 응답에 넣는다.
model OrderShippingAddress {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String  @db.Uuid
  orderId       String  @unique @db.Uuid
  recipientName String
  phone         String
  zipCode       String
  address1      String
  address2      String?
  memo          String?
  isRemote      Boolean @default(false)

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([sellerId, orderId])
}

enum ShipmentStatus {
  READY
  IN_TRANSIT
  DELIVERED
}

// 배송 레코드(즉시 발송은 주문당 1건). 송장은 판매자가 직접 입력한다(택배사 연동은 나중).
model Shipment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String         @db.Uuid
  orderId        String         @unique @db.Uuid
  courier        String
  trackingNumber String
  status         ShipmentStatus @default(IN_TRANSIT)
  shippedAt      DateTime       @db.Timestamptz(3)
  deliveredAt    DateTime?      @db.Timestamptz(3)
  // 배송 자동조회(판매자가 켠 경우만, 건당 발송·이용 충전금 차감)를 마지막으로 시도한 시각. 조회 간격(6시간)을 지키는 데만 쓴다.
  trackingCheckedAt DateTime?   @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([sellerId, orderId])
}

// 송장(SA-027 송장 발급 · SA-028 출력·추적). 상자 하나에 송장 하나, 합배송이면 주문 여러 건이 한 송장에 묶인다(ShipmentInvoiceOrder).
// 배송 접수 업체가 정해지기 전이라 모의 발급이다(mock=true, lib/server/invoices/provider.ts의 어댑터 자리). 모의 송장은 주문 상태·배송 레코드(Shipment)·구매자 안내를 바꾸지 않는다.
// FAILED = 아직 번호가 없는 상태(발급 중이거나 업체 응답 실패, failureCode). 번호가 있으면 ISSUED → PRINTED(출력) → PICKED_UP(집하) → DELIVERED(배송 완료).
enum InvoiceStatus {
  FAILED
  ISSUED
  PRINTED
  PICKED_UP
  DELIVERED
}

enum InvoiceEventKind {
  ISSUED
  PRINTED
  PICKUP_REQUESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

model ShipmentInvoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String        @db.Uuid
  courier        String
  trackingNumber String?
  status         InvoiceStatus @default(FAILED)
  mock           Boolean       @default(true)
  attempts       Int           @default(1)
  failureCode    String?
  issuedAt       DateTime?     @db.Timestamptz(3)
  printedAt      DateTime?     @db.Timestamptz(3)
  printFormat    String?
  pickedUpAt     DateTime?     @db.Timestamptz(3)
  deliveredAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller                 @relation(fields: [sellerId], references: [id])
  orders ShipmentInvoiceOrder[]
  events ShipmentInvoiceEvent[]

  @@unique([sellerId, id])
  @@index([sellerId, status, createdAt])
}

// 주문은 하나의 송장에만 묶인다(orderId 유니크). 발급이 실패한 송장도 주문을 잡고 있다가 다시 발급한다.
model ShipmentInvoiceOrder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String   @db.Uuid
  invoiceId String   @db.Uuid
  orderId   String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  seller  Seller          @relation(fields: [sellerId], references: [id])
  invoice ShipmentInvoice @relation(fields: [sellerId, invoiceId], references: [sellerId, id])
  order   Order           @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([sellerId, orderId])
  @@index([sellerId, invoiceId])
}

// 추적 상세의 한 줄(시각·상태·처리·비고). 종류마다 송장당 1행(유니크). source = SELLER(쇼핑몰) | CARRIER(택배사).
model ShipmentInvoiceEvent {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String           @db.Uuid
  invoiceId String           @db.Uuid
  kind      InvoiceEventKind
  at        DateTime         @db.Timestamptz(3)
  source    String
  note      String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  seller  Seller          @relation(fields: [sellerId], references: [id])
  invoice ShipmentInvoice @relation(fields: [sellerId, invoiceId], references: [sellerId, id])

  @@unique([invoiceId, kind])
  @@index([sellerId, invoiceId, at])
}

// 판매자 주문 정책(판매자당 1행, 없으면 기본값). PRODUCT_SCOPE 「무통장 입금·구매 제한 기본값」.
model SellerOrderPolicy {
  sellerId                       String    @id @db.Uuid
  // 미입금 자동 취소 사용 여부와 기간(시간). 기본 사용·24시간, 1~720시간(대표님 결정 2026-10-03).
  // 주문할 때 paymentDueAt을 정하는 데만 쓰고(끄면 기한 없음), 이미 만든 주문은 바꾸지 않는다.
  autoCancelEnabled              Boolean   @default(true)
  paymentDueHours                Int       @default(24)
  // 취소·반품 때 재고 자동 복구(기본 켜짐). 결제 전 취소·미입금 자동 취소·발송 전 환불에 적용한다.
  restockOnCancel                Boolean   @default(true)
  // 배송 중 n일 뒤 자동 배송 완료(기본 사용·7일), 배송 완료 n일 뒤 자동 구매 확정(기본 사용·7일). 1~30일(PRODUCT_SCOPE 「배송 완료」·「구매 확정」).
  autoDeliverEnabled             Boolean   @default(true)
  autoDeliverDays                Int       @default(7)
  autoConfirmEnabled             Boolean   @default(true)
  autoConfirmDays                Int       @default(7)
  // 입금 기한 알림(기본 켜짐). 끄면 이 쇼핑몰 주문은 알림 대상에서 뺀다(orders/notifications.ts).
  dueReminderEnabled             Boolean   @default(true)
  // 배송 자동 조회(기본 꺼짐). 켜면 송장 1건 조회마다 발송·이용 충전금에서 차감한다(docs/COST_POLICY.md). 지금은 설정만 저장하고 유료 연동은 하지 않는다.
  autoTrackingEnabled            Boolean   @default(false)
  // 「미입금 자동 취소 3회 → 30일 주문 막기」
  unpaidRestrictionEnabled       Boolean   @default(true)
  // 꺼져 있다가 다시 켠 시각. 이 뒤의 자동 취소만 센다(MASTER 결정).
  unpaidRestrictionEnabledAt     DateTime? @db.Timestamptz(3)
  // 「결제 후 취소 5회 → 30일 주문 막기」(기본 꺼짐). 구매자 사정(refundFault=BUYER)으로 표시한 환불만 센다.
  paidCancelRestrictionEnabled   Boolean   @default(false)
  // 켠 시각. 이 뒤의 환불만 센다(켜기 전 환불은 넣지 않음).
  paidCancelRestrictionEnabledAt DateTime? @db.Timestamptz(3)
  // 판매자별 단조 시계(orders/overdue.ts sellerEventClock)가 마지막으로 찍은 시각. 주문 생성 잠금 아래에서만 바꾼다.
  lastEventClockAt               DateTime? @db.Timestamptz(3)
  // 파트너스가 「주문 정책」을 실제로 저장한 시각(없으면 쇼핑몰 생성 때 기본값으로 만든 행이거나 시계만 찍은 행). 온보딩 「설정 완료」 판정에 쓴다.
  savedAt                        DateTime? @db.Timestamptz(3)
  updatedAt                      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 쇼핑몰별 구매자 주문 제한. 막는 기간은 startsAt~endsAt이고, 판매자가 풀면 liftedAt을 남긴다.
// 횟수는 마지막 제한의 startsAt(또는 liftedAt) 뒤에 생긴 자동 취소만 센다.
model BuyerPurchaseRestriction {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @db.Uuid
  buyerMemberId String    @db.Uuid
  reason        String
  // 파트너스가 직접 건 제한(reason=MANUAL)의 사유 메모(200자). 자동 제한은 비어 있다.
  note          String?
  startsAt      DateTime  @db.Timestamptz(3)
  endsAt        DateTime  @db.Timestamptz(3)
  liftedAt      DateTime? @db.Timestamptz(3)
  liftedById    String?   @db.Uuid

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@index([sellerId, buyerMemberId, startsAt])
}

// 파트너스가 회원 상세(SA-042)에 적는 회원 메모. 회원마다 1건(덮어쓰기), 작성자·수정 시각을 남긴다.
// 자유 입력이라 개인정보가 섞일 수 있어 탈퇴 때 지운다(buyers/memberData.ts). 로그 추적에는 본문을 남기지 않고 글자 수만 남긴다.
// 마스터 관리자가 파트너스 상세(MA-012)에 남기는 내부 메모. 파트너스에게는 보이지 않는다(마스터 관리자 API만 읽는다).
// 작성자 이름은 쓴 때의 값을 남겨 계정이 바뀌어도 기록이 읽힌다. 파트너스가 정리돼도 메모는 지우지 않는다.
model SellerAdminNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String   @db.Uuid
  body       String
  authorId   String   @db.Uuid
  authorName String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt(sort: Desc), id(sort: Desc)])
}

model MemberMemo {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @db.Uuid
  buyerMemberId String    @db.Uuid
  body          String
  // 마지막으로 쓴 사람(파트너스 직원·대표자 id). 마스터 대리 조회는 쓰기를 못 하므로 직원만 들어간다.
  updatedById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @db.Timestamptz(3)

  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)

  @@unique([sellerId, buyerMemberId])
}

// 주문 알림 발송 기록(중복 발송 방지). 주문·종류마다 1행. 보내기 전에 PENDING으로 먼저 잡고(claim), 보낸 뒤 SENT·FAILED로 바꾼다.
// 실패했거나 PENDING으로 오래 멈춘 기록은 시도 횟수 안에서 다시 잡을 수 있다(lib/server/orders/notifications.ts).
enum OrderNotificationKind {
  PAYMENT_DUE_SOON
  // 파트너스가 현금영수증·세금계산서를 직접 발행하고 완료 처리했을 때 구매자 안내(SA-024). 발송 채널 연동 전이라 기록만(PENDING).
  RECEIPT_ISSUED
}

enum OrderNotificationStatus {
  PENDING
  SENT
  FAILED
}

model OrderNotification {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String                  @db.Uuid
  orderId       String                  @db.Uuid
  kind          OrderNotificationKind
  status        OrderNotificationStatus @default(PENDING)
  attempts      Int                     @default(1)
  claimedAt     DateTime                @db.Timestamptz(3)
  sentAt        DateTime?               @db.Timestamptz(3)
  failureReason String?
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([orderId, kind])
  @@index([sellerId, kind, status])
}

// 적립금 소멸 30일 전 안내 「보냈음」 기록(PRODUCT_SCOPE 「적립금 소멸」, 알림톡·실패하면 문자, 메일 없음). 발송 연동 전이라 기록만.
// 회원·마지막 적립 시각마다 1행이라 같은 소멸 예정을 두 번 안내하지 않고, 새로 적립하면(기준일이 바뀜) 다음 소멸 때 다시 안내한다.
model RewardExpiryNotice {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String                  @db.Uuid
  buyerMemberId String                  @db.Uuid
  lastEarnAt    DateTime                @db.Timestamptz(3)
  status        OrderNotificationStatus @default(PENDING)
  attempts      Int                     @default(1)
  claimedAt     DateTime                @db.Timestamptz(3)
  sentAt        DateTime?               @db.Timestamptz(3)
  failureReason String?
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)

  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@unique([buyerMemberId, lastEarnAt])
  @@index([sellerId, status])
}

// 판매자 회원 정책. 재가입 제한(대표님 결정 2026-10-03, 기본 꺼짐): 켜면 탈퇴한 사람(본인확인 기준)이 정한 기간(일) 동안 다시 가입할 수 없다.
model SellerMemberPolicy {
  sellerId                 String   @id @db.Uuid
  rejoinRestrictionEnabled Boolean  @default(false)
  rejoinRestrictionDays    Int      @default(30)
  updatedAt                DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 쇼핑몰 검색 노출 설정(SA-067). 행이 없으면 기본값(검색 노출·사이트맵 켬, 나머지 비움). 상품별 규칙의 {상품명}·{쇼핑몰}은 공개 화면이 채운다.
model ShopSeo {
  sellerId                   String   @id @db.Uuid
  searchTitle                String?
  searchDescription          String?
  indexingEnabled            Boolean  @default(true)
  sitemapEnabled             Boolean  @default(true)
  productTitleTemplate       String?
  productDescriptionTemplate String?
  googleVerification         String?
  naverVerification          String?
  updatedAt                  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 주문자 메일 켜기·끄기(SA-080). 거래 메일 4종(주문 완료·발송·배송 완료·취소·환불), 기본은 모두 켬. 행이 없으면 모두 켠 것으로 본다.
model SellerOrderNotificationPolicy {
  sellerId             String   @id @db.Uuid
  orderCompleteEnabled Boolean  @default(true)
  shippedEnabled       Boolean  @default(true)
  deliveredEnabled     Boolean  @default(true)
  cancelRefundEnabled  Boolean  @default(true)
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 재가입 제한 목적으로만 남기는 탈퇴 회원의 본인확인 식별값 해시. 이름·휴대폰 등 다른 정보는 두지 않는다.
// 재가입 제한이 켜진 쇼핑몰에서 탈퇴할 때만 만들고, expiresAt이 지나거나 판매자가 제한을 끄면 지운다(buyers/rejoin.ts).
model BuyerRejoinBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String   @db.Uuid
  ciHash    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@unique([sellerId, ciHash])
  @@index([expiresAt])
}

// 앱 안 정기 실행 heartbeat(인스턴스·작업별 마지막 실행). 감시는 앱 밖 수집기(scripts/ops/monitor.mjs)가 이 표를 읽어 판단한다.
// 작업 이름 "scheduler.tick"은 정기 실행 루프 자체(작업을 잠금 때문에 건너뛰어도 남음).
// 앱 인스턴스(이름별) 상태의 유일한 기준(ops/metrics.ts). 프로세스가 시작할 때 등록하며 새 세대 값(uuid)을 쓰고 종료 표시를 비운다.
model OpsInstance {
  name         String    @id
  generation   String
  // 정상 종료(SIGTERM·SIGINT) 때 자기 세대일 때만 남기는 종료 시각. 없으면 아무리 오래돼도 살아 있는 인스턴스로 본다.
  retiredAt    DateTime? @db.Timestamptz(3)
  registeredAt DateTime  @db.Timestamptz(3)
}

// 정기 실행 heartbeat(인스턴스·세대·작업별). 지표는 OpsInstance의 지금 세대 행만 본다.
model OpsHeartbeat {
  instance   String
  generation String
  job        String
  lastRunAt  DateTime  @db.Timestamptz(3)
  // done | skipped | failed
  lastStatus String
  lastError  String?
  // 마지막 성공 시각(실패가 이어져도 언제부터인지 알 수 있게)
  lastOkAt   DateTime? @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@id([instance, generation, job])
}

// 인프라 감시 사건(수집기가 남기는 incident 열기·닫기 등). 마스터 관리자(최고관리자)가 읽는다.
// 쓰기는 내부 토큰(OPS_INGEST_TOKEN)으로 인증한 POST /api/internal/ops/events만. 같은 (source, eventId)는 한 번만 저장한다(재전송 안전).
model OpsEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 들어온 순서(같은 occurredAt끼리 정할 때 늦게 들어온 쪽이 뒤)
  seq        BigInt   @default(autoincrement())
  source     String
  // 수집기가 붙인 사건 id(재전송 중복 제거)
  eventId    String
  // incident_open | incident_close | info 등
  kind       String
  // 같은 사건을 묶는 키(예: health, cert, version_mismatch)
  key        String
  severity   String
  message    String
  detail     Json?
  occurredAt DateTime @db.Timestamptz(3)
  // 서버가 받은 시각(보존 기간 기준)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([source, eventId])
  @@unique([seq])
  @@index([occurredAt])
  // 열린 사건 계산(수집기·key별 마지막으로 받은 사건)
  @@index([source, key, seq])
  // 보존 기간 정리(받은 시각)
  @@index([createdAt])
}

// ───────────── 관리자 화면 브랜딩 (마스터 관리자가 바꿈) ─────────────

// 관리자 화면별 파비콘·공유 카드. target: "admin"(마스터 관리자) | "seller"(파트너스 관리자, 플랫폼 공통 1벌). 값·크기는 마이그레이션 CHECK로 묶는다.
// 이미지는 저장소 결정(A: DB bytea / B: 버킷) 전까지 이 표에 바이트로 둔다. 읽기·쓰기는 lib/server/branding/store.ts 한 곳에서만 한다.
// *Hash는 바이트의 sha256 앞 12자(주소의 버전 값). 이미지가 없으면 데이터·형식·해시가 모두 null이다.
model SiteBranding {
  target        String   @id
  faviconData   Bytes?
  faviconType   String?
  faviconHash   String?
  ogTitle       String?
  ogDescription String?
  ogImageData   Bytes?
  ogImageType   String?
  ogImageHash   String?
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// ───────────── 외부 서비스 업체 등록·비교(마스터 관리자 설정 > 외부 서비스 연동, docs/COST_POLICY.md) ─────────────
// 분야별(PG·배송·배송조회) 업체 목록, 분야마다 「추천」 1개·「선택된 업체」 1개. 추천·가중치는 코드에 고정하지 않고 마스터 관리자가 바꾼다.
// 요금(referenceFee)은 공개 기준 참고값(글)이며 실제 계약 조건이 아니다. 실제 외부 연동·계약은 하지 않는다.
// features: 분야별 허용 키 목록(String), ratings: { 평가 항목 키: 0~10 } (점수는 가중치로 서버가 계산).
// (추천·선택 업체 id, category) → ServiceVendor(id, category) 복합 외래키(분야가 다른 업체를 못 고름)와 CHECK는 마이그레이션 SQL에 있다.
enum ServiceVendorCategory {
  PG
  SHIPPING
  TRACKING
}

model ServiceVendor {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category     ServiceVendorCategory
  name         String
  features     String[]              @default([])
  referenceFee String?
  memo         String?
  ratings      Json                  @default("{}")
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  logo          ServiceVendorLogo?
  recommendedIn ServiceVendorSetting[] @relation("ServiceVendorRecommended")
  selectedIn    ServiceVendorSetting[] @relation("ServiceVendorSelected")

  @@unique([category, name])
  @@unique([id, category])
}

// 업체 로고(PNG, 256KB 이하, 16~600px). 플랫폼 저장소(지금은 Postgres)에 보관한다. 외부 주소 직접 연결 금지.
model ServiceVendorLogo {
  vendorId  String   @id @db.Uuid
  data      Bytes
  type      String
  hash      String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  vendor ServiceVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model ServiceVendorSetting {
  category            ServiceVendorCategory @id
  weights             Json
  recommendedVendorId String?               @db.Uuid
  selectedVendorId    String?               @db.Uuid
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamptz(3)

  // 추천·선택 업체는 같은 분야의 업체만(복합 외래키 (업체 id, 분야) → ServiceVendor(id, category), 마이그레이션 20261005042000_service_vendors의 SQL과 같음)
  recommendedVendor ServiceVendor? @relation("ServiceVendorRecommended", fields: [recommendedVendorId, category], references: [id, category], onDelete: Restrict, map: "ServiceVendorSetting_recommended_fkey")
  selectedVendor    ServiceVendor? @relation("ServiceVendorSelected", fields: [selectedVendorId, category], references: [id, category], onDelete: Restrict, map: "ServiceVendorSetting_selected_fkey")
}

// ───────────── 자동 설치·연결 상품 (docs/AUTOMATION.md) ─────────────
// 결제 상태(AutomationPayment)와 연결 작업 상태(AutomationJob)를 따로 둔다. 작업은 서버가 결제를 PAID로 확정한
// 같은 트랜잭션에서만 QUEUED가 된다(무료 재연결은 서버가 대상 판정 뒤 바로 QUEUED). 판매자 테이블과는 Prisma 관계를 두지 않는다(Seller 모델을 고치지 않기 위해,
// sellerId는 세션에서만 얻고 모든 조회에 조건으로 붙인다). 블록 안 자식은 (sellerId, 부모 id) 복합 외래키로 묶는다.
// 부분 유니크(판매자당 열린 작업 1개, 같은 OBS 대상 실행 1개)와 CHECK는 마이그레이션 SQL에 있다.

// 환불(2026-10-04 대표님 확정 ②): 성공 기준(테스트 주문이 고객 OBS 오버레이에 표시)을 통과하지 못하고 지원으로도 해결되지 않으면 전액 환불.
// 연결 시작 뒤 단순 변심 환불은 없다. REFUND_PENDING = 환불 요청을 받아 처리 대기. 실제 환불 실행은 대표님 승인 대상이라 1차 코드에는 없다.
enum AutomationPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

// 결제 수단. BILLING_KEY = 구독에 등록한 카드(빌링키) 자동결제, ONE_TIME_CARD = 「다른 카드로 결제」(나이스페이 일반 결제창, 이번 한 번만, 카드 저장 안 함)
enum AutomationPaymentMethod {
  BILLING_KEY
  ONE_TIME_CARD
}

// INITIAL = 처음 자동 연결(110,000원), REINSTALL = 무료 대상이 아닌 재설치(33,000원),
// RECONNECT_FREE = 완료 뒤 30일 안 같은 쇼핑몰·같은 PC(OBS pairing) 재연결(무료, 결제 없음)
enum AutomationJobKind {
  INITIAL
  REINSTALL
  RECONNECT_FREE
}

enum AutomationJobStatus {
  AWAITING_PAYMENT
  QUEUED
  RUNNING
  NEEDS_CUSTOMER
  VERIFYING
  SUCCEEDED
  FAILED
  CANCELED
  // 정리 필요: 실패로 끝나야 하는데 작업이 만든 변경(쇼핑몰 앱·웹훅, OBS 소스)을 되돌리지 못했다. 사람이 정리한 뒤 FAILED·환불로 닫는다.
  CLEANUP_NEEDED
}

// 고객이 직접 해야 하는 일. 이 동안 작업은 실행 자리(lease)를 반납한다.
enum AutomationCustomerAction {
  LOGIN
  TWO_FACTOR
  CAPTCHA
  PERMISSION_GRANT
  LOCAL_TOOL
}

model AutomationPayment {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId               String                  @db.Uuid
  amount                 Int
  status                 AutomationPaymentStatus @default(PENDING)
  // 판매자가 보낸 Idempotency-Key. 같은 키로 다시 요청하면 같은 결제·작업을 돌려준다.
  idempotencyKey         String
  // 같은 키를 다른 요청(구매 ↔ 재설치, 다른 쇼핑몰 주소·대상)에 다시 쓰는지 가리는 요청 지문(종류·주소·대상의 해시)
  requestFingerprint     String
  // 결제 전 고지(연결 시작 뒤 단순 변심 환불 없음, 실패 시 전액 환불) 동의 기록. 동의가 없으면 결제를 만들지 않는다. 시각은 DB 시계.
  consentNoticeVersion   String
  consentAgreedAt        DateTime                @db.Timestamptz(3)
  // 결제 요청 보낸 기록(outbox). null = 아직 PG에 보내지 않음(결제 행만 만들고 멈춤). 대사가 같은 청구 id로 다시 보낸다.
  chargeSubmittedAt      DateTime?               @db.Timestamptz(3)
  // 처음 결제 요청을 보낸 시각. 「결제 안 됨」 마감(이 시각 + 30분)을 고정하는 기준이다. 다시 보내도 바뀌지 않는다.
  chargeFirstSubmittedAt DateTime?               @db.Timestamptz(3)
  // 대사가 마지막으로 확인한 시각. 확인할 때마다 갱신해 오류가 난 건도 뒤로 돌린다(앞 건이 계속 실패해도 뒤 건이 확인된다).
  lastCheckedAt          DateTime?               @db.Timestamptz(3)
  // 오래 미확정인 청구(조회 안 됨)를 마스터 관리자에게 알린 시각(1회만)
  unresolvedAlertedAt    DateTime?               @db.Timestamptz(3)
  providerPaymentId      String?
  method                 AutomationPaymentMethod @default(BILLING_KEY)
  // 일반 결제창(ONE_TIME_CARD) 결제의 PG 거래 id와 승인 응답 카드 요약(카드사·끝 4자리). 환불은 이 거래 id로 취소한다. 카드번호 전체는 저장하지 않는다.
  pgTid                  String?                 @unique
  cardName               String?
  cardLast4              String?
  failureReason          String?
  paidAt                 DateTime?               @db.Timestamptz(3)
  refundReason           String?
  refundRequestedAt      DateTime?               @db.Timestamptz(3)
  refundedAt             DateTime?               @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)

  job AutomationJob?

  @@unique([sellerId, idempotencyKey])
  @@unique([sellerId, id])
  @@index([status, createdAt])
}

model AutomationJob {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId                String                    @db.Uuid
  kind                    AutomationJobKind         @default(INITIAL)
  // 무료 재연결(RECONNECT_FREE)만 결제가 없다(마이그레이션 CHECK)
  paymentId               String?                   @db.Uuid
  // 재연결·재설치가 기준으로 삼은 이전 완료 작업
  baseJobId               String?                   @db.Uuid
  // 재연결·재설치가 요청한 쇼핑몰·PC. 작업자는 실제로 연결된 쇼핑몰·PC가 이 값과 같은지 확인한다(다르면 reconnect_target_mismatch)
  targetShopKey           String?
  targetObsPairingId      String?
  status                  AutomationJobStatus       @default(AWAITING_PAYMENT)
  // 같은 OBS에 동시에 두 작업이 붙지 않게 잠그는 대상 키(판매자 OBS 연결 단위)
  obsTargetKey            String
  // 진행 중인 단계 순번(0부터). 단계 목록은 lib/server/automation/steps.ts
  stepIndex               Int                       @default(0)
  customerAction          AutomationCustomerAction?
  // 「고객 확인 필요」 할 일 목록(SA-152)에서 고객이 「완료」로 표시한 줄. 이어 하기(재개)로 대기열에 돌아가면 비운다. 작업자 진행에는 영향이 없다(표시용).
  customerActionsDone     AutomationCustomerAction[] @default([])
  // 고객 행동 대기 마감. 지나면 FAILED(customer_action_timeout)
  actionDeadlineAt        DateTime?                 @db.Timestamptz(3)
  attempts                Int                       @default(0)
  maxAttempts             Int                       @default(5)
  // 판단 모델 호출 비용(원 단위 추정). 상한을 넘기면 멈춘다.
  costUsed                Int                       @default(0)
  costLimit               Int                       @default(3000)
  runAfter                DateTime                  @default(now()) @db.Timestamptz(3)
  leaseOwner              String?
  leaseExpiresAt          DateTime?                 @db.Timestamptz(3)
  // 실행 자리를 잡을 때마다 1씩 오른다. 작업자는 이 값이 같을 때만 쓴다(fencing).
  fencingToken            Int                       @default(0)
  // 대기열에서 실행 자리를 잡을 때만 1씩 오른다(취소·회수·종료로 fencingToken이 올라도 오르지 않음). 다른 작업자가 이어받았는지 가리는 데 쓴다.
  claimSeq                Int                       @default(0)
  lastError               String?
  // 연결 결과: 외부 쇼핑몰 식별자(예: Cafe24 몰 id)와 고객 PC의 OBS pairing id. 무료 재연결 판정에 쓴다.
  shopKey                 String?
  // 판매자가 낸 쇼핑몰 주소의 호스트(소문자). 비밀값은 이 호스트의 관리자 경로에서만 넣는다.
  shopHost                String?
  // 정리 필요 표시: 무언가를 바꾼 뒤 실패·취소로 끝났다(쇼핑몰 앱·웹훅·OBS가 남았을 수 있음). 이때 마스터 관리자 알림을 남긴다.
  cleanupNeededAt         DateTime?                 @db.Timestamptz(3)
  // 판매자가 취소를 요청한 시각(취소 출처). 정리 필요를 닫을 때 취소(환불 없음)와 실패(환불 대기)를 이 값으로만 가른다(오류 문구로 추론하지 않음).
  cancelRequestedAt       DateTime?                 @db.Timestamptz(3)
  // 처음으로 변경 행동(클릭·입력·OBS 설정·테스트 주문)을 하기 직전에 남긴 시각. 변경 뒤 실패면 정리 필요로 본다.
  changedAt               DateTime?                 @db.Timestamptz(3)
  // 변경 행동을 시작한 단계(단계마다 첫 변경 직전, changedAt과 같은 쓰기). 되돌리기는 끝낸 단계와 여기 있는 현재 단계만 한다.
  mutatedSteps            String[]                  @default([])
  obsPairingId            String?
  // 쇼핑몰 앱 권한 해제 등으로 연결이 끊긴 시각. 있으면 무료 재연결 대상이 아니다.
  connectionRevokedAt     DateTime?                 @db.Timestamptz(3)
  // 성공 기준 검증 증거(테스트 주문 표시 확인 결과). 비밀값은 넣지 않는다.
  verifiedAt              DateTime?                 @db.Timestamptz(3)
  verificationEvidence    Json?
  // 연결 작업서(확정 ⑦-1). 쇼핑몰 주소로 서버가 고른 작업서 id·버전(내부용, 화면 비노출). 없으면 판단 모델로만 진행.
  playbookId              String?
  playbookVersion         Int?
  // 고객 행동 대기로 실행기에 브라우저 상태(암호화 보관본)를 맡겼는가. 작업이 끝나면(완료·취소·실패·마감) 작업자가
  // 실행기에 삭제를 요청하고 false로 돌린다(purgeEndedBrowserState). 삭제 요청이 끝나기 전까지 true로 남아 다시 시도된다.
  browserStateHeld        Boolean                   @default(false)
  // 끝난 작업의 보관 자료(브라우저 상태·임시 파일·행동 키 기록·OBS 연결 정보) 삭제를 실행기·로컬 도구에 요청한 시각.
  // 고객 대기가 없었던 작업도 포함해 끝난 모든 작업을 한 번씩 정리한다(worker.ts purgeEndedBrowserState).
  artifactsPurgedAt       DateTime?                 @db.Timestamptz(3)
  // 보관 자료 삭제 요청이 실패한 횟수·다음 재시도 시각(실패 행만 계속 고르지 않게 미룬다)·반복 실패 알림 시각(작업당 1건)
  artifactsPurgeAttempts  Int                       @default(0)
  artifactsPurgeRetryAt   DateTime?                 @db.Timestamptz(3)
  artifactsPurgeAlertedAt DateTime?                 @db.Timestamptz(3)
  // 무료 재연결(결제 없음) 요청의 Idempotency-Key·요청 지문. 유료 작업의 키는 결제 행에 있다.
  idempotencyKey          String?
  requestFingerprint      String?
  // 실행 통계: 판단 모델 호출 수, 작업서대로 실행한 행동 수, 화면이 작업서와 달랐던 단계(관리 화면 변경 신호)
  plannerCalls            Int                       @default(0)
  playbookActions         Int                       @default(0)
  deviatedSteps           String[]                  @default([])
  // 고객 대기를 뺀 실제 실행 시간 합계(ms)와 지금 실행 자리를 잡은 시각. 합계가 6시간을 넘으면 실패·전액 환불(정본 d6e22c4).
  activeMsUsed            Int                       @default(0)
  runStartedAt            DateTime?                 @db.Timestamptz(3)
  // 화면이 작업서와 마지막으로 달랐던 시각. 연습 연속 성공은 이 시각 뒤의 연습만 센다(practice.ts).
  lastDeviationAt         DateTime?                 @db.Timestamptz(3)
  // 무료 재연결의 쇼핑몰·PC 대조를 통과한 시각(그때의 쇼핑몰·PC는 shopKey·obsPairingId). 재시도 때 브라우저 단계를 다시 하지 않으면 이 기록을 쓴다.
  targetVerifiedAt        DateTime?                 @db.Timestamptz(3)
  // 외부 행동 격리 창: 마지막 외부 행동 시작 시각과 종료 확인 시각. 소유권이 넘어가거나 닫히는 지점은 종료 확인 또는 시작 + 행동 상한 + 여유까지 기다린다(quiescent)
  lastActionStartedAt     DateTime?                 @db.Timestamptz(3)
  lastActionEndedAt       DateTime?                 @db.Timestamptz(3)
  // 판매자가 「잠시 멈추기」를 누른 시각(SA-152). 있으면 작업자가 이 작업에 실행 자리를 주지 않는다(상태는 QUEUED로 두고 진행 단계 stepIndex는 그대로).
  // 「이어 하기」로 비우면 멈춘 단계부터 다시 시작한다. 시작·전체·실행 시간 마감은 멈춰도 그대로 흐른다(마감이 지나면 기존대로 닫고 환불 대기).
  pausedAt                DateTime?                 @db.Timestamptz(3)
  // 처음 대기열에 들어간 시각(결제 확인·무료 재연결 생성). 시작 마감 기준(deadlinesFor)
  queuedAt                DateTime?                 @db.Timestamptz(3)
  startedAt               DateTime?                 @db.Timestamptz(3)
  finishedAt              DateTime?                 @db.Timestamptz(3)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)

  payment AutomationPayment?   @relation(fields: [sellerId, paymentId], references: [sellerId, id])
  events  AutomationJobEvent[]

  @@unique([sellerId, id])
  // 결제 1건에 작업 1개
  @@unique([sellerId, paymentId])
  @@unique([sellerId, idempotencyKey])
  @@index([status, runAfter])
  @@index([sellerId, createdAt])
  @@index([sellerId, status, finishedAt])
}

// 외부 유료 API 월 사용량(원, 한국 시간 기준 월). 공급자·월마다 1행. 한도(월 1만 원, 2026-10-05 대표님 결정)에 닿으면 stoppedAt을 남기고 그 달은 호출을 멈춘다.
model ExternalApiUsage {
  provider  String
  period    String
  usedWon   Int       @default(0)
  limitWon  Int
  stoppedAt DateTime? @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @db.Timestamptz(3)

  @@id([provider, period])
}

// 외부 유료 API 호출 비용 원장(추가만 한다). 월 합계는 ExternalApiUsage와 같은 트랜잭션에서 올린다.
model ExternalApiCostLedger {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider  String
  period    String
  purpose   String
  jobId     String?  @db.Uuid
  costWon   Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([provider, period, createdAt])
}

// 작업 상태 전이 기록(누가·언제·어느 fencing 토큰으로). 비밀값은 넣지 않는다.
model AutomationJobEvent {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String               @db.Uuid
  jobId        String               @db.Uuid
  fromStatus   AutomationJobStatus?
  toStatus     AutomationJobStatus
  fencingToken Int
  detail       Json?
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)

  job AutomationJob @relation(fields: [sellerId, jobId], references: [sellerId, id])

  @@index([jobId, createdAt])
}

// 연결 작업서 연습 실행 기록(확정 ⑦-1). 시험용 쇼핑몰에서 작업서를 반복 실행한 결과. 판매자 데이터가 아니다.
// 같은 작업서 id·버전의 최근 연습이 연속으로 기준 횟수만큼 성공(화면 이탈 없이)해야 지원 목록에 오른다(lib/server/automation/practice.ts).
enum AutomationPracticeOutcome {
  SUCCEEDED
  FAILED
  NEEDS_CUSTOMER
}

model AutomationPracticeRun {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playbookId          String
  playbookVersion     Int
  outcome             AutomationPracticeOutcome
  // 멈춘 단계와 사유(코드). 비밀값·화면 원문은 넣지 않는다.
  failedStep          String?
  reason              String?
  durationMs          Int
  plannerCalls        Int
  playbookActions     Int
  costWon             Int
  deviatedSteps       String[]                  @default([])
  startedAt           DateTime                  @db.Timestamptz(3)
  finishedAt          DateTime                  @default(now()) @db.Timestamptz(3)
  // 실행기 보관 자료 정리(연습 실행의 작업 범위 id). 정리가 끝나지 않았으면 cleanupPendingAt에 다음 정리 시각을 둔다(null = 정리 끝).
  cleanupScopeId      String?                   @db.Uuid
  cleanupPendingAt    DateTime?                 @db.Timestamptz(3)
  cleanupAttempts     Int                       @default(0)
  // 「정리 필요」: 다시 시도 상한을 넘겨 자동 정리를 멈춘 시각. 이때 마스터 관리자 알림(감사 기록 운영 이벤트)을 1건 남긴다.
  cleanupNeededAt     DateTime?                 @db.Timestamptz(3)
  // 연습 환경 점유 토큰: 다음 연습이 기한 지난 회차를 회수할 때 올린다. 실행 중 회차는 행동 직전마다 그대로인지 확인한다
  fencingToken        Int                       @default(0)
  // 외부 행동 격리 창(작업과 같은 규칙)
  lastActionStartedAt DateTime?                 @db.Timestamptz(3)
  lastActionEndedAt   DateTime?                 @db.Timestamptz(3)

  @@index([playbookId, playbookVersion, finishedAt])
}

// 쇼핑몰 연결 권한 해제 기록(판매자·쇼핑몰마다 최신 시각). 작업 상태와 무관하게 남겨, 설치 작업이 진행 중일 때 온 해제도
// 그 작업이 끝난 뒤 무료 재연결 판정(decideReconnect)에서 본다(해제 시각이 기준 작업 생성 뒤면 무료 아님).
model AutomationShopRevocation {
  sellerId  String   @db.Uuid
  shopKey   String
  revokedAt DateTime @db.Timestamptz(3)

  @@id([sellerId, shopKey])
}

// 쇼핑몰 카테고리(SA-015, 2026-10-04 대표님 지시). 2단까지: 대분류(parentId 없음) 아래 소분류. 순서는 같은 부모 안에서 sortOrder.
// visible=false면 구매자 쇼핑몰에 보이지 않는다(대분류를 끄면 그 아래 소분류도 안 보인다). 삭제는 행을 지운다(지난 주문이 참조하지 않음).
// 판매자 격리: 부모·상품 연결은 (sellerId, id) 복합 키로만 잇는다. 값 범위는 lib/server/shop-category/rules.ts.
model ShopCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String   @db.Uuid
  parentId  String?  @db.Uuid
  name      String
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  parent          ShopCategory?        @relation("ShopCategoryTree", fields: [sellerId, parentId], references: [sellerId, id], onDelete: Restrict)
  children        ShopCategory[]       @relation("ShopCategoryTree")
  products        ProductCategory[]
  displaySections ShopDisplaySection[]

  @@unique([sellerId, id])
  @@index([sellerId, parentId, sortOrder])
}

// 상품 ↔ 카테고리(여러 개 지정 가능). 카테고리를 지우면 연결도 지운다.
model ProductCategory {
  sellerId   String   @db.Uuid
  productId  String   @db.Uuid
  categoryId String   @db.Uuid
  // 카테고리 안 진열 순서(SA-016 카테고리별 진열). 새로 지정하면 맨 뒤.
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  product  Product      @relation(fields: [sellerId, productId], references: [sellerId, id])
  category ShopCategory @relation(fields: [sellerId, categoryId], references: [sellerId, id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([sellerId, categoryId])
}

// 판매자별 마지막 상품 코드 번호(Product.codeNo). DB 트리거 product_assign_code_no만 올린다(행 잠금으로 판매자별 줄 세움).
model ProductCodeCounter {
  sellerId String @id @db.Uuid
  lastNo   Int
}

// 구매자 장바구니(SH-004, 로그인 회원만). 옵션마다 한 줄(같은 옵션을 다시 담으면 수량을 더한다). 회원당 50줄, 줄당 1~99개.
// 가격·재고·판매 상태는 담을 때 저장하지 않고 볼 때마다 지금 값으로 계산한다(shop-cart/service.ts). 회원 탈퇴 때 지운다.
model CartItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String   @db.Uuid
  buyerMemberId String   @db.Uuid
  optionId      String   @db.Uuid
  quantity      Int
  // 담거나 수량을 바꿀 때 보여 준 단가(이벤트 할인 반영). 장바구니가 지금 단가와 비교해 「가격이 바뀌었어요」를 알린다. 비교용이라 주문 금액에는 쓰지 않는다. 이전 줄은 null.
  addedUnitPrice Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller        @relation(fields: [sellerId], references: [id])
  member BuyerMember   @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)
  option ProductOption @relation(fields: [sellerId, optionId], references: [sellerId, id])

  @@unique([buyerMemberId, optionId])
  @@index([sellerId, buyerMemberId])
  @@index([sellerId, optionId])
}

// 공통 이미지 저장소의 DB 드라이버 표(IMAGE_STORAGE=db, 대표님 결정 2026-10-04: 오브젝트 스토리지로 옮길 수 있게 하되 지금은 DB).
// lib/server/storage/db.ts만 읽고 쓴다. storageKey = "db:" + id. 형식·크기·해시 CHECK는 마이그레이션 20261004250000_product_images.
model StoredImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String   @db.Uuid
  data        Bytes
  contentType String
  byteSize    Int
  sha256      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([sellerId])
}

// 구매자 찜(SH-034, 로그인 회원만). 상품마다 한 줄, 회원당 200개. 가격·판매 상태는 볼 때마다 지금 값(shop-wish/service.ts). 회원 탈퇴 때 지운다.
model WishItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String   @db.Uuid
  buyerMemberId String   @db.Uuid
  productId     String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  seller  Seller      @relation(fields: [sellerId], references: [id])
  member  BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)
  product Product     @relation(fields: [sellerId, productId], references: [sellerId, id])

  @@unique([buyerMemberId, productId])
  @@index([sellerId, buyerMemberId, createdAt])
  @@index([sellerId, productId])
}

// 구매자 알림 설정(SH-025). 끌 수 있는 칸만 저장하고, 줄이 없으면 켬이 기본이다. kind·channel 값은 buyers/notificationPrefs.ts와 마이그레이션 CHECK가 같다.
// 혜택·이벤트 줄은 여기 저장하지 않고 마케팅 수신 동의(BuyerMember.marketingConsentAt)가 그 값이다.
model BuyerNotificationPref {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String   @db.Uuid
  buyerMemberId String   @db.Uuid
  kind          String
  channel       String
  enabled       Boolean
  updatedAt     DateTime @default(now()) @db.Timestamptz(3)

  member BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)

  @@unique([buyerMemberId, kind, channel])
  @@index([sellerId, buyerMemberId])
}

// 재입고 알림 신청(SA-017·SH). 회원당 상품 하나에 한 줄. WAITING(품절 기다림) → QUEUED(재고가 들어와 발송 대기, 야간이면 아침 8시 KST로 미룸) → SENT(발송 기록만, 실제 발송은 아직 없음). 다시 신청하면 WAITING으로 돌아간다(shop-restock-alerts/service.ts).
enum RestockAlertStatus {
  WAITING
  QUEUED
  SENT
}

model RestockAlert {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String             @db.Uuid
  buyerMemberId String             @db.Uuid
  productId     String             @db.Uuid
  status        RestockAlertStatus @default(WAITING)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  restockedAt   DateTime?          @db.Timestamptz(3)
  notifyAt      DateTime?          @db.Timestamptz(3)
  notifiedAt    DateTime?          @db.Timestamptz(3)

  seller  Seller      @relation(fields: [sellerId], references: [id])
  member  BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)
  product Product     @relation(fields: [sellerId, productId], references: [sellerId, id])

  @@unique([buyerMemberId, productId])
  @@index([sellerId, productId, status])
  @@index([sellerId, status, notifyAt])
}

// 엑셀(CSV) 일괄 등록·내보내기 작업(SA-018). 일괄 등록은 PREVIEW(검증만, 1시간 안에 확정) → COMMITTING → COMMITTED(24시간 안에 되돌리기) → UNDONE.
// payload는 미리보기에서 통과한 상품 입력, errors는 행별 오류(shop-bulk-io/service.ts).
enum BulkJobKind {
  PRODUCT_IMPORT
}

enum BulkJobStatus {
  PREVIEW
  COMMITTING
  COMMITTED
  UNDONE
}

model BulkJob {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String        @db.Uuid
  kind              BulkJobKind
  status            BulkJobStatus @default(PREVIEW)
  fileName          String?
  totalRows         Int
  productCount      Int
  errors            Json          @default("{}")
  payload           Json          @default("[]")
  createdProductIds Json          @default("[]")
  failures          Json          @default("[]")
  keptCount         Int           @default(0)
  actorType         ActorType
  actorId           String?       @db.Uuid
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  // 확정을 시작한 시각(COMMITTING). 서버가 중간에 끊겨 멈춘 작업을 찾는 기준(shop-bulk-io/recover.ts). 옛 기록은 비어 있고 createdAt을 쓴다.
  committingAt      DateTime?     @db.Timestamptz(3)
  committedAt       DateTime?     @db.Timestamptz(3)
  undoUntil         DateTime?     @db.Timestamptz(3)
  undoneAt          DateTime?     @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt])
}

enum ProductImageKind {
  GALLERY
  DETAIL
}

// 상품 상세 페이지(PR-B, 2026-10-04 대표님 지시). 카페24처럼 글·사진 블록을 순서대로 둔다. HTML은 저장하지 않는다.
// blocks: [{ type: "text", text } | { type: "image", imageId }] 최대 30개. 검사·모양은 lib/server/products/detail.ts.
model ProductDetail {
  productId String   @id @db.Uuid
  sellerId  String   @db.Uuid
  blocks    Json
  // 에디터로 쓴 상세 설명(저장 때 서버가 허용한 태그·속성만 남긴 HTML, products/detailHtml.ts). 있으면 blocks보다 먼저 보여 준다(blocks는 예전 글·사진 블록).
  html      String?
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [sellerId, productId], references: [sellerId, id])

  @@unique([sellerId, productId])
}

enum ShopNoticeKind {
  NOTICE
  FAQ
}

// 쇼핑몰 공지·자주 묻는 질문(SA-066 관리, SH-030 구매자 조회). 공지는 최신순, 질문은 sortOrder순(분류 category는 질문만).
// 홈 띠 고정 공지는 쇼핑몰당 1개(부분 유니크 인덱스 ShopNotice_one_pinned_per_seller, 마이그레이션 SQL). 바꿀 때마다 로그 추적(shop-notice/service.ts).
model ShopNotice {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String         @db.Uuid
  kind        ShopNoticeKind
  title       String
  body        String
  category    String?
  isPinned    Boolean        @default(false)
  isPublished Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, kind, createdAt])
}

// ───────────── 교환·반품(shop-returns, SA-029 · SH-022-R) ─────────────

enum ReturnKind {
  RETURN
  EXCHANGE
}

// 신청 → 접수 → 회수 완료 → 완료(반품은 환불 연결, 교환은 교환 발송). 신청 단계에서 거절하거나 구매자가 철회할 수 있다.
enum ReturnStatus {
  REQUESTED
  ACCEPTED
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

// 수거 방법(접수할 때 판매자가 정함): 택배사 수거 접수 / 구매자 직접 발송 / 수거 없음(폐기·사진 확인)
enum ReturnPickup {
  COURIER
  BUYER_SHIP
  NONE
}

// 검수 결과(회수 완료 뒤 판매자가 입력). 이상 없음일 때만 바로 환불·교환 발송, 그 밖은 반송·거절을 고른다.
enum ReturnInspection {
  OK
  USED_DAMAGED
  MISSING_PARTS
}

enum ReturnReason {
  CHANGE_OF_MIND
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  OTHER
}

// 교환·반품 신청(주문당 진행 중인 신청은 1건: 부분 유니크 인덱스 ReturnRequest_one_active_per_order, 마이그레이션 SQL).
// 반품은 주문 전체, 교환은 품목 단위(품목의 수량 전체). 환불은 기존 환불(refundOrder)을 부르고 실제 PG 취소는 결제 연결이 맡는다.
model ReturnRequest {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId               String       @db.Uuid
  orderId                String       @db.Uuid
  buyerMemberId          String       @db.Uuid
  kind                   ReturnKind
  status                 ReturnStatus @default(REQUESTED)
  reason                 ReturnReason
  reasonText             String       @default("")
  // 접수할 때 판매자가 정한 사유 주체(구매자 사정이면 반품 배송비를 받는다)
  fault                  RefundFault?
  rejectReason           String?
  // 구매자가 돌려보낸 송장
  returnCourier          String?
  returnTrackingNumber   String?
  // 회수 완료 때 재고를 되돌렸는지
  restocked              Boolean      @default(false)
  // 교환 발송 송장
  exchangeCourier        String?
  exchangeTrackingNumber String?
  // 반품 환불 결과(환불한 금액)
  refundAmount           Int?
  // v2: 수거 방법, 검수 결과, 교환 재고 없음 처리(재입고 뒤 발송 보류·환불 전환), 무통장 주문 환불 계좌(환불·종료 뒤 비운다)
  pickupMethod           ReturnPickup @default(BUYER_SHIP)
  inspectionResult       ReturnInspection?
  inspectionNote         String?
  inspectedAt            DateTime?    @db.Timestamptz(3)
  exchangeHeldAt         DateTime?    @db.Timestamptz(3)
  convertedFromExchange  Boolean      @default(false)
  refundBankName         String?
  refundAccountHolder    String?
  refundAccountNumber    String?
  acceptedAt             DateTime?    @db.Timestamptz(3)
  receivedAt             DateTime?    @db.Timestamptz(3)
  completedAt            DateTime?    @db.Timestamptz(3)
  rejectedAt             DateTime?    @db.Timestamptz(3)
  cancelledAt            DateTime?    @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @default(now()) @db.Timestamptz(3)

  seller      Seller               @relation(fields: [sellerId], references: [id])
  order       Order                @relation(fields: [sellerId, orderId], references: [sellerId, id])
  buyerMember BuyerMember          @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])
  items       ReturnRequestItem[]
  images      ReturnRequestImage[]

  @@unique([sellerId, id])
  @@index([sellerId, status, createdAt])
  @@index([sellerId, orderId])
  @@index([sellerId, buyerMemberId, createdAt])
}

model ReturnRequestItem {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String @db.Uuid
  returnRequestId String @db.Uuid
  orderItemId     String @db.Uuid
  quantity        Int

  seller        Seller        @relation(fields: [sellerId], references: [id])
  returnRequest ReturnRequest @relation(fields: [sellerId, returnRequestId], references: [sellerId, id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [sellerId, orderItemId], references: [sellerId, id])

  @@unique([returnRequestId, orderItemId])
  @@index([sellerId, orderItemId])
}

// 신청 사진. 먼저 올리고(returnRequestId 없음) 신청할 때 붙인다. 붙지 않은 사진은 회원당 10장까지 두고 오래된 것부터 지운다.
model ReturnRequestImage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String   @db.Uuid
  buyerMemberId   String   @db.Uuid
  returnRequestId String?  @db.Uuid
  data            Bytes
  contentType     String
  byteSize        Int
  width           Int
  height          Int
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  seller        Seller         @relation(fields: [sellerId], references: [id])
  buyerMember   BuyerMember    @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)
  returnRequest ReturnRequest? @relation(fields: [sellerId, returnRequestId], references: [sellerId, id], onDelete: Cascade)

  @@unique([sellerId, id])
  @@index([sellerId, returnRequestId])
  @@index([sellerId, buyerMemberId, returnRequestId])
}

// 상품 진열(SA-016, 2026-10-04 대표님 지시). 값 범위·검사는 lib/server/shop-display/service.ts.
enum ShopDisplayKind {
  RECOMMENDED
  NEW
  CATEGORY
  // 확장(MASTER 배정 2026-10-05): 방송 상품 자동(지금 방송에서 주문된 상품), 베스트(결제 완료 판매량), 할인 중(이벤트 할인), 명예의 전당(HIT 카드가 나온 상품)
  LIVE
  BEST
  SALE
  HALL_OF_FAME
}

// 쇼핑몰별 진열 설정 1행: 구매자 상품 목록의 기본 정렬(new·recommended·popular·low·high)
model ShopDisplaySetting {
  sellerId    String   @id @db.Uuid
  listSort    String   @default("new")
  // 진열 옵션(구매자 목록·홈 진열 모두): 품절 맨 뒤로, 품절 숨기기, 방송 상품 앞으로(자동 정렬 목록만)
  soldOutLast Boolean  @default(false)
  hideSoldOut Boolean  @default(false)
  liveFirst   Boolean  @default(false)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// 홈 진열 영역(켜기·끄기·순서). 추천·신상품은 쇼핑몰마다 하나씩, 카테고리 영역은 카테고리를 가리킨다(카테고리를 지우면 함께 지움).
model ShopDisplaySection {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String          @db.Uuid
  kind       ShopDisplayKind
  categoryId String?         @db.Uuid
  title      String
  visible    Boolean         @default(true)
  itemCount  Int             @default(8)
  sortOrder  Int             @default(0)

  category ShopCategory? @relation(fields: [sellerId, categoryId], references: [sellerId, id], onDelete: Cascade)

  @@index([sellerId, sortOrder])
}

// 추천 상품(최대 20개, 순서대로). 상품을 지워도 행은 남고 구매자 화면에서는 빠진다.
model ShopDisplayItem {
  sellerId  String @db.Uuid
  productId String @db.Uuid
  sortOrder Int

  product Product @relation(fields: [sellerId, productId], references: [sellerId, id])

  @@id([sellerId, productId])
  @@index([sellerId, sortOrder])
}

// ───────────── 구매자 주문 결제(PG, 기반-결제. 대표님 결정 2026-10-05: 나이스페이 테스트(샌드박스) 결제) ─────────────
// 결제 시도 1건 = Payment 1행. id를 PG 주문번호(orderId)로 넘긴다(시도마다 고유).
// 같은 주문은 승인 중·결제 완료·취소된 결제가 하나만 있을 수 있다(마이그레이션의 부분 유니크 인덱스, 두 번 승인 금지).
enum PaymentStatus {
  READY
  APPROVING
  PAID
  FAILED
  CANCELLED
  PARTIAL_CANCELLED
}

enum PaymentCancelStatus {
  REQUESTED
  DONE
  FAILED
}

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String        @db.Uuid
  orderId         String        @db.Uuid
  provider        String
  method          PaymentMethod
  status          PaymentStatus @default(READY)
  // 결제 시작 때 서버가 다시 계산한 주문 금액. 승인·인증 결과의 금액이 이 값과 다르면 승인하지 않는다.
  amount          Int
  // 취소 완료(DONE)된 금액 합
  cancelledAmount Int           @default(0)
  // PG 거래 번호(인증 뒤 받음)
  pgTid           String?       @unique
  failureCode     String?
  // 승인 응답의 카드 요약(구매자 주문 상세 표시용): 카드사 이름, 끝 4자리(카드번호 전체는 저장하지 않음), 할부 개월(0 = 일시불)
  cardName        String?
  cardLast4       String?       @db.VarChar(4)
  cardInstallment Int?
  approvedAt      DateTime?     @db.Timestamptz(3)
  cancelledAt     DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  order   Order           @relation(fields: [sellerId, orderId], references: [sellerId, id])
  cancels PaymentCancel[]

  @@unique([sellerId, id])
  @@index([sellerId, orderId])
  @@index([status, updatedAt])
  // 마스터 파트너스 목록의 결제 연결 상태(MA-011): 마지막 성공·최근 실패를 쇼핑몰별 인덱스로 찾는다
  @@index([sellerId, approvedAt])
  @@index([sellerId, status, updatedAt])
}

// 결제 취소 요청(환불과 같은 트랜잭션에서 남기고, PG 호출은 커밋 뒤 processPaymentCancel이 한다). id를 PG 취소 주문번호로 넘긴다.
model PaymentCancel {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String              @db.Uuid
  paymentId      String              @db.Uuid
  amount         Int
  reason         String
  // 같은 사유로 두 번 취소하지 않게(예: refund:{orderId})
  idempotencyKey String
  status         PaymentCancelStatus @default(REQUESTED)
  pgCancelledTid String?
  failureCode    String?
  attempts       Int                 @default(0)
  lastTriedAt    DateTime?           @db.Timestamptz(3)
  doneAt         DateTime?           @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [sellerId, paymentId], references: [sellerId, id])

  @@unique([paymentId, idempotencyKey])
  @@index([status, lastTriedAt])
}

// 발송 충전 잔액(대표님 결정 2026-10-05, docs/terms/SELLER_MESSAGE_FEE_NOTICE.md, lib/server/messaging/balance.ts).
// 파트너스당 1행. 유료(직접 충전, 환불 대상)와 무상(이벤트·보상, 환불 안 함)을 나눠 두고 둘 다 음수가 될 수 없다.
model SellerMessageBalance {
  sellerId            String   @id @db.Uuid
  paidBalance         Int      @default(0)
  freeBalance         Int      @default(0)
  // 잔액(유료 + 무상)이 이 금액(원) 아래로 내려가면 알린다. 0이면 알리지 않는다.
  lowBalanceThreshold Int      @default(0)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

// 충전금 부족·충전 기능 꺼짐으로 건너뛴 일(파트너스 알림 센터 「충전금」 알림의 근거). 같은 판매자·채널·사유의 열린 행(resolvedAt 없음)은 1개로 합친다(부분 유니크 인덱스, 마이그레이션 SQL).
// 충전하거나 이후 같은 채널 차감이 성공하면 resolvedAt을 남겨 알림에서 사라진다. 금액·개인정보 없음.
enum MessageShortageReason {
  INSUFFICIENT_BALANCE
  CHARGING_DISABLED
}

model MessageShortage {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String                @db.Uuid
  channel      MessageChannel
  reason       MessageShortageReason
  // 건너뛴 횟수(같은 사건 키는 한 번만 센다)
  count        Int                   @default(1)
  firstAt      DateTime              @db.Timestamptz(3)
  lastAt       DateTime              @db.Timestamptz(3)
  lastEventKey String?
  resolvedAt   DateTime?             @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, resolvedAt, lastAt(sort: Desc)])
}

// 비용이 드는 발송·조회 채널(서식 1절)
enum MessageChannel {
  // 월 제공량을 넘은 거래 메일
  MAIL_TRANSACTIONAL
  // 광고·공지 대량 메일
  MAIL_BULK
  SMS
  LMS
  ALIMTALK
  // 구매자 휴대폰 본인인증(쇼핑몰에서 켠 경우)
  IDENTITY_VERIFICATION
  // 배송 자동 조회(배송 완료 자동 처리를 켠 경우)
  DELIVERY_TRACKING
  // 송장번호 발급 API(실제 건당 비용이 드는 경우)
  INVOICE_ISSUE
  // 송장 라벨 생성 API
  INVOICE_LABEL
  // 현금영수증 발급 API
  CASH_RECEIPT
  // 전자세금계산서 발급 API
  TAX_INVOICE
}

enum MessageLedgerType {
  // 유료 충전(+유료)
  CHARGE
  // 무상 지급(+무상)
  GRANT
  // 발송 차감(−). 보내기 전에 잡아 두고(PENDING) 성공하면 SUCCEEDED, 실패하면 되돌린다(REVERSED).
  DEBIT
  // 유료 잔액 환불(−유료)
  REFUND
}

enum MessageLedgerStatus {
  PENDING
  SUCCEEDED
  REVERSED
}

// 발송 충전 원장. paidAmount·freeAmount는 잔액 변화(차감은 음수). 같은 요청 키(idempotencyKey)는 되돌린 것을 빼고 한 건만(부분 유니크, 마이그레이션).
model SellerMessageLedger {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String              @db.Uuid
  type           MessageLedgerType
  status         MessageLedgerStatus
  channel        MessageChannel?
  quantity       Int                 @default(1)
  unitPrice      Int?
  paidAmount     Int
  freeAmount     Int
  idempotencyKey String
  reason         String?
  actorType      ActorType
  actorId        String?             @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?           @db.Timestamptz(3)

  seller         Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  mailDeliveries MailDelivery[]

  @@index([sellerId, createdAt])
}

// 발송 비용 안내 동의(서식 7절). 첫 충전 전에 받고, 서식 버전이 바뀌면 다시 받는다.
model SellerMessageFeeConsent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String   @db.Uuid
  version      String
  sellerUserId String   @db.Uuid
  consentedAt  DateTime @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, version])
}

// 채널별 단가(원, 기본 0원). 바꿀 때 적용 예정일을 두면 그때부터 새 단가(pending*). 최고관리자만(billing.price).
model MessageChannelPrice {
  channel            MessageChannel @id
  unitPrice          Int            @default(0)
  pendingUnitPrice   Int?
  pendingEffectiveAt DateTime?      @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @db.Timestamptz(3)
}

// 플랫폼 발송 설정(한 행, id = 1). 충전 기능 스위치(서식 값·법률 검토 전에는 꺼 둠)와 플랫폼 메일 무료 한도(메일 서비스 하루·월).
model PlatformMessageSetting {
  id                   Int      @id @default(1)
  chargingEnabled      Boolean  @default(false)
  platformDailyLimit   Int      @default(100)
  platformMonthlyLimit Int      @default(3000)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
}

enum MailDeliveryStatus {
  // 보내는 중(한도 계산에 넣는다)
  PENDING
  SENT
  // 보내지 못함(한도에서 빼고, 차감했으면 되돌린다)
  FAILED
  // 제공량을 넘었는데 충전 잔액이 모자라 보내지 않음(잔액 부족 미발송)
  SKIPPED_BALANCE
  // 플랫폼 전체 무료 한도에 걸려 보내지 않음
  SKIPPED_PLATFORM_LIMIT
}

// 메일 발송 기록(한 통에 한 행). 받는 사람 주소·내용은 남기지 않는다. sellerId가 없으면 플랫폼이 보낸 메일(플랫폼 한도에만 센다).
// month는 KST 달(YYYY-MM). charged는 제공량 밖이라 충전 잔액에서 차감한(또는 하려던) 통, ledgerId는 그 차감.
model MailDelivery {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String?            @db.Uuid
  kind              String
  bulk              Boolean            @default(false)
  refId             String?
  month             String
  status            MailDeliveryStatus
  charged           Boolean            @default(false)
  ledgerId          String?            @db.Uuid
  providerMessageId String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  finishedAt        DateTime?          @db.Timestamptz(3)

  seller Seller?              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  ledger SellerMessageLedger? @relation(fields: [ledgerId], references: [id])

  @@index([sellerId, month, status])
  @@index([createdAt, status])
}

// 유튜브 연동(YouTube Data API v3, API 키만·공개 방송 읽기만). 규칙·할당량은 lib/server/youtube/.
// 판매자 채널 연결(판매자당 1개). uploadsPlaylistId로 새 방송을 찾는다(search.list 100단위는 쓰지 않음).
model YoutubeChannelLink {
  sellerId          String    @id @db.Uuid
  channelId         String
  title             String
  uploadsPlaylistId String
  connectedAt       DateTime  @default(now()) @db.Timestamptz(3)
  // 마지막으로 새 방송을 찾아본 시각(자동 찾기 간격 계산)
  checkedAt         DateTime? @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

enum YoutubeLiveStatus {
  UPCOMING
  LIVE
  ENDED
  UNLINKED
}

// 판매자 방송 영상 연결. 진행 중 연결(UPCOMING·LIVE)은 판매자당 1개(마이그레이션 SQL 부분 유니크 인덱스).
// broadcastSessionId는 유튜브가 진행으로 바뀔 때 자동 시작했거나 이미 켜져 있던 방송.
model YoutubeLiveLink {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String            @db.Uuid
  videoId            String
  title              String
  status             YoutubeLiveStatus @default(UPCOMING)
  liveChatId         String?
  scheduledStartAt   DateTime?         @db.Timestamptz(3)
  actualStartAt      DateTime?         @db.Timestamptz(3)
  actualEndAt        DateTime?         @db.Timestamptz(3)
  broadcastSessionId String?           @db.Uuid
  // 이 연결이 방송을 자동으로 시작했는지(수동으로 켜 둔 방송에 붙었으면 false)
  autoStarted        Boolean           @default(false)
  checkedAt          DateTime?         @db.Timestamptz(3)
  // 채팅 수집(기본 꺼짐, 파트너스가 방송마다 켠다). 다음 조회 시각·간격·페이지 토큰은 sync.ts가 관리한다.
  chatEnabled        Boolean           @default(false)
  chatPageToken      String?
  chatNextPollAt     DateTime?         @db.Timestamptz(3)
  chatIntervalMs     Int?
  // 마지막으로 채팅을 받아 온 시각, 수집이 멈춘 이유(chat_ended·chat_disabled·chat_not_found·chat_forbidden·youtube_error). chat.ts chatStatus 참고.
  chatLastPolledAt   DateTime?         @db.Timestamptz(3)
  chatStopReason     String?
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  seller       Seller               @relation(fields: [sellerId], references: [id])
  broadcast    BroadcastSession?    @relation(fields: [sellerId, broadcastSessionId], references: [sellerId, id])
  chatMessages YoutubeChatMessage[]
  audienceEvents AudienceEvent[]

  @@unique([sellerId, id])
  @@index([status])
  @@index([sellerId, createdAt])
}

// 수집한 유튜브 채팅(주문 닉네임 확인용). 표시 이름·본문 앞 200자만, 30일 지나면 지운다(lib/server/youtube/chat.ts).
// 같은 메시지는 판매자마다 유튜브 메시지 id로 한 번만 저장한다(같은 방송을 두 판매자가 연결해도 각자 저장).
model YoutubeChatMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String   @db.Uuid
  liveLinkId      String   @db.Uuid
  messageId       String
  authorChannelId String
  authorName      String
  text            String
  publishedAt     DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  liveLink YoutubeLiveLink? @relation(fields: [sellerId, liveLinkId], references: [sellerId, id], onDelete: Restrict)

  @@unique([sellerId, messageId])
  @@index([sellerId, liveLinkId, publishedAt])
  @@index([createdAt])
}

// 방송 시청자 이벤트. 회원·주문·경품 원장을 만들지 않는다. 키워드는 이벤트 설정이며 원본 채팅은 추가 보관하지 않는다.
enum AudienceEventKind {
  ROULETTE_ITEM
  ROULETTE_PARTICIPANT
  LADDER
  RANDOM_DRAW
}

enum AudienceEventStatus {
  OPEN
  FROZEN
  COMPLETED
  CANCELED
}

model AudienceEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String @db.Uuid
  broadcastSessionId String @db.Uuid
  liveLinkId String? @db.Uuid
  liveChatId String?
  kind AudienceEventKind
  entryMethods AudienceEventEntrySource[] @default([YOUTUBE_CHAT])
  status AudienceEventStatus @default(OPEN)
  title String
  keyword String?
  rules Json @default("{}")
  winnerCount Int
  testMode Boolean
  requestKey String @db.Uuid
  requestHash String
  noticeAcknowledgedAt DateTime @db.Timestamptz(3)
  openedAt DateTime @default(now()) @db.Timestamptz(3)
  closesAt DateTime @db.Timestamptz(3)
  frozenAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  rejectedIdentityCount Int @default(0)
  lastEntryRejection String?

  seller Seller @relation(fields: [sellerId], references: [id])
  broadcast BroadcastSession @relation(fields: [sellerId, broadcastSessionId], references: [sellerId, id])
  liveLink YoutubeLiveLink? @relation(fields: [sellerId, liveLinkId], references: [sellerId, id], onDelete: Restrict)
  entrants AudienceEventEntrant[]
  entryRejections AudienceEventEntryRejection[]
  entryBatches AudienceEventEntryBatch[]
  guestSessions AudienceEventGuestSession[]
  rounds AudienceEventRound[]

  @@unique([sellerId, id])
  @@unique([sellerId, requestKey])
  @@index([sellerId, broadcastSessionId, openedAt])
  @@index([sellerId, liveLinkId, status])
}

enum AudienceEventEntrySource {
  YOUTUBE_CHAT
  DIRECT_INPUT
  PASTE
  MOBILE
}

model AudienceEventEntrant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String @db.Uuid
  eventId String @db.Uuid
  source AudienceEventEntrySource @default(YOUTUBE_CHAT)
  authorChannelId String?
  messageId String?
  buyerMemberId String? @db.Uuid
  guestSessionId String? @db.Uuid
  batchId String? @db.Uuid
  rowNumber Int?
  requestKey String? @db.Uuid
  requestHash String?
  displayName String
  entryRulesVersion String?
  rulesAcknowledgedAt DateTime? @db.Timestamptz(3)
  anonymizedAt DateTime? @db.Timestamptz(3)
  publishedAt DateTime @db.Timestamptz(3)
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)

  event AudienceEvent @relation(fields: [sellerId, eventId], references: [sellerId, id])
  member BuyerMember? @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Restrict)
  guestSession AudienceEventGuestSession? @relation(fields: [sellerId, eventId, guestSessionId], references: [sellerId, eventId, id], onDelete: Restrict)
  batch AudienceEventEntryBatch? @relation(fields: [sellerId, eventId, batchId], references: [sellerId, eventId, id], onDelete: Restrict)

  @@unique([sellerId, eventId, authorChannelId])
  @@unique([sellerId, eventId, messageId])
  @@unique([sellerId, eventId, buyerMemberId])
  @@unique([sellerId, eventId, guestSessionId])
  @@unique([sellerId, eventId, requestKey])
  @@unique([batchId, rowNumber])
  @@index([sellerId, eventId, publishedAt, id])
}

// 직접입력/붙여넣기 요청의 최소 멱등 영수증. 명단/회원/경품 원장을 복제하지 않는다.
model AudienceEventEntryBatch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String @db.Uuid
  eventId String @db.Uuid
  requestKey String @db.Uuid
  requestHash String?
  method AudienceEventEntrySource
  inputCount Int
  acceptedCount Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  event AudienceEvent @relation(fields: [sellerId, eventId], references: [sellerId, id])
  entrants AudienceEventEntrant[]
  @@unique([sellerId, eventId, requestKey])
  @@unique([sellerId, eventId, id])
}

// 이벤트 안에서만 사용하는 게스트 세션. 토큰 원문·IP·브라우저 정보는 저장하지 않는다.
model AudienceEventGuestSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String @db.Uuid
  eventId String @db.Uuid
  tokenHash String? @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  event AudienceEvent @relation(fields: [sellerId, eventId], references: [sellerId, id])
  entrants AudienceEventEntrant[]
  @@unique([sellerId, eventId, id])
  @@index([sellerId, eventId, createdAt])
}

// 이벤트당 여러 불변 회차. 결과 재표시는 저장된 회차를 사용하고 재추첨은 원회차/사유를 가진 새 회차다.
model AudienceEventRound {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String @db.Uuid
  eventId String @db.Uuid
  roundNumber Int @default(1)
  requestKey String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestHash String @default("")
  sourceRoundId String? @db.Uuid
  reason String?
  actorType ActorType @default(SYSTEM)
  actorId String?
  rulesSnapshot Json
  entrantIds Json
  frozenAt DateTime @default(now()) @db.Timestamptz(3)

  event AudienceEvent @relation(fields: [sellerId, eventId], references: [sellerId, id])
  result AudienceEventResult?
  publications AudienceEventPublication[]
  sourceRound AudienceEventRound? @relation("AudienceRoundSource", fields: [sellerId, eventId, sourceRoundId], references: [sellerId, eventId, id], onDelete: Restrict)
  derivedRounds AudienceEventRound[] @relation("AudienceRoundSource")

  @@unique([sellerId, eventId, roundNumber])
  @@unique([sellerId, eventId, requestKey])
  @@unique([sellerId, eventId, id])
  @@unique([sellerId, id])
}

// 참가자를 식별할 수 없는 메시지의 최소 진단. 표시 이름/원문 없이 message id만 남겨 재시도 집계를 멱등 처리한다.
model AudienceEventEntryRejection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String @db.Uuid
  eventId String @db.Uuid
  messageId String
  reason String

  event AudienceEvent @relation(fields: [sellerId, eventId], references: [sellerId, id])

  @@unique([sellerId, eventId, messageId])
}

model AudienceEventResult {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String @db.Uuid
  roundId String @db.Uuid
  algorithmVersion String
  winnerEntrantIds Json
  testMode Boolean
  execution Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  round AudienceEventRound @relation(fields: [sellerId, roundId], references: [sellerId, id])

  @@unique([sellerId, roundId])
}

enum AudienceEventPublicationScope {
  ALL
  PARTICIPANT
}

// 불변 결과와 별개인 공개 이력. 재표시는 이 이력만 추가하며 RNG/경품 지급을 실행하지 않는다.
model AudienceEventPublication {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId String @db.Uuid
  roundId String @db.Uuid
  requestKey String @db.Uuid
  scope AudienceEventPublicationScope
  participantId String? @db.Uuid
  actorType ActorType
  actorId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  round AudienceEventRound @relation(fields: [sellerId, roundId], references: [sellerId, id])

  @@unique([sellerId, requestKey])
  @@index([sellerId, roundId])
}

// 하루 할당량 사용(태평양 시각 날짜 기준, 구글 할당량 초기화와 같음). scope는 "all"(전체 합) 또는 판매자 id.
model YoutubeQuotaUsage {
  day   String
  scope String
  units Int    @default(0)

  @@id([day, scope])
}

enum MessageChargeStatus {
  // 결제 요청 전·응답 기다림(응답이 끊기면 대조로 확정)
  PENDING
  PAID
  FAILED
}

// 발송 충전 결제(구독 카드 빌링키로 결제, 테스트 모드 공급자만, lib/server/messaging/charge.ts). id를 PG 주문 번호로 넘긴다.
// 결제가 확정되면 같은 트랜잭션에서 유료 잔액을 늘리고 원장 CHARGE(키 charge:{id})를 남긴다.
model MessageCharge {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String              @db.Uuid
  sellerUserId      String              @db.Uuid
  amount            Int
  status            MessageChargeStatus @default(PENDING)
  // 같은 충전 요청을 두 번 보내도 한 번만 결제
  idempotencyKey    String
  // 충전 때 동의한 안내 서식 버전
  noticeVersion     String
  providerPaymentId String?
  receiptUrl        String?
  failureReason     String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  finishedAt        DateTime?           @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, idempotencyKey])
  @@index([status, createdAt])
}

// 무통장 입금 계좌(판매자당 1행, 기반-결제 2단계). 구매자가 무통장 입금을 고르면 이 계좌를 안내한다.
// 계좌번호는 구매자에게 보여 주는 값이라 암호화하지 않지만, 로그 추적에는 끝 4자리만 남긴다.
model SellerBankAccount {
  sellerId      String   @id @db.Uuid
  bankName      String
  accountNumber String
  accountHolder String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 오버레이 레이아웃(SA-051 편집기, OV-001·002, lib/server/overlay/layout.ts). 판매자·화면 비율(9x16·16x9)마다 1행.
// widgets는 서버가 허용 목록으로 검사한 위젯 배열(위치·크기는 화면 대비 %). version은 저장할 때마다 1씩 올리고, 저장 요청의
// expectedVersion과 다르면 거절한다(두 창에서 고칠 때 덮어쓰기 방지). 없으면 기본 템플릿(queue_focus)으로 본다.
model OverlayLayout {
  sellerId    String   @db.Uuid
  aspect      String
  templateKey String
  widgets     Json
  version     Int      @default(1)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([sellerId, aspect])
}

// 「내 템플릿으로 저장」(판매자당 최대 20개). 기본 템플릿 3종은 코드에 있다(layout.ts BUILTIN_TEMPLATES).
model OverlayTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String   @db.Uuid
  name      String
  aspect    String
  widgets   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
}

// ───────────── 플랫폼 공지(MA-053·054 작성 · SA-111·112 파트너스 · PF-005·006 공개) ─────────────

enum PlatformNoticeCategory {
  MAINTENANCE
  POLICY
  FEATURE
  GENERAL
}

// 보는 곳: 파트너스 관리자만 · 공개 공지만 · 둘 다
enum PlatformNoticeAudience {
  PARTNERS
  PUBLIC
  ALL
}

// 마스터 관리자가 쓰는 플랫폼 공지. publishedAt이 null이면 임시 저장(어디에도 안 보임). 지우면 deletedAt(목록·조회에서 빠짐).
// 작성·수정 관리자는 id만 남긴다(로그 추적에 전후가 남음). version은 다른 창 덮어쓰기 막기.
model PlatformNotice {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  body             String
  category         PlatformNoticeCategory
  audience         PlatformNoticeAudience
  isPinned         Boolean                @default(false)
  publishedAt      DateTime?              @db.Timestamptz(3)
  version          Int                    @default(0)
  createdByAdminId String                 @db.Uuid
  updatedByAdminId String                 @db.Uuid
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime?              @db.Timestamptz(3)

  reads PlatformNoticeRead[]
  files PlatformNoticeFile[]

  @@index([publishedAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// 공지 첨부 파일(MA-053·054, 마스터 관리자 중 공지 작성 권한자가 올리고 파트너스는 받기만). .png·.jpg·.pdf, 파일당 5MB·공지당 5개, DB 저장.
// 공지를 지우면(하드 삭제) 같이 지우고, 지운(deletedAt) 공지의 파일은 받을 수 없다. 올리고 지워도 공지 version은 올리지 않는다.
model PlatformNoticeFile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noticeId         String   @db.Uuid
  name             String
  data             Bytes
  contentType      String
  byteSize         Int
  sortOrder        Int      @default(0)
  createdByAdminId String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  notice PlatformNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId, sortOrder, createdAt])
}

// 파트너스 계정(직원 포함)별 공지 읽음 표시(SA-111·112). 상세를 열었을 때 화면이 읽음 API를 부르면 한 줄이 생긴다(같은 계정·공지는 한 번만).
// 계정(sellerUserId)은 지워도 기록이 남지 않게 정리하지 않고 두며, 공지를 지우면(하드 삭제) 같이 지운다.
model PlatformNoticeRead {
  sellerUserId String   @db.Uuid
  noticeId     String   @db.Uuid
  readAt       DateTime @default(now()) @db.Timestamptz(3)

  notice PlatformNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@id([sellerUserId, noticeId])
  @@index([noticeId])
}

// 파트너스 유튜브 설정(SA-057). 행이 없으면 기본값. 채팅 수집 기본값은 새로 연결하는 방송에 적용한다(기본 꺼짐).
// 판매자는 지우지 않으므로 할당량 표처럼 sellerId만 둔다(Seller 블록은 고치지 않음, 조회·변경은 항상 ctx.sellerId 조건).
model YoutubeSellerSetting {
  sellerId           String   @id @db.Uuid
  chatDefaultEnabled Boolean  @default(false)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

// 파트너스별 월 채팅 수집 건수(KST 달, "YYYY-MM"). 채팅을 지워도(30일 정리·지금 삭제) 이번 달 수집 현황이 남도록 따로 센다.
model YoutubeChatMonthly {
  sellerId String @db.Uuid
  month    String
  messages Int    @default(0)

  @@id([sellerId, month])
}

// ───────────── 구독 환불 요청·처리(MA-026·027) ─────────────

// SYSTEM: 해지 뒤 확정된 결제 등 시스템이 환불 대상으로 남긴 것. ADMIN: 마스터 관리자가 직접 만든 요청(법이 요구하는 환불 등)
enum SubscriptionRefundSource {
  SYSTEM
  ADMIN
}

// 요청 → (승인하면) 처리 중 → 환불됨 / 실패(다시 승인할 수 있음). 반려하면 끝.
enum SubscriptionRefundStatus {
  REQUESTED
  PROCESSING
  REFUNDED
  FAILED
  REJECTED
}

// 구독 결제 환불. 결제당 진행 중이거나 끝난 환불(REQUESTED·PROCESSING·REFUNDED)은 하나만(마이그레이션 SQL 부분 유니크).
// 결제 공급자 취소는 환불 id를 멱등키로 보낸다(같은 환불을 다시 승인해도 한 번만 취소). 지금 공급자는 시험용 가짜뿐이라 실제 돈은 오가지 않는다.
model SubscriptionRefund {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String                   @db.Uuid
  paymentId          String                   @db.Uuid
  amount             Int
  source             SubscriptionRefundSource
  // 사유 코드(시스템: paid_after_cancel) 또는 마스터 관리자가 적은 사유
  reason             String
  status             SubscriptionRefundStatus @default(REQUESTED)
  requestedByAdminId String?                  @db.Uuid
  decidedByAdminId   String?                  @db.Uuid
  decisionNote       String?
  providerRefundId   String?
  failureReason      String?
  version            Int                      @default(0)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  decidedAt          DateTime?                @db.Timestamptz(3)
  refundedAt         DateTime?                @db.Timestamptz(3)

  seller  Seller              @relation(fields: [sellerId], references: [id])
  payment SubscriptionPayment @relation(fields: [paymentId], references: [id])

  @@index([status, createdAt])
  @@index([sellerId, createdAt])
}

// 환불 1건(부분 환불 포함, queue/service.ts refundOrder). 한 주문에 여러 번 생길 수 있고 seq는 주문 안 순번(1부터).
// 마지막 환불(isFinal)에서 주문이 환불(REFUNDED)로 바뀐다. 금액은 이 환불분만(주문 합계는 Order.refundAmount 등).
model OrderRefund {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String       @db.Uuid
  orderId           String       @db.Uuid
  seq               Int
  fault             RefundFault?
  reason            String
  // [{ orderItemId, quantity, amount }]: 이번에 돌려받는 품목·수량과 품목 금액(쿠폰 배분 뺀 값, 구매자 사정 개봉 품목은 0)
  items             Json
  itemsAmount       Int
  shippingRefunded  Int
  refundAmount      Int
  returnFeeDeducted Int
  rewardReturn      Int
  // 주문 적립 회수액과 방식(ledger: 회수 원장, manual: 수동 확인, pending: 아직 기록 전 적립 예정액에서 뺌)
  rewardRevoke      Int
  rewardRevokeKind  String?
  isFinal           Boolean
  actorType         ActorType
  actorId           String?      @db.Uuid
  createdAt         DateTime     @db.Timestamptz(3)

  order Order @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([sellerId, id])
  @@unique([orderId, seq])
  @@index([sellerId, orderId])
}

// ───────────── 회원 등급 자동 재산정(member-grades, SA-044) ─────────────

enum MemberGradeChangeReason {
  AUTO_UP
  AUTO_DOWN
  MANUAL
  // 등급을 지워 기본 등급으로 옮김
  GRADE_REMOVED
}

// 재산정 주기와 강등 방식(SA-044 산정 기준)
enum MemberGradeCadence {
  MONTHLY
  WEEKLY
  DAILY
}

enum MemberGradeDemotion {
  STEP
  IMMEDIATE
  NONE
}

// 쇼핑몰별 설정(없으면 꺼짐): 켜면 매월 1일(KST)에 최근 6개월 결제 금액으로 회원 등급을 다시 정한다.
model MemberGradePolicy {
  sellerId     String              @id @db.Uuid
  autoEnabled  Boolean             @default(false)
  // 기준 금액을 세는 기간(개월). 0이면 누적. 0·3·6·12만.
  windowMonths Int                 @default(6)
  cadence      MemberGradeCadence  @default(MONTHLY)
  demotion     MemberGradeDemotion @default(STEP)
  updatedAt    DateTime            @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 파트너스가 직접 정해 「고정」한 회원: 자동 재산정에서 건너뛴다.
model MemberGradeOverride {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @db.Uuid
  buyerMemberId String    @unique @db.Uuid
  staffId       String?   @db.Uuid
  // 고정이 끝나는 시각(없으면 직접 풀 때까지)과 사유
  until         DateTime? @db.Timestamptz(3)
  reason        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)

  @@index([sellerId])
}

// 등급 변경 기록. 등급 이름은 변경 당시 값을 남긴다(등급을 지우거나 이름을 바꿔도 기록은 그대로).
model MemberGradeHistory {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String                  @db.Uuid
  buyerMemberId String                  @db.Uuid
  fromName      String
  toName        String
  reason        MemberGradeChangeReason
  // 자동 재산정이면 기준이 된 최근 6개월 결제 금액
  amount        Int?
  staffId       String?                 @db.Uuid
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([sellerId, buyerMemberId])
}

// 월 1회 재산정 실행 기록(쇼핑몰 × 월). 같은 달에 두 번 돌지 않게 한다.
model MemberGradeRun {
  sellerId String   @db.Uuid
  monthKey String
  promoted Int      @default(0)
  demoted  Int      @default(0)
  ranAt    DateTime @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@id([sellerId, monthKey])
}

// 구매자 환불 요청(SA-023 · SH-022, MASTER 배정 2026-10-05, lib/server/payments/refundRequest.ts). 결제 완료·발송 전 주문에 구매자가 요청하고,
// 파트너스가 승인(= 부분 환불 포함 환불, OrderRefund와 이어짐)하거나 사유를 적어 거절한다. 주문당 진행 중(REQUESTED) 요청은 1건(마이그레이션 SQL 부분 유니크).
enum RefundRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

model RefundRequest {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String              @db.Uuid
  orderId       String              @db.Uuid
  buyerMemberId String              @db.Uuid
  status        RefundRequestStatus @default(REQUESTED)
  reason        ReturnReason
  reasonText    String              @default("")
  // [{ orderItemId, quantity }]: 환불을 바라는 품목·수량. null이면 남은 품목 전부
  items         Json?
  rejectReason  String?
  // 승인한 환불(OrderRefund.id). 파트너스가 주문 화면에서 남은 품목을 모두 환불해도 이어서 승인으로 닫는다
  refundId      String?             @db.Uuid
  decidedAt     DateTime?           @db.Timestamptz(3)
  cancelledAt   DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  order       Order       @relation(fields: [sellerId, orderId], references: [sellerId, id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@unique([sellerId, id])
  @@index([sellerId, status, createdAt])
  @@index([sellerId, orderId])
  @@index([sellerId, buyerMemberId, createdAt])
}

// 현금영수증·세금계산서 신청과 발행 이력(SA-024 · SH-005·SH-022, MASTER 배정 2026-10-05, lib/server/receipts/service.ts).
// 무통장·계좌이체 주문에 구매자가 신청하고, 파트너스(RECEIPT_TAX)가 상태를 본다. 외부 발급 연동은 아직 없어 발행은 PENDING으로 남는다(발행 업체 결정 전).
// 주문당 진행 중(철회하지 않은) 신청은 1건(마이그레이션 SQL 부분 유니크).
enum ReceiptKind {
  CASH_RECEIPT_INCOME
  CASH_RECEIPT_EXPENSE
  TAX_INVOICE
}

enum ReceiptIssueStatus {
  PENDING
  // 충전금 잔액이 모자라 발급을 미룸(주문은 그대로, 충전하거나 파트너스가 다시 시도하면 대기로)
  ON_HOLD
  ISSUED
  FAILED
  CANCELLED
}

model OrderReceiptRequest {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String      @db.Uuid
  orderId       String      @db.Uuid
  buyerMemberId String      @db.Uuid
  kind          ReceiptKind
  // 휴대폰·사업자등록번호(숫자). 원문은 저장하지 않고 AES-256-GCM으로 봉인해 두며(판매자 id를 AAD로 묶음), 화면에는 뒤 4자리만 보인다.
  identitySealed String
  identityLast4  String
  // 세금계산서: { companyName, representative, email }. 사업자등록번호는 identity를 쓴다.
  taxInfo        Json?
  withdrawnAt    DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  order       Order          @relation(fields: [sellerId, orderId], references: [sellerId, id])
  buyerMember BuyerMember    @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])
  issues      ReceiptIssue[]

  @@unique([sellerId, id])
  @@index([sellerId, createdAt])
  @@index([sellerId, orderId])
}

model ReceiptIssue {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String             @db.Uuid
  requestId  String             @db.Uuid
  status     ReceiptIssueStatus @default(PENDING)
  amount     Int
  // 외부 발급 건당비를 파트너스 「발송·이용 충전금」에서 차감하는 발급인지(docs/COST_POLICY.md). 차감 연동은 발행 업체 결정 뒤.
  chargeable Boolean            @default(true)
  attempts   Int                @default(0)
  failureCode String?
  // 발행 업체가 준 문서 번호(연동 뒤)
  providerKey String?
  issuedAt    DateTime?         @db.Timestamptz(3)
  cancelledAt DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  request OrderReceiptRequest @relation(fields: [sellerId, requestId], references: [sellerId, id])

  @@index([sellerId, status, createdAt])
  @@index([sellerId, requestId])
}

// 현금영수증·전자세금계산서를 파트너스(판매자) 명의로 발행할 때 쓰는 발행자 정보(SA-024, 대표님 결정 2026-10-05 「영수증은 파트너스 이름으로 발행」).
// 인증서는 발행 업체 쪽에 등록하며 여기에는 등록 상태만 둔다(업체 연동 전에는 NOT_REGISTERED).
enum ReceiptCertStatus {
  NOT_REGISTERED
  REGISTERED
  EXPIRED
}

model SellerReceiptIssuer {
  sellerId        String            @id @db.Uuid
  businessNumber  String
  companyName     String
  representative  String
  certStatus      ReceiptCertStatus @default(NOT_REGISTERED)
  certCheckedAt   DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 영수증·세금계산서 발행 방식(SA-024 「발행 방식」). DIRECT = 홈택스 등에서 직접 발행하고 목록에서 「발행 완료 처리」(기본).
// AUTO = 자동 발행(발행 업체 연동 후, 지금은 준비 중이라 저장할 수 없다). 행이 없으면 DIRECT.
enum ReceiptIssueMode {
  DIRECT
  AUTO
}

model SellerReceiptSetting {
  sellerId  String           @id @db.Uuid
  issueMode ReceiptIssueMode @default(DIRECT)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// ───────────── 플랫폼 문의(파트너스 → 플랫폼, SA-113·114·115 · 마스터 MA-051·052) ─────────────

enum PlatformInquiryCategory {
  BILLING
  ACCOUNT
  FEATURE
  BUG
  OTHER
  BROADCAST
  PAYMENT_LINK
  ORDER_REFUND
  REWARD
  SUBSCRIPTION_FEE
  SHOP
}

// 답변 대기 → (마스터 답변) 답변 완료 → (파트너스 추가 문의) 답변 대기 … 마스터가 종료하면 끝(추가 문의 불가, 새 문의로).
enum PlatformInquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum PlatformInquiryAuthor {
  SELLER_USER
  ADMIN
}

// 파트너스가 플랫폼에 보낸 문의. 대화는 PlatformInquiryMessage(첫 글 포함). version은 글이 달리거나 상태가 바뀔 때마다 오른다
// (마스터 답변·종료는 expectedVersion을 받아, 보지 못한 추가 문의가 있으면 409).
// sellerReadAt: 쓴 사람(파트너스)이 상세를 마지막으로 연 시각. 그 뒤 달린 마스터 답변이 있으면 「새 답변」.
model PlatformInquiry {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId              String                  @db.Uuid
  createdBySellerUserId String                  @db.Uuid
  category              PlatformInquiryCategory
  title                 String
  status                PlatformInquiryStatus   @default(OPEN)
  // 공지 상세 「관련 문의하기」로 들어오면 그 공지
  noticeId              String?                 @db.Uuid
  lastMessageAt         DateTime                @default(now()) @db.Timestamptz(3)
  lastAdminMessageAt    DateTime?               @db.Timestamptz(3)
  sellerReadAt          DateTime?               @db.Timestamptz(3)
  closedAt              DateTime?               @db.Timestamptz(3)
  closedByAdminId       String?                 @db.Uuid
  // 파트너스가 「해결됐습니다 · 종료」로 닫은 계정(마스터가 닫으면 closedByAdminId)
  closedBySellerUserId  String?                 @db.Uuid
  // 문의 작성 때 고른 관련 주문·방송(같은 쇼핑몰만, 선택). 지워지는 일이 없는 기록이라 관계 없이 id만 둔다.
  relatedOrderId        String?                 @db.Uuid
  relatedBroadcastId    String?                 @db.Uuid
  // 「답변이 도움이 됐습니까?」 평가(true 도움됨 · false 아니요). 문의 전체에 한 번만, 마스터 답변이 있은 뒤.
  helpful               Boolean?
  helpfulAt             DateTime?               @db.Timestamptz(3)
  // 방송 중 장애 등 급한 문의 표시(분류가 아니라 별도 표시)
  urgent                Boolean                 @default(false)
  // 마스터 관리자 담당(운영·CS·최고관리자 중 한 명, 없으면 미배정). 이름은 마스터 화면에만 나간다. 바꿔도 version은 올리지 않는다(작성 중인 답변을 막지 않기 위해).
  assignedAdminId       String?                 @db.Uuid
  assignedAt            DateTime?               @db.Timestamptz(3)
  // 보낼 때 모은 진단 정보(브라우저·OS·최근 방송·오버레이 마지막 접속·앱 버전, lib/server/platform-inquiries/diagnostics.ts). 마스터 화면에만 보인다. 보내지 않기로 했거나 옛 문의는 null.
  diagnostics           Json?
  version               Int                     @default(0)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)

  seller   Seller                   @relation(fields: [sellerId], references: [id])
  messages PlatformInquiryMessage[]

  @@unique([sellerId, id])
  @@index([sellerId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([status, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([assignedAdminId, lastMessageAt(sort: Desc), id(sort: Desc)])
}

// 문의 대화 한 줄. 지우거나 고치지 않는다.
model PlatformInquiryMessage {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String                @db.Uuid
  inquiryId    String                @db.Uuid
  authorType   PlatformInquiryAuthor
  sellerUserId String?               @db.Uuid
  adminId      String?               @db.Uuid
  body         String
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)

  seller  Seller                 @relation(fields: [sellerId], references: [id])
  inquiry PlatformInquiry        @relation(fields: [sellerId, inquiryId], references: [sellerId, id], onDelete: Cascade)
  images  PlatformInquiryImage[]
  files   PlatformInquiryFile[]

  @@unique([sellerId, id])
  @@index([sellerId, inquiryId, createdAt])
}

// 문의 첨부 사진(파트너스만 올림). 먼저 올리고(messageId 없음) 글을 보낼 때 붙인다. 붙지 않은 사진은 계정당 10장까지 두고 오래된 것부터 지운다.
model PlatformInquiryImage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String   @db.Uuid
  sellerUserId String   @db.Uuid
  messageId    String?  @db.Uuid
  data         Bytes
  contentType  String
  byteSize     Int
  width        Int
  height       Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  seller  Seller                  @relation(fields: [sellerId], references: [id])
  message PlatformInquiryMessage? @relation(fields: [sellerId, messageId], references: [sellerId, id], onDelete: Cascade)

  @@index([sellerId, messageId])
  @@index([sellerId, sellerUserId, messageId, createdAt])
}

// 문의 첨부 파일(사진 외 .txt·.log·.zip, 파트너스만 올림, lib/server/platform-inquiries/files.ts). 사진과 같이 먼저 올리고(messageId 없음) 글을 보낼 때 붙인다. 붙지 않은 파일은 계정당 10개까지 두고 오래된 것부터 지운다.
model PlatformInquiryFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String   @db.Uuid
  sellerUserId String   @db.Uuid
  messageId    String?  @db.Uuid
  name         String
  data         Bytes
  contentType  String
  byteSize     Int
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  seller  Seller                  @relation(fields: [sellerId], references: [id])
  message PlatformInquiryMessage? @relation(fields: [sellerId, messageId], references: [sellerId, id], onDelete: Cascade)

  @@index([sellerId, messageId])
  @@index([sellerId, sellerUserId, messageId, createdAt])
}

// 문의 작성 임시 저장(SA-114 「임시 저장」). 계정(파트너스 직원 포함)당 하나. 보내도 자동으로 지우지 않고 화면이 보낸 뒤 지운다. 값은 임시라 검사가 느슨하고(보낼 때 다시 검사), 관련 주문·방송 id는 보낼 때 같은 쇼핑몰 것인지 확인한다.
model PlatformInquiryDraft {
  sellerUserId       String   @id @db.Uuid
  sellerId           String   @db.Uuid
  category           PlatformInquiryCategory?
  title              String   @default("")
  body               String   @default("")
  urgent             Boolean  @default(false)
  relatedOrderId     String?  @db.Uuid
  relatedBroadcastId String?  @db.Uuid
  includeDiagnostics Boolean  @default(true)
  updatedAt          DateTime @default(now()) @db.Timestamptz(3)

  @@index([sellerId])
}

// ───────────── 점검 모드(MA-083 · AU-010) ─────────────

// 플랫폼 점검 상태. 한 줄만 둔다(id = 1, 마이그레이션 CHECK). 켜져 있고 시작 시각이 지났으면(없으면 바로) 점검 중.
// 종료 예정 시각은 안내용이다(지나도 저절로 끄지 않음). version은 다른 창 덮어쓰기 막기.
model PlatformMaintenance {
  id               Int       @id @default(1)
  enabled          Boolean   @default(false)
  message          String    @default("")
  startsAt         DateTime? @db.Timestamptz(3)
  endsAt           DateTime? @db.Timestamptz(3)
  version          Int       @default(0)
  updatedByAdminId String?   @db.Uuid
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
}

// ───────────── 파트너스 도우미(SA-140 · MA-055 · MA-084, Gemini) ─────────────
// 설정은 한 행(id=1). 행이 없으면 꺼짐. 모델 이름·단가는 마스터 관리자가 공식 문서를 보고 넣는다(코드에 고정하지 않음).
// 비용 단위는 1/1000원(milliWon). 단가는 100만 토큰당 원(= 토큰당 마이크로원)이라 비용(milliWon) = 토큰 × 단가 ÷ 1000(올림).
model AssistantSetting {
  id               Int      @id @default(1)
  enabled          Boolean  @default(false)
  model            String   @default("")
  inputWonPerMTok  Int      @default(0)
  outputWonPerMTok Int      @default(0)
  monthlyBudgetWon Int      @default(10000)
  sellerDailyLimit Int      @default(20)
  version          Int      @default(0)
  updatedByAdminId String?  @db.Uuid
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// 답변 근거 문서(MA-055). 게시한 문서만 답변 근거로 쓴다. 공개 자료만 넣는다(파트너스 개인정보·주문 데이터 금지).
model AssistantDoc {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  body             String
  published        Boolean   @default(false)
  version          Int       @default(0)
  createdByAdminId String    @db.Uuid
  updatedByAdminId String    @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt        DateTime? @db.Timestamptz(3)

  @@index([published, deletedAt])
}

// 월별 플랫폼 전체 사용액(KST 월 "2026-10"). 호출 전에 예상 비용을 먼저 얹고(한도 안일 때만), 끝나면 실제 비용으로 바로잡는다.
model AssistantMonthUsage {
  month        String @id
  usedMilliWon Int    @default(0)
}

// 파트너스별 하루(KST) 호출 수
model AssistantSellerDay {
  sellerId String @db.Uuid
  day      String
  count    Int    @default(0)

  @@id([sellerId, day])
}

enum AssistantCallStatus {
  OK
  NO_ANSWER
  ERROR
}

// 호출 원장 + 질문 기록. 호출마다 토큰·예상 비용을 남긴다.
model AssistantLedger {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String              @db.Uuid
  sellerUserId String              @db.Uuid
  month        String
  model        String
  inputTokens  Int                 @default(0)
  outputTokens Int                 @default(0)
  costMilliWon Int                 @default(0)
  status       AssistantCallStatus
  question     String
  answer       String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([month])
}

// ───── 외부 쇼핑몰 연동(SA-005·006, 오버레이 전용 판매자) ─────
// 연결 상태: CONNECTED 연결됨 · REAUTH_REQUIRED 다시 연결 필요(토큰 만료·회수) · DISCONNECT_PENDING 해제 대기(쇼핑몰 쪽 철회 실패, 철회 재시도용 토큰 사본만 남김) · DISCONNECTED 해제됨
enum ExternalShopStatus {
  CONNECTED
  REAUTH_REQUIRED
  DISCONNECT_PENDING
  DISCONNECTED
}

model ExternalShopConnection {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String             @db.Uuid
  // 외부 쇼핑몰 식별자(몰 id). 소문자 영숫자·하이픈, 주소로 만들지 않고 검증한 값으로만 호스트를 만든다(내부 주소 접속 차단)
  shopKey            String
  status             ExternalShopStatus @default(CONNECTED)
  // OAuth 토큰은 BILLING_KEY_SECRET 기반 AES-256-GCM으로 판매자 id를 묶어 암호화해 저장한다(원문 저장·로그 금지)
  accessTokenCipher  String?
  refreshTokenCipher String?
  accessExpiresAt    DateTime?          @db.Timestamptz(3)
  refreshExpiresAt   DateTime?          @db.Timestamptz(3)
  scopes             String?
  connectedAt        DateTime           @default(now()) @db.Timestamptz(3)
  lastEventAt        DateTime?          @db.Timestamptz(3)
  disconnectedAt     DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  seller Seller                 @relation(fields: [sellerId], references: [id])
  events ExternalWebhookEvent[]
  orders ExternalOrder[]

  @@unique([sellerId, id])
  @@unique([sellerId, shopKey])
  // 같은 외부 쇼핑몰이 두 파트너스에 동시에 붙지 않는다(연결 중 상태만, 마이그레이션 부분 유니크)
  @@index([shopKey, status])
}

// OAuth 시작 때 만드는 1회용·만료 state(해시만 저장). 콜백은 시작한 판매자·직원 세션과 같을 때만 받는다(로그인 CSRF 방지).
model ExternalOAuthState {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String    @db.Uuid
  userId    String    @db.Uuid
  shopKey   String
  stateHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([sellerId, createdAt])
}

// 받은 웹훅 원본(서명 검증을 통과한 것만). eventKey는 원본 본문 해시라 같은 이벤트 재전송은 한 번만 저장한다.
// 개인정보가 들어 있을 수 있어 보관 기간(받은 날부터 30일, 대표님 확인 대기)과 자동 삭제는 주문 저장 PR에서 함께 넣는다.
model ExternalWebhookEvent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String    @db.Uuid
  connectionId String    @db.Uuid
  eventKey     String
  payload      Json
  receivedAt   DateTime  @default(now()) @db.Timestamptz(3)
  processedAt  DateTime? @db.Timestamptz(3)

  connection ExternalShopConnection @relation(fields: [sellerId, connectionId], references: [sellerId, id])

  @@unique([connectionId, eventKey])
  @@index([sellerId, receivedAt])
}

// ───────────── 구매자 문의(상품 문의·1:1 문의, SA-046·047) ─────────────
// PRODUCT=상품 문의(productId 필수), GENERAL=1:1 문의. 답변은 판매자 하나(고치거나 지우면 다시 WAITING).
enum BuyerInquiryKind {
  PRODUCT
  GENERAL
}

enum BuyerInquiryStatus {
  WAITING
  ANSWERED
}

// 구매자가 쓴 문의. 답변 전에만 구매자가 고치거나 지울 수 있다(지우면 행과 사진을 모두 지움).
// 탈퇴하면 작성자 표시를 「탈퇴 회원」으로 바꾸고 사진은 지운다. 글은 판매자의 응대 기록으로 남긴다.
model BuyerInquiry {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String             @db.Uuid
  buyerMemberId     String             @db.Uuid
  kind              BuyerInquiryKind
  productId         String?            @db.Uuid
  authorNickname    String
  title             String
  body              String
  isPrivate         Boolean            @default(false)
  status            BuyerInquiryStatus @default(WAITING)
  answer            String?
  answeredAt        DateTime?          @db.Timestamptz(3)
  answeredBySellerUserId String?       @db.Uuid
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @db.Timestamptz(3)

  seller      Seller              @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember         @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])
  product     Product?            @relation(fields: [sellerId, productId], references: [sellerId, id])
  images      BuyerInquiryImage[]

  @@unique([sellerId, id])
  @@index([sellerId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([sellerId, buyerMemberId, createdAt(sort: Desc), id(sort: Desc)])
}

// 문의 첨부 사진. 먼저 올리고(inquiryId 없음) 문의를 보낼 때 붙인다. 붙지 않은 사진은 회원당 10장까지 두고 오래된 것부터 지운다.
model BuyerInquiryImage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String   @db.Uuid
  buyerMemberId String   @db.Uuid
  inquiryId     String?  @db.Uuid
  data          Bytes
  contentType   String
  byteSize      Int
  width         Int
  height        Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  seller      Seller        @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember   @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)
  inquiry     BuyerInquiry? @relation(fields: [sellerId, inquiryId], references: [sellerId, id], onDelete: Cascade)

  @@unique([sellerId, id])
  @@index([sellerId, inquiryId])
  @@index([sellerId, buyerMemberId, inquiryId, createdAt])
}

// ───────────── 알림 센터(MA-002 · SA-130) ─────────────

// 파트너스 계정이 알림 센터를 마지막으로 본 시각. 알림은 공지·문의에서 바로 만들어 주고 따로 쌓지 않는다.
// 공지 알림은 이 시각 이후 게시분이 안 읽음이다(문의 답변은 문의를 열면 읽음). 계정마다 한 줄.
model SellerNotificationSeen {
  sellerUserId String   @id @db.Uuid
  seenAt       DateTime @db.Timestamptz(3)
}

// ───────────── 쇼핑몰 검색(유사어·인기 검색어, 기반-쇼핑몰) ─────────────
// 유사어 묶음: 묶음 안 단어는 서로 같은 뜻으로 검색한다(예: 포켓몬·pokemon). 판매자마다 최대 50묶음, 묶음당 2~10단어.
model ShopSearchSynonym {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String   @db.Uuid
  words     String[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

// 인기 검색어 자체 집계(KST 날짜·단어별 횟수, 개인 식별 정보 없음, 무료). 8일이 지난 행은 집계할 때 지운다.
model ShopSearchTerm {
  sellerId String   @db.Uuid
  day      DateTime @db.Date
  term     String
  count    Int      @default(1)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([sellerId, day, term])
}

// ───────────── 마스터 대리 조회(MA-016) ─────────────

// 마스터 관리자가 파트너스 화면을 읽기 전용으로 보는 세션(사유 필수, 30분). 파트너스 로그인 세션과 따로 둔다.
// 쿠키 lo_imp(경로 /api/seller)로만 오고, proxy가 조회 허용 경로 밖은 막는다. 한 관리자에게 열린 세션은 하나만(새로 열면 앞의 것을 끝낸다).
model AdminImpersonationSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String    @db.Uuid
  sellerId  String    @db.Uuid
  tokenHash String    @unique
  reason    String
  ip        String?
  userAgent String?
  // 접근 사유 분류·관련 건(문의·알림·신고, 같은 쇼핑몰 건만)·열람 범위. 이전에 열린 세션은 category null, scopes는 그때 열려 있던 범위(주문·회원)로 채웠다.
  category    ImpersonationCategory?
  relatedKind ImpersonationRelatedKind?
  relatedId   String?                  @db.Uuid
  scopes      ImpersonationScope[]     @default([])
  expiresAt DateTime  @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([adminId, endedAt])
  @@index([sellerId, createdAt])
}

enum ImpersonationCategory {
  INQUIRY
  INCIDENT
  FINANCE_CHECK
  AUDIT
}

enum ImpersonationRelatedKind {
  INQUIRY
  NOTIFICATION
  REPORT
}

// 대리 조회로 볼 수 있는 화면 묶음. 범위 밖 파트너스 API는 403 out_of_scope.
enum ImpersonationScope {
  BROADCAST
  OVERLAY
  ORDERS
  MEMBERS
  SETTINGS_PG
}

// ───────────── 시작하기·온보딩(SA-003 · SA-004) ─────────────

// 파트너스 시작하기 체크리스트의 저장 상태(쇼핑몰마다 한 줄). 단계 완료는 상품·연동·설정 같은 기존 데이터에서 그때그때 계산하고,
// 계산할 수 없는 것(오버레이 주소를 복사했음, 체크리스트를 닫음)만 여기에 둔다.
model SellerOnboarding {
  sellerId           String    @id @db.Uuid
  overlayUrlCopiedAt DateTime? @db.Timestamptz(3)
  dismissedAt        DateTime? @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
}

// ───────────── 쇼핑몰별 이용약관·개인정보처리방침(구매자 화면 /shop/[슬러그]/terms·privacy) ─────────────

enum ShopLegalKind {
  TERMS
  PRIVACY
}

// 파트너스가 입력한 본문만 보여 준다(기본 서식은 게시 조건이 있어 앱이 대신 게시하지 않음, docs/terms). 쇼핑몰·종류마다 한 줄.
// isPublished가 false이면 구매자 화면은 「준비 중」 안내. version은 본문·시행일이 실제로 바뀐 때만 올라가고(같은 내용 재저장·재게시는 그대로, 약관 동의 버전 shop.{version}) 다른 창 덮어쓰기를 막는다(shop-legal/service.ts).
model ShopLegalDoc {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String        @db.Uuid
  kind        ShopLegalKind
  body        String        @default("")
  effectiveOn DateTime?     @db.Date
  isPublished Boolean       @default(false)
  publishedAt DateTime?     @db.Timestamptz(3)
  version     Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@unique([sellerId, kind])
}

// 인기 검색어·자동완성에서 뺄 단어(파트너스가 정함, 소문자로 접은 값). 검색어에 이 단어가 들어 있으면 보이지 않는다(검색 자체는 그대로 된다). 쇼핑몰마다 최대 100개.
model ShopSearchBlockedTerm {
  sellerId  String   @db.Uuid
  term      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([sellerId, term])
}

// 회원 대상 발송(SA-049, 2026-10-05). 실제 발송 채널(알림톡·문자·메일)과 충전 잔액 차감이 정해지기 전이라 「발송 기록」만 남긴다(RECORDED).
// 광고성(AD)은 혜택·소식 수신 동의 회원만, 정보성(INFO)은 정상 회원 전체. 받는 사람 연락처는 저장하지 않는다(보낼 때 서버가 회원 행에서 읽는다).
// 예약(SCHEDULED)은 시각이 되면 대상을 다시 계산해 받는 사람 행을 만들고 RECORDED로 바꾼다. 형식·상태 일치 CHECK는 마이그레이션 SQL.
enum MemberMessageKind {
  AD
  INFO
}

// ALIMTALK_SMS=알림톡(실패 시 문자), ALIMTALK=알림톡만, MAIL=메일
enum MemberMessageChannel {
  ALIMTALK_SMS
  ALIMTALK
  MAIL
}

// ALL=전체, GRADE=등급(gradeIds), WISHED=찜한 회원(productId), BOUGHT_30D=최근 30일 구매, NOT_BOUGHT_90D=최근 90일 미구매, PRODUCT_BOUGHT=특정 상품 구매(productId), PICKED=직접 선택(memberIds)
enum MemberMessageTarget {
  ALL
  GRADE
  WISHED
  BOUGHT_30D
  NOT_BOUGHT_90D
  PRODUCT_BOUGHT
  PICKED
}

enum MemberMessageStatus {
  SCHEDULED
  RECORDED
  CANCELLED
}

model MemberMessage {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String               @db.Uuid
  title          String
  kind           MemberMessageKind
  channel        MemberMessageChannel
  // 파트너스가 쓴 문구와, (광고)·쇼핑몰 이름·수신거부 문구를 붙인 최종 문구
  body           String
  renderedBody   String
  targetType     MemberMessageTarget
  targetParams   Json                 @default("{}")
  status         MemberMessageStatus
  scheduledAt    DateTime?            @db.Timestamptz(3)
  recordedAt     DateTime?            @db.Timestamptz(3)
  // 만들 때 계산한 예상 대상 수 / 기록 때 확정한 받는 사람 수와 하루 2건 한도로 뺀 수
  estimatedCount Int
  recipientCount Int?
  skippedDailyCap Int                 @default(0)
  staffId        String?              @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @db.Timestamptz(3)

  seller     Seller                   @relation(fields: [sellerId], references: [id])
  recipients MemberMessageRecipient[]

  @@unique([sellerId, id])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([status, scheduledAt])
}

// 받는 사람(기록 때 확정). 탈퇴하면 지운다(shop-member-messages, buyers/memberData.ts).
model MemberMessageRecipient {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String   @db.Uuid
  messageId     String   @db.Uuid
  buyerMemberId String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  seller  Seller        @relation(fields: [sellerId], references: [id])
  message MemberMessage @relation(fields: [sellerId, messageId], references: [sellerId, id], onDelete: Cascade)
  member  BuyerMember   @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)

  @@unique([messageId, buyerMemberId])
  @@index([sellerId, buyerMemberId, createdAt])
}

// 외부 쇼핑몰 주문(오버레이 전용 파트너스). 방송 표시에 필요한 최소 정보만 저장한다(개인정보 최소 수집, 보관 기간·삭제는 별도 확정 대기).
// 내부 Order와 별개라 ONQ 회원·상품 행을 만들지 않는다. 같은 연결의 같은 외부 주문번호는 한 번만 저장한다.
model ExternalOrder {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String    @db.Uuid
  connectionId    String    @db.Uuid
  externalOrderId String
  // 방송에 보이는 이름(닉네임·마스킹된 이름). 없으면 「외부 주문」
  buyerLabel      String?
  // 취소·환불이 들어오면 취소로 바꾼다(주문 자체는 지우지 않는다)
  cancelledAt     DateTime? @db.Timestamptz(3)
  receivedAt      DateTime  @default(now()) @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  seller     Seller                 @relation(fields: [sellerId], references: [id])
  connection ExternalShopConnection @relation(fields: [sellerId, connectionId], references: [sellerId, id])
  queueItems QueueItem[]

  @@unique([sellerId, id])
  @@unique([connectionId, externalOrderId])
  @@index([sellerId, receivedAt])
}

// ───────────── 전환 단계 통계(상품 상세 → 장바구니 → 주문 → 결제, 대표님 결정 2026-10-05 A안) ─────────────
// 로그인한 구매자 회원의 상품 상세 조회·장바구니 담기만 일(KST) 단위로 센다(비회원·익명 쿠키 기록 없음). 주문·결제는 기존 주문 표에서 계산한다.
// 같은 회원이 같은 상품을 같은 날 여러 번 보거나 담아도 한 번만 센다. 어느 회원인지는 일 단위 HMAC 값으로만 두고(원문 식별자 없음), 8일 뒤 지운다.
// 일 집계는 400일 보관한다. 정리 작업은 jobs/scheduler.ts. 서비스는 lib/server/stats/funnel.ts(기록 실패가 구매자 화면을 막지 않는다).
model ProductFunnelDaily {
  sellerId  String   @db.Uuid
  productId String   @db.Uuid
  day       DateTime @db.Date
  views     Int      @default(0)
  cartAdds  Int      @default(0)

  @@id([sellerId, productId, day])
  @@index([sellerId, day])
}

// 중복 제거용 임시 표. kind: V(상품 상세 조회) · C(장바구니 담기). viewerHash = HMAC(서버 비밀키, 일|쇼핑몰|회원).
model ProductFunnelSeen {
  sellerId   String   @db.Uuid
  productId  String   @db.Uuid
  day        DateTime @db.Date
  kind       String   @db.Char(1)
  viewerHash String

  @@id([sellerId, productId, day, kind, viewerHash])
  @@index([day])
}

// ───────────── 쇼핑몰 바닥글 법정 표시(SA-062 사업자 정보·고지) ─────────────

enum ShopEscrowKind {
  NONE
  ESCROW
  INSURANCE
}

// 쇼핑몰 바닥글에 보이는 사업자 정보·고지 중 파트너스가 입력하는 값(쇼핑몰당 한 줄). 상호·대표자·사업자등록번호·통신판매업 신고번호는
// 입점 신청 때 받은 검증 값(Seller.businessInfo)을 그대로 읽어 보여 주고 여기서 바꾸지 않는다. 입력한 항목만 구매자 화면에 보인다.
// escrowKind: 구매안전서비스 가입 종류(없음·에스크로·소비자피해보상보험). 가입 정보는 파트너스가 쓴 그대로 표시한다(법률 문구를 앱이 짓지 않음).
// minorNotice: 미성년자 구매 안내 글(파트너스 입력). version은 저장할 때마다 올라가고 다른 창 덮어쓰기를 막는다(shop-legal/notice.ts).
model ShopLegalNotice {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String         @unique @db.Uuid
  address        String         @default("")
  csPhone        String         @default("")
  csEmail        String         @default("")
  csHours        String         @default("")
  escrowKind     ShopEscrowKind @default(NONE)
  escrowProvider String         @default("")
  escrowUrl      String         @default("")
  minorNotice    String         @default("")
  // 쇼핑몰 하단 「카카오톡 문의」 버튼·유튜브 채널 링크(SA-060, https만). 비어 있으면 버튼을 보이지 않는다.
  kakaoChannelUrl  String       @default("")
  youtubeChannelUrl String      @default("")
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// ───────────── 파트너스 가입 신청 심사 상태(MA-013) ─────────────
// 가입 신청(Seller PENDING)의 보완 요청·재촉 메일 기록. 신청마다 한 줄(보완 요청을 처음 보낼 때 만든다). 「확인 필요」·「이상 없음」은 reviewReasons에서 계산한다.
// 보완 요청 중 = supplementRequestedAt이 있고 supplementResolvedAt이 없음. 기한(supplementDueAt)이 지나면 정기 작업이 자동 반려한다.
model SellerApplicationReview {
  sellerId              String    @id @db.Uuid
  supplementReason      String?
  supplementRequestedAt DateTime? @db.Timestamptz(3)
  supplementDueAt       DateTime? @db.Timestamptz(3)
  supplementResolvedAt  DateTime? @db.Timestamptz(3)
  supplementByAdminId   String?   @db.Uuid
  reminderCount         Int       @default(0)
  lastReminderAt        DateTime? @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
}

// 서버 자원 스냅숏(앱이 자기 서버를 잰 값, 정기 실행 infra_snapshot.collect가 시간마다 저장하고 35일 지난 것은 지운다).
// 마스터 관리자(최고관리자)가 인프라 용량 화면에서 읽는다. 비밀값은 담지 않는다.
model InfraSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  takenAt        DateTime @db.Timestamptz(3)
  instance       String
  diskTotalBytes BigInt?
  diskUsedBytes  BigInt?
  memTotalBytes  BigInt?
  memUsedBytes   BigInt?
  cpuCount       Int?
  load1          Float?
  dbSizeBytes    BigInt?
  dbConnections  Int?
  dbMaxConnections Int?
  // 백업 폴더를 읽을 수 있을 때만 값이 있다(OPS_BACKUP_DIR). 없으면 null = 못 잼.
  backupLastAt   DateTime? @db.Timestamptz(3)
  backupCount    Int?
  backupBytes    BigInt?

  @@index([takenAt])
}

enum AdminAlertSeverity {
  URGENT
  WARNING
  INFO
}

enum AdminAlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// 마스터 관리자 알림 센터(MA-002) 알림. 다른 기능이 lib/server/admin-alerts/service.ts의 createAdminAlert 한 곳으로 만든다(화면 안 알림만, 외부 발송 없음).
// 알림 하나를 보는 역할(targetRoles)이 같이 보고, 담당·상태(미처리·처리 중·해결됨)도 모두 같은 값을 본다. 읽음은 관리자마다(AdminAlertRead).
model AdminAlert {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            String
  severity        AdminAlertSeverity
  sellerId        String?             @db.Uuid
  title           String
  body            String?
  linkPath        String
  // 같은 사건이 여러 번 알림으로 쌓이지 않게 부르는 쪽이 정한 키(없으면 중복 검사 없음)
  dedupeKey       String?             @unique
  targetRoles     PlatformAdminRole[]
  status          AdminAlertStatus    @default(OPEN)
  assignedAdminId String?             @db.Uuid
  resolvedAt      DateTime?           @db.Timestamptz(3)
  occurredAt      DateTime            @default(now()) @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  reads AdminAlertRead[]

  @@index([status, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
}

model AdminAlertRead {
  adminId String   @db.Uuid
  alertId String   @db.Uuid
  readAt  DateTime @default(now()) @db.Timestamptz(3)

  alert AdminAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([adminId, alertId])
}

// 플랫폼 기본 정책(MA-081). 키별 정수 값(불리언 0/1). 행이 없으면 코드 기본값(현재 동작과 같음). 최고관리자만 바꾸고 변경은 로그 추적에 남긴다.
model PlatformPolicy {
  key              String   @id
  intValue         Int
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updatedByAdminId String?  @db.Uuid
}

// 인프라 단가 표(한 행, id = 1). 마스터 관리자(최고관리자)가 입력하는 월 단가·건당 단가·수수료율. 비밀값 없음.
// prices는 키(serverMonthlyWon 등) → 숫자. 입력하지 않은 키는 없다(비용 추정에서 「단가 없음」). 변경은 version으로 겹침을 막고 로그 추적에 남긴다.
model InfraPriceSetting {
  id               Int      @id @default(1)
  prices           Json     @default("{}")
  version          Int      @default(0)
  updatedByAdminId String?  @db.Uuid
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// 외부 연결(공공데이터포털 API·결제대행사·메일·도우미 등) 만료일·호출 상태(MA-120 「외부 연결 · 만료 · 상태」). 키 값은 어디에도 두지 않는다.
// 연결 목록(key·이름·용도)은 코드(lib/server/ops/connections.ts)가 정하고, 행은 처음 기록·입력할 때 만든다.
// 만료일은 최고관리자가 입력(KST 하루 끝까지 유효), 마지막 정상 호출·인증 오류 시각은 각 연동 호출부가 기록한다.
model ExternalConnection {
  key                String    @id
  expiresAt          DateTime? @db.Timestamptz(3)
  lastOkAt           DateTime? @db.Timestamptz(3)
  lastAuthErrorAt    DateTime? @db.Timestamptz(3)
  // 상태 코드만(예: http_401). 응답 본문·키는 남기지 않는다.
  lastAuthErrorCode  String?
  version            Int       @default(0)
  updatedByAdminId   String?   @db.Uuid
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
}

// 플랫폼(ONQ) 사업자 정보(한 줄, id = 1, 마이그레이션 CHECK). 파트너스 가입 안내 메일 바닥글(EM-101·102)에 쓴다. 최고관리자만 바꾸고 변경은 로그 추적에 남긴다.
// 값이 비어 있어도 가입 승인·반려 메일은 보내고 바닥글에서 그 항목만 뺀다(MASTER 결정). 빈 칸은 마스터 홈 「오늘 처리할 일」에 남는다. 주소(URL)는 APP_ORIGIN을 쓴다.
// 표시 의무 7항목(MA-088): 상호·대표·사업자등록번호·통신판매업 신고번호·주소·고객센터 전화·이메일.
model PlatformBusinessInfo {
  id               Int      @id @default(1)
  name             String   @default("")
  representative   String   @default("")
  businessNumber   String   @default("")
  mailOrderNumber  String   @default("")
  address          String   @default("")
  phone            String   @default("")
  email            String   @default("")
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updatedByAdminId String?  @db.Uuid
}
