// 데이터 모델 정본: docs/ARCHITECTURE.md 4절.
// Prisma 문법으로 표현할 수 없는 제약(부분 유니크 인덱스, CHECK)은 마이그레이션 SQL에 직접 추가한다.
// 판매자 데이터 자식 테이블은 (sellerId, 부모 id) 복합 외래키로 부모를 참조해 다른 판매자 데이터와 묶일 수 없게 한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── 플랫폼 ─────────────

enum PlatformAdminRole {
  SUPER_ADMIN
  OPERATIONS
  CS
  READ_ONLY
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
}

model PlatformAdmin {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String              @unique
  passwordHash String
  name         String
  role         PlatformAdminRole
  status       PlatformAdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?           @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  sessions        AdminSession[]
  approvedSellers Seller[]
}

model AdminSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String    @db.Uuid
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([adminId])
}

// ───────────── 판매자(쇼핑몰)·직원 ─────────────

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  CLOSED
}

model Seller {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                     String       @unique
  shopName                 String
  // 공유 미리보기(og:title·og:description) 제목·설명. 비어 있으면 쇼핑몰 이름(제목)·없음(설명). 파트너스 쇼핑몰 설정(SHOP_SETTINGS)에서 바꾼다.
  shareTitle               String?
  shareDescription         String?
  status                   SellerStatus @default(PENDING)
  businessInfo             Json?
  approvedAt               DateTime?    @db.Timestamptz(3)
  // 체험하기 종료 시각 = 마스터 승인 시각(DB 시계) + 판매자 플랜의 체험 일수(SubscriptionPlan.trialDays, 오버레이 전용 7일·통합 없음,
  // lib/server/sellers/approval.ts). 체험이 없는 플랜은 null. 지나면 구독 전까지 판매자 API를 막는다.
  trialEndsAt              DateTime?    @db.Timestamptz(3)
  // 판매자 플랜(가입 신청 때 정함, ONQ 1-C). 구독 행이 생기면 구독의 planId가 청구 기준이다. 기존 판매자는 INTEGRATED로 옮겼다.
  planId                   String?      @db.Uuid
  // 런칭 할인을 쓴 시각(런칭가 청구가 처음 확정된 때, 대표님 결정 2026-10-04). 이 뒤 해지하고 다시 구독하면 정가다.
  // 이전 전 STANDARD 결제는 사용으로 세지 않는다(ONQ 1-C-2).
  launchDiscountUsedAt     DateTime?    @db.Timestamptz(3)
  // 잠긴 지 30일이 지나 자동 해지된 시각. 이때부터 90일 보관 뒤 삭제 대상(삭제는 별도 작업). 다시 구독하면 비운다.
  serviceEndedAt           DateTime?    @db.Timestamptz(3)
  approvedByAdminId        String?      @db.Uuid
  suspendedReason          String?
  // 가입 자동 점검에서 걸린 항목(「확인 필요」 사유). 자동 승인·마스터 승인 때 비운다.
  reviewReasons            String[]     @default([])
  // 가입 반려 사유·시각(정지 사유와 따로 둔다)
  rejectedReason           String?
  rejectedAt               DateTime?    @db.Timestamptz(3)
  // 대표자 PASS 본인인증 CI의 HMAC-SHA256 값(원문 CI는 저장하지 않음). 대표자 1명당 쇼핑몰 1개는 마이그레이션 SQL 부분 유니크.
  representativeCiHash     String?
  representativeVerifiedAt DateTime?    @db.Timestamptz(3)
  liveVersion              Int          @default(0)
  createdAt                DateTime     @default(now()) @db.Timestamptz(3)

  approvedBy PlatformAdmin? @relation(fields: [approvedByAdminId], references: [id])
  plan       SubscriptionPlan? @relation(fields: [planId], references: [id])

  domains                  SellerDomain[]
  users                    SellerUser[]
  sellerSessions           SellerSession[]
  passwordResetGrants      PasswordResetGrant[]
  grades                   MemberGrade[]
  buyers                   BuyerMember[]
  buyerAddresses           BuyerAddress[]
  identityVerifications    IdentityVerification[]
  buyerSessions            BuyerSession[]
  products                 Product[]
  productImages            ProductImage[]
  productOptions           ProductOption[]
  stockMovements           StockMovement[]
  orders                   Order[]
  orderItems               OrderItem[]
  orderConsents            OrderConsent[]
  orderPolicy              SellerOrderPolicy?
  memberPolicy             SellerMemberPolicy?
  rejoinBlocks             BuyerRejoinBlock[]
  purchaseRestrictions     BuyerPurchaseRestriction[]
  shippingPolicy           SellerShippingPolicy?
  orderShippingAddresses   OrderShippingAddress[]
  shipments                Shipment[]
  orderStatusHistories     OrderStatusHistory[]
  broadcastSessions        BroadcastSession[]
  queueItems               QueueItem[]
  queueItemStatusHistories QueueItemStatusHistory[]
  hitCards                 HitCard[]
  rewardPolicy             RewardPolicy?
  rewardLedger             RewardLedger[]
  rewardBalances           RewardBalance[]
  overlayTokens            OverlayToken[]
  subscription             SellerSubscription?
  subscriptionPayments     SubscriptionPayment[]
  auditLogs                AuditLog[]
  shopBanners              ShopBanner[]
  shopPopups               ShopPopup[]
  shopContentImages        ShopContentImage[]
}

model SellerDomain {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String    @db.Uuid
  hostname    String    @unique
  verifiedAt  DateTime? @db.Timestamptz(3)
  certStatus  String?
  // 자동 해지로 연결을 푼 시각(비활성). 다시 구독하면 되살린다.
  suspendedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
}

// 판매자 직원 권한 항목(대표님 결정 2026-10-02: 고정 역할 대신 항목별로 켜고 끔).
// PG 연결·구독·직원 관리·적립금 실지급 스위치는 대표자 전용이라 항목으로 줄 수 없다.
enum SellerStaffPermission {
  BROADCAST_RUN
  OVERLAY_EDIT
  PRODUCT_MANAGE
  ORDER_SHIPPING
  CUSTOMER_PII_VIEW
  MEMBER_POINTS
  INQUIRY_REPLY
  RECEIPT_TAX
  SALES_VIEW
  SHOP_SETTINGS
}

enum SellerUserStatus {
  ACTIVE
  DISABLED
}

model SellerUser {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String                  @db.Uuid
  email             String
  passwordHash      String
  name              String
  // 대표자 여부. 대표자는 모든 권한과 대표자 전용 기능을 가진다.
  isOwner           Boolean                 @default(false)
  // 직원 권한 항목(대표자는 비워 둔다)
  permissions       SellerStaffPermission[] @default([])
  // 비밀번호가 바뀔 때마다 1씩 올린다. 세션은 만들 때의 값을 들고 있고, 다르면 무효(재설정 중 진행된 옛 비밀번호 로그인 차단).
  credentialVersion Int                     @default(0)
  status            SellerUserStatus        @default(ACTIVE)
  lastLoginAt       DateTime?               @db.Timestamptz(3)
  // 직원 휴대폰 번호(숫자만, 대표자가 직원 관리에서 등록, 기존 행은 null). 직원 본인확인 연결 때 결과와 대조한다.
  phone             String?
  // 직원이 본인확인으로 연결한 CI의 HMAC 해시(등록한 이름·휴대폰과 결과가 맞을 때만). 직원 셀프 아이디·비밀번호 찾기에만 쓴다.
  // 대표자가 휴대폰 번호를 바꾸면 지운다. 대표자는 쇼핑몰 대표자 CI(Seller.representativeCiHash)를 쓰고 여기는 비워 둔다.
  identityCiHash    String?
  identityLinkedAt  DateTime?               @db.Timestamptz(3)
  // 연결돼 있다가 대표자가 휴대폰 번호를 바꿔 연결이 풀린 시각(다시 연결하면 비움). 처음부터 미연결인 직원과 구별한다.
  identityUnlinkedAt DateTime?              @db.Timestamptz(3)
  // 대표자 가입 신청 필수 동의 기록(본인확인 시작 때 받은 문서 버전·시각, sellers/signupConsent.ts). 직원·이 기능 전 대표자는 비어 있다.
  signupConsent     Json?
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)

  seller      Seller               @relation(fields: [sellerId], references: [id])
  sessions    SellerSession[]
  resetGrants PasswordResetGrant[]

  @@unique([sellerId, id])
  @@unique([sellerId, email])
  @@index([identityCiHash])
}

// 판매자 대표 비밀번호 재설정 권한(일회용·10분). 토큰은 해시만 저장한다.
model PasswordResetGrant {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId     String    @db.Uuid
  sellerUserId String    @db.Uuid
  tokenHash    String    @unique
  // 발급 때 확인한 CI 해시(대표자는 쇼핑몰 대표자 CI, 직원은 연결 CI). 쓸 때 그 값이 바뀌었으면 거부한다.
  ciHash       String
  expiresAt    DateTime  @db.Timestamptz(3)
  usedAt       DateTime? @db.Timestamptz(3)
  // 이 권한으로 새 비밀번호 저장에 성공한 시각(실패로 소진되거나 다른 권한 사용으로 무효가 된 권한은 비어 있음).
  // 응답을 잃고 같은 새 비밀번호로 다시 보낸 요청을 성공으로 돌려주는 데 쓴다(auth/passwordReset.ts).
  completedAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  // 아이디 찾기로 준 권한: 발급에 쓴 본인확인과 토큰을 다시 만드는 무작위 값(토큰 = 서버 비밀키 HMAC(nonce), 원문은 저장하지 않음).
  // 응답을 잃은 재시도에 같은 토큰을 다시 돌려준다(auth/accountRecovery.ts).
  verificationId String?   @db.Uuid
  nonce          String?

  seller     Seller     @relation(fields: [sellerId], references: [id])
  sellerUser SellerUser @relation(fields: [sellerId, sellerUserId], references: [sellerId, id])

  @@index([verificationId])
  @@index([sellerId, sellerUserId])
}

model SellerSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerUserId      String    @db.Uuid
  sellerId          String    @db.Uuid
  tokenHash         String    @unique
  credentialVersion Int       @default(0)
  ip                String?
  userAgent         String?
  expiresAt         DateTime  @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  seller     Seller     @relation(fields: [sellerId], references: [id])
  sellerUser SellerUser @relation(fields: [sellerId, sellerUserId], references: [sellerId, id])

  @@index([sellerId, sellerUserId])
}

// ───────────── 구매자 회원 (판매자 쇼핑몰별) ─────────────

enum GradeSystemKey {
  BASIC
  SPROUT
  SILVER
  GOLD
  VIP
}

// 등급은 id·displayName·sortOrder로 식별한다. systemKey는 기본 5개 표시용(판매자가 추가한 등급은 null).
model MemberGrade {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String          @db.Uuid
  displayName String
  sortOrder   Int
  systemKey   GradeSystemKey?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  seller  Seller        @relation(fields: [sellerId], references: [id])
  members BuyerMember[]

  @@unique([sellerId, id])
  @@unique([sellerId, displayName])
  @@unique([sellerId, systemKey])
}

enum BuyerMemberStatus {
  ACTIVE
  DORMANT
  WITHDRAWN
}

// CI·휴대폰·아이디·방송 닉네임 유니크는 deletedAt IS NULL 행에만 적용 (마이그레이션 SQL 부분 유니크 인덱스).
model BuyerMember {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String            @db.Uuid
  loginId            String
  passwordHash       String
  name               String
  phone              String
  // PASS 본인인증 CI의 HMAC-SHA256 값(원문 CI는 저장하지 않음). 같은 쇼핑몰 중복 가입 차단 기준.
  ciHash             String
  identityVerifiedAt DateTime          @db.Timestamptz(3)
  // PASS 생년월일. 미성년자 구매 정책 판정에 쓴다. 탈퇴하면 지운다(null).
  birthDate          DateTime?         @db.Date
  broadcastNickname  String
  gradeId            String            @db.Uuid
  status             BuyerMemberStatus @default(ACTIVE)
  marketingConsentAt DateTime?         @db.Timestamptz(3)
  // 지금 마케팅 수신 동의의 문서 버전(동의 중일 때만). 마지막으로 철회한 시각(다시 동의하면 비움). buyers/marketingConsent.ts
  marketingConsentVersion String?
  marketingWithdrawnAt    DateTime?    @db.Timestamptz(3)
  // 가입 때 재가입 제한이 켜져 있었으면 그때 기간(일). 가입하며 안내받은(동의한) 기간보다 길게 CI 해시를 보관하지 않으려고 남긴다.
  // 없으면(제한이 꺼져 있을 때 가입) 탈퇴해도 재가입을 제한하지 않는다(buyers/rejoin.ts).
  rejoinRestrictionDaysAgreed Int?
  // 「재가입 제한 정보 보관 동의」(개인정보 수집·이용 동의와 별도, 재가입 제한을 켠 쇼핑몰에서만 받음) 시각·문서 버전
  rejoinRetentionAgreedAt     DateTime? @db.Timestamptz(3)
  rejoinRetentionVersion      String?
  // 위 보관 동의를 마지막으로 철회한 시각(회원 정보에서 언제든 철회, buyers/rejoinConsent.ts). 철회하면 위 세 칸을 비운다.
  rejoinRetentionWithdrawnAt  DateTime? @db.Timestamptz(3)
  // 가입 필수 동의 기록(본인확인 시작 때 받은 문서 버전·시각, buyers/consent.ts SignupConsent)
  signupConsent               Json?
  lastLoginAt        DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  deletedAt          DateTime?         @db.Timestamptz(3)

  seller               Seller                     @relation(fields: [sellerId], references: [id])
  grade                MemberGrade                @relation(fields: [sellerId, gradeId], references: [sellerId, id])
  sessions             BuyerSession[]
  orders               Order[]
  purchaseRestrictions BuyerPurchaseRestriction[]
  hitCards             HitCard[]
  rewardLedger         RewardLedger[]
  rewardBalances       RewardBalance[]
  addresses            BuyerAddress[]

  @@unique([sellerId, id])
  @@index([sellerId, gradeId])
}

// 구매자 저장 배송지(2026-10-03 대표님 결정). 주문 때 입력한 배송지를 저장하고(구매자가 끌 수 있음), 주문서에서 고른다.
// 구매자당 20개까지. 배송지가 있으면 기본 배송지는 항상 1개(부분 유니크 인덱스 BuyerAddress_one_default_per_buyer, 마이그레이션 SQL).
// lastUsedAt: 마지막으로 주문에 쓴 시각. 기본 배송지를 지우면 가장 최근에 사용한 배송지가 기본이 된다.
// 주문에는 OrderShippingAddress 스냅숏이 따로 남으므로 여기 값을 고치거나 지워도 지난 주문은 바뀌지 않는다.
model BuyerAddress {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @db.Uuid
  buyerMemberId String    @db.Uuid
  label         String?
  recipientName String
  phone         String
  zipCode       String
  address1      String
  address2      String?
  memo          String?
  isDefault     Boolean   @default(false)
  lastUsedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @db.Timestamptz(3)

  seller Seller      @relation(fields: [sellerId], references: [id])
  member BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id], onDelete: Cascade)

  @@index([sellerId, buyerMemberId])
}

enum IdentityVerificationPurpose {
  BUYER_SIGNUP
  SELLER_REPRESENTATIVE
  PASSWORD_RESET
  STAFF_LINK // 직원 본인확인 연결(로그인한 직원, subjectId = 직원 계정)
  ACCOUNT_RECOVERY // 쇼핑몰을 모르는 아이디 찾기·계정 고르기 비밀번호 찾기
}

enum IdentityVerificationMethod {
  PASS_APP
  SMS
}

enum IdentityVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

// PASS 본인인증 요청·결과. 연동은 IdentityProvider 인터페이스 뒤에 둔다(개발·테스트는 가짜 공급자).
// CI 원문은 저장하지 않고 서버 비밀키(IDENTITY_HASH_KEY) HMAC-SHA256 값만 저장한다. 판매자 대표자 인증은 sellerId가 없다.
model IdentityVerification {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId        String?                     @db.Uuid
  purpose         IdentityVerificationPurpose
  provider        String
  // 본인확인 방식. 기존 행은 실제 쓴 방식(PASS_APP) 그대로 두고, 휴대폰 본인확인(문자)부터 SMS로 남긴다.
  method          IdentityVerificationMethod
  requestId       String
  status          IdentityVerificationStatus  @default(PENDING)
  // 문자 본인확인: 요청 때 받은 휴대폰번호(숫자만). 대행사 결과의 번호가 이와 다르면 실패로 본다.
  requestedPhone  String?
  // 인증번호 보낸 횟수(처음 포함)·마지막으로 보낸 시각·틀린 횟수. 한도는 identity/verification.ts 상수.
  sendCount       Int                         @default(0)
  lastSentAt      DateTime?                   @db.Timestamptz(3)
  otpFailCount    Int                         @default(0)
  // 확인을 마친 뒤 이 본인확인으로 가입을 시도한 횟수(실패 포함). 한도를 넘으면 처음부터 다시(buyers/signup.ts).
  useAttemptCount Int                         @default(0)
  ciHash          String?
  name            String?
  phone           String?
  birthDate       DateTime?                   @db.Date
  verifiedAt      DateTime?                   @db.Timestamptz(3)
  // 인증을 시작한 브라우저에 준 일회용 값의 해시. 완료할 때 같은 값이 있어야 한다(다른 사람이 id만 알아서는 못 씀).
  ownerTokenHash  String?
  // 구매자 가입: 본인확인 전에 받은 필수 동의(buyers/consent.ts SignupConsent). 가입하면 회원으로 옮긴다.
  signupConsent   Json?
  // 비밀번호 찾기: 재설정 대상 계정(없는 계정이면 null, 응답은 같게)
  subjectId       String?                     @db.Uuid
  // 구매자 가입 시작 멱등 키(클라이언트가 만든 attemptKey의 해시). 같은 쇼핑몰·같은 키로 다시 시작하면 새로 만들지 않는다.
  attemptKeyHash  String?
  // 첫 인증번호를 보내기 시작한 시각(구매자 가입). sendCount가 0인 채 오래 지나면 같은 attemptKey 재요청이 발송을 넘겨받는다.
  sendStartedAt   DateTime?                   @db.Timestamptz(3)
  // 인증을 시작한 접속 IP(신뢰 프록시 기준, 없으면 null). 판매자 가입 PASS 시작 하루 횟수 제한에 쓴다.
  requestIp       String?
  // 이 인증으로 가입·재설정 권한을 이미 발급했으면 기록(한 번만 쓰임)
  consumedAt      DateTime?                   @db.Timestamptz(3)
  // 식별 항목(이름·휴대폰·요청 휴대폰·생년월일·CI 해시·subjectId·동의·대행사 요청 id)을 비운 시각. 행은 한도 계산에 쓰여 남긴다
  // (쇼핑몰·상태·요청 시각·요청 IP). 비식별된 VERIFIED 행은 CI 해시가 없어도 된다(CHECK).
  anonymizedAt    DateTime?                   @db.Timestamptz(3)
  expiresAt       DateTime                    @db.Timestamptz(3)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)

  seller Seller? @relation(fields: [sellerId], references: [id])

  @@unique([provider, requestId])
  @@unique([sellerId, attemptKeyHash])
  @@index([purpose, requestIp, createdAt])
  @@index([sellerId, ciHash])
}

model BuyerSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerMemberId String    @db.Uuid
  sellerId      String    @db.Uuid
  tokenHash     String    @unique
  expiresAt     DateTime  @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@index([sellerId, buyerMemberId])
}

// ───────────── 상품·옵션·재고 ─────────────

enum StockDeductMode {
  ORDER
  PAYMENT
}

enum ProductStatus {
  DRAFT
  ON_SALE
  SOLD_OUT
  HIDDEN
}

enum EventDiscountType {
  RATE
  AMOUNT
}

model Product {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String             @db.Uuid
  name               String
  description        String?
  price              Int
  status             ProductStatus      @default(DRAFT)
  // 재고 차감 시점(카페24 방식, 대표님 결정 2026-10-03): ORDER=주문할 때, PAYMENT=결제 확인 때(기본)
  stockDeductMode    StockDeductMode    @default(PAYMENT)
  // 이벤트 할인(대표님 결정 2026-10-03): 할인율(RATE, %) 또는 할인 금액(AMOUNT, 원)과 시작·종료 시각. 넷 다 있거나 넷 다 없다(CHECK).
  // 기간 안에 주문하면 서버가 DB 시계로 판단해 할인가로 주문을 만든다. 끝나면 자동으로 정가.
  eventDiscountType  EventDiscountType?
  eventDiscountValue Int?
  eventStartsAt      DateTime?          @db.Timestamptz(3)
  eventEndsAt        DateTime?          @db.Timestamptz(3)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  deletedAt          DateTime?          @db.Timestamptz(3)

  seller     Seller          @relation(fields: [sellerId], references: [id])
  images     ProductImage[]
  options    ProductOption[]
  orderItems OrderItem[]

  @@unique([sellerId, id])
}

model ProductImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String   @db.Uuid
  productId  String   @db.Uuid
  storageKey String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  seller  Seller  @relation(fields: [sellerId], references: [id])
  product Product @relation(fields: [sellerId, productId], references: [sellerId, id])

  @@index([sellerId, productId])
}

// 옵션 없는 상품도 기본 옵션 1개를 둬 재고를 한 곳에서 관리한다. stock >= 0 CHECK는 마이그레이션 SQL.
model ProductOption {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String    @db.Uuid
  productId  String    @db.Uuid
  name       String
  priceDelta Int       @default(0)
  stock      Int       @default(0)
  sku        String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  // 지운 옵션(소프트 삭제). 지난 주문 품목이 참조하므로 행은 남긴다. 새 주문에서는 고를 수 없다.
  deletedAt  DateTime? @db.Timestamptz(3)

  seller         Seller          @relation(fields: [sellerId], references: [id])
  product        Product         @relation(fields: [sellerId, productId], references: [sellerId, id])
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@unique([sellerId, id])
  @@index([sellerId, productId])
}

enum StockMovementReason {
  ORDER
  CANCEL
  REFUND
  MANUAL
}

enum ActorType {
  PLATFORM_ADMIN
  SELLER_USER
  BUYER
  SYSTEM
}

model StockMovement {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String              @db.Uuid
  optionId   String              @db.Uuid
  delta      Int
  reason     StockMovementReason
  orderId    String?             @db.Uuid
  // 수동 증감 사유(MANUAL). 예) 「이벤트 증정」
  note       String?
  // 이 이동 뒤 옵션 재고. DB 트리거(StockMovement_set_stock_after)가 넣는다: 이동은 언제나 재고를 바꾼 뒤 같은 트랜잭션에서 기록한다.
  // 트리거 전 기록은 null(화면은 표시하지 않음).
  stockAfter Int?
  // 기록 순서. 이동은 옵션 행을 잠근 UPDATE 뒤에 넣으므로 옵션마다 seq 순서가 실제 적용 순서와 같다(createdAt은 트랜잭션 시작 시각이라 뒤바뀔 수 있음).
  seq        BigInt              @unique @default(autoincrement())
  actorType  ActorType
  actorId    String?             @db.Uuid
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  seller Seller        @relation(fields: [sellerId], references: [id])
  option ProductOption @relation(fields: [sellerId, optionId], references: [sellerId, id])
  order  Order?        @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@index([sellerId, optionId])
  @@index([sellerId, seq(sort: Desc)])
}

// ───────────── 쇼핑몰 꾸미기: 홈 배너·이벤트 팝업 (2026-10-04 대표님 지시) ─────────────
// 파트너스 관리자에서 대표자·「쇼핑몰 설정」(SHOP_SETTINGS) 직원만 바꾼다(lib/server/shop-content). 노출 기간은 DB 시계로 판단한다.
// 이미지는 대표님 저장 방식 결정 전이라 비용 없는 A안(DB bytea). 형식·크기·해시 CHECK는 마이그레이션 SQL.
// 배너·팝업은 (sellerId, 이미지 id) 복합 외래키로 같은 쇼핑몰 이미지만 가리킨다.

enum ShopPopupTarget {
  HOME
  ALL
}

// IMAGE=이미지 팝업(가운데), TEXT=글 팝업(가운데), BAR=상단 띠(화면 맨 위 한 줄)
enum ShopPopupKind {
  IMAGE
  TEXT
  BAR
}

model ShopContentImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String   @db.Uuid
  data        Bytes
  // 바이트로 확인한 형식(image/png만, 2026-10-04 MASTER 결정). 올린 쪽이 보낸 Content-Type은 쓰지 않는다.
  contentType String
  byteSize    Int
  width       Int
  height      Int
  // 주소 버전(v=)과 캐시 판단용 SHA-256(hex)
  sha256      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  seller        Seller       @relation(fields: [sellerId], references: [id])
  bannersPc     ShopBanner[] @relation("ShopBannerPcImage")
  bannersMobile ShopBanner[] @relation("ShopBannerMobileImage")
  popups        ShopPopup[]

  @@unique([sellerId, id])
  @@index([sellerId, createdAt])
}

// 홈 배너 슬라이드. 모바일 이미지가 없으면 PC 이미지를 쓴다. linkUrl은 쇼핑몰 안 경로(/로 시작) 또는 http(s) 주소만.
model ShopBanner {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @db.Uuid
  // 관리용 이름이자 이미지 대체 글
  title         String
  pcImageId     String    @db.Uuid
  mobileImageId String?   @db.Uuid
  linkUrl       String?
  // 게시 기간. 비어 있으면 그쪽 제한 없음.
  startsAt      DateTime? @db.Timestamptz(3)
  endsAt        DateTime? @db.Timestamptz(3)
  showOnPc      Boolean   @default(true)
  showOnMobile  Boolean   @default(true)
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  seller      Seller            @relation(fields: [sellerId], references: [id])
  pcImage     ShopContentImage  @relation("ShopBannerPcImage", fields: [sellerId, pcImageId], references: [sellerId, id], onDelete: Restrict)
  mobileImage ShopContentImage? @relation("ShopBannerMobileImage", fields: [sellerId, mobileImageId], references: [sellerId, id], onDelete: Restrict)

  @@index([sellerId, sortOrder])
}

// 이벤트 팝업. target HOME=쇼핑몰 홈만, ALL=모든 구매자 화면. 이미지 팝업은 이미지, 글 팝업은 내용이 있어야 한다(CHECK).
// dismissDays: 구매자가 「보지 않기」를 고르면 숨기는 날 수(0=닫기만·매번 표시, 1=오늘 하루, 7=7일). 구매자 브라우저에 저장한다.
model ShopPopup {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String          @db.Uuid
  kind           ShopPopupKind   @default(IMAGE)
  title          String
  body           String?
  imageId        String?         @db.Uuid
  linkUrl        String?
  linkLabel      String?
  startsAt       DateTime?       @db.Timestamptz(3)
  endsAt         DateTime?       @db.Timestamptz(3)
  target         ShopPopupTarget @default(HOME)
  showOnPc       Boolean         @default(true)
  showOnMobile   Boolean         @default(true)
  dismissDays    Int             @default(1)
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller            @relation(fields: [sellerId], references: [id])
  image  ShopContentImage? @relation(fields: [sellerId, imageId], references: [sellerId, id], onDelete: Restrict)

  @@index([sellerId, sortOrder])
}

// ───────────── 주문·주문 품목 ─────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

// 환불 사유 주체. 구매자 사정(단순 변심)이면 반품 배송비를 받고, 판매자 사정(불량·오배송)이면 받지 않는다.
enum RefundFault {
  BUYER
  SELLER
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
}

model Order {
  id                        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId                  String            @db.Uuid
  orderNo                   Int
  buyerMemberId             String            @db.Uuid
  status                    OrderStatus       @default(PENDING_PAYMENT)
  broadcastNicknameSnapshot String
  totalAmount               Int
  rewardUsedAmount          Int               @default(0)
  // 배송(MVP는 즉시 발송만). 배송비는 주문할 때 판매자 배송비 정책으로 계산해 고정한다(totalAmount에 포함, 적립 기준에서는 제외).
  fulfillmentType           FulfillmentType   @default(IMMEDIATE)
  shippingFee               Int               @default(0)
  paymentMethod             PaymentMethod?
  pgProvider                String?
  pgTxId                    String?
  paidAt                    DateTime?         @db.Timestamptz(3)
  stockShortageAt           DateTime?         @db.Timestamptz(3)
  cancelledAt               DateTime?         @db.Timestamptz(3)
  refundedAt                DateTime?         @db.Timestamptz(3)
  // 구매 확정 시각(배송 완료 n일 뒤 자동). 주문 상태(status)는 결제 완료(PAID) 그대로 둔다.
  purchaseConfirmedAt       DateTime?         @db.Timestamptz(3)
  // 적립 스냅숏(결제 때 판정, MASTER 결정 2026-10-03): 지급 시점·회원 등급·적립률(%)·적립 예정액. 결제 때 0원이면 나중에도 적립하지 않는다.
  // 배송 완료 때는 rewardEarnTiming이 ON_DELIVERY인 주문만 rewardEarnAmount로 기록한다. 적립 정책이 없던 주문·이 기능 전 주문은 null.
  rewardEarnTiming          RewardEarnTiming?
  rewardGradeId             String?           @db.Uuid
  rewardRate                Float?
  rewardEarnAmount          Int?
  // 주문할 때 판매자 반품 배송비(편도). 정책을 나중에 바꿔도 이 주문은 그대로다. 이 기능 전 주문은 null(환불 때 현재 정책을 쓴다).
  returnFeeSnapshot         Int?
  // 환불 결과: 돌려준 금액, 사유 주체(구매자·판매자 사정, 발송 전 환불은 null일 수 있음), 환불액에서 뺀 반품 배송비
  refundAmount              Int?
  refundFault               RefundFault?
  returnFeeDeducted         Int?
  createdAt                 DateTime          @default(now()) @db.Timestamptz(3)
  // 입금 기한(주문 시각 + 판매자 설정 시간, 기본 24시간). 지나면 결제 대기 주문을 자동 취소한다(lib/server/orders/overdue.ts).
  paymentDueAt              DateTime?         @db.Timestamptz(3)
  // 입금 기한이 지나 시스템이 자동 취소한 시각. 자동 구매 제한 횟수를 셀 때 쓴다.
  autoCancelledAt           DateTime?         @db.Timestamptz(3)
  // 법정 보관(buyers/legalHold.ts): 끝난 주문의 보관 만료일(끝난 날 + 5년, 모든 회원)과, 탈퇴 회원의 끝난 주문에 다는 분리 보관 표시.
  // 분리된 주문은 판매자·구매자 일반 조회(목록·검색·상세)에서 뺀다. 보관 만료 뒤 파기는 별도 함수.
  legalHoldAt               DateTime?         @db.Timestamptz(3)
  legalRetainUntil          DateTime?         @db.Timestamptz(3)

  seller          Seller                @relation(fields: [sellerId], references: [id])
  buyerMember     BuyerMember           @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])
  items           OrderItem[]
  consents        OrderConsent[]
  shippingAddress OrderShippingAddress?
  shipment        Shipment?
  statusHistory   OrderStatusHistory[]
  stockMovements  StockMovement[]
  queueItems      QueueItem[]
  rewardLedger    RewardLedger[]
  notifications   OrderNotification[]

  @@unique([sellerId, id])
  @@unique([sellerId, orderNo])
  @@index([sellerId, buyerMemberId])
  @@index([sellerId, status])
  @@index([status, paymentDueAt])
  @@index([sellerId, buyerMemberId, autoCancelledAt])
  // 판매자 주문 목록(주문 시각 내림차순 + id 커서)
  @@index([sellerId, createdAt(sort: Desc), id(sort: Desc)])
}

model OrderItem {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId            String    @db.Uuid
  orderId             String    @db.Uuid
  productId           String    @db.Uuid
  optionId            String    @db.Uuid
  productNameSnapshot String
  optionNameSnapshot  String
  unitPrice           Int
  // 할인 전 단가(상품 가격 + 옵션 추가금). unitPrice는 주문 때 이벤트 할인을 반영한 단가다. 이 기능 전 주문은 null.
  listUnitPrice       Int?
  quantity            Int
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  // 이 품목의 재고를 뺀 시각(주문 때 또는 결제 때)과 되돌린 시각. 두 번 빼거나 두 번 되돌리지 않게 품목마다 남긴다.
  stockDeductedAt     DateTime? @db.Timestamptz(3)
  stockRestoredAt     DateTime? @db.Timestamptz(3)

  seller     Seller        @relation(fields: [sellerId], references: [id])
  order      Order         @relation(fields: [sellerId, orderId], references: [sellerId, id])
  product    Product       @relation(fields: [sellerId, productId], references: [sellerId, id])
  option     ProductOption @relation(fields: [sellerId, optionId], references: [sellerId, id])
  queueItems QueueItem[]

  @@unique([sellerId, id])
  @@index([sellerId, orderId])
}

model OrderStatusHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId   String       @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  ActorType
  actorId    String?      @db.Uuid
  reason     String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@index([sellerId, orderId])
}

// ───────────── 방송·주문대기·HIT ─────────────

enum BroadcastStatus {
  LIVE
  ENDED
}

// 판매자당 LIVE 1개는 마이그레이션 SQL 부분 유니크 인덱스.
model BroadcastSession {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String          @db.Uuid
  status    BroadcastStatus @default(LIVE)
  title     String?
  startedAt DateTime        @default(now()) @db.Timestamptz(3)
  endedAt   DateTime?       @db.Timestamptz(3)

  seller     Seller      @relation(fields: [sellerId], references: [id])
  queueItems QueueItem[]
  hitCards   HitCard[]

  @@unique([sellerId, id])
  @@index([sellerId, status])
}

enum QueueItemStatus {
  WAITING
  OPENING
  DONE
  CANCELLED
}

// 판매자당 OPENING 1건은 마이그레이션 SQL 부분 유니크 인덱스. timerSeconds 0~3600, quantity > 0 CHECK.
model QueueItem {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String          @db.Uuid
  orderId            String          @db.Uuid
  orderItemId        String          @db.Uuid
  broadcastSessionId String?         @db.Uuid
  status             QueueItemStatus @default(WAITING)
  position           Int
  receivedAt         DateTime        @db.Timestamptz(3)
  nicknameSnapshot   String
  gradeSnapshot      String?
  productLabel       String
  quantity           Int
  timerSeconds       Int             @default(0)
  openingStartedAt   DateTime?       @db.Timestamptz(3)
  doneAt             DateTime?       @db.Timestamptz(3)
  cancelledAt        DateTime?       @db.Timestamptz(3)
  cancelReason       String?
  version            Int             @default(0)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)

  seller           Seller                   @relation(fields: [sellerId], references: [id])
  order            Order                    @relation(fields: [sellerId, orderId], references: [sellerId, id])
  orderItem        OrderItem                @relation(fields: [sellerId, orderItemId], references: [sellerId, id])
  broadcastSession BroadcastSession?        @relation(fields: [sellerId, broadcastSessionId], references: [sellerId, id])
  statusHistory    QueueItemStatusHistory[]
  hitCards         HitCard[]

  @@unique([sellerId, id])
  @@unique([sellerId, orderItemId])
  @@index([sellerId, status, position])
  @@index([sellerId, broadcastSessionId])
}

model QueueItemStatusHistory {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId    String           @db.Uuid
  queueItemId String           @db.Uuid
  fromStatus  QueueItemStatus?
  toStatus    QueueItemStatus
  actorType   ActorType
  actorId     String?          @db.Uuid
  reason      String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  seller    Seller    @relation(fields: [sellerId], references: [id])
  queueItem QueueItem @relation(fields: [sellerId, queueItemId], references: [sellerId, id])

  @@index([sellerId, queueItemId])
}

model HitCard {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String   @db.Uuid
  broadcastSessionId String?  @db.Uuid
  queueItemId        String?  @db.Uuid
  buyerMemberId      String?  @db.Uuid
  nicknameSnapshot   String
  cardName           String
  note               String?
  createdByUserId    String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  seller           Seller            @relation(fields: [sellerId], references: [id])
  broadcastSession BroadcastSession? @relation(fields: [sellerId, broadcastSessionId], references: [sellerId, id])
  queueItem        QueueItem?        @relation(fields: [sellerId, queueItemId], references: [sellerId, id])
  buyerMember      BuyerMember?      @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@index([sellerId, broadcastSessionId])
}

// ───────────── 적립금 ─────────────

enum RevokeMode {
  AUTO
  MANUAL
}

// rates: { [gradeId]: { card: 퍼센트, bankTransfer: 퍼센트 } }. 실지급 스위치는 기본 꺼짐.
model RewardPolicy {
  sellerId            String           @id @db.Uuid
  rates               Json             @default("{}")
  earnStartsAt        DateTime?        @db.Timestamptz(3)
  revokeMode          RevokeMode       @default(AUTO)
  livePayoutEnabled   Boolean          @default(false)
  livePayoutChangedAt DateTime?        @db.Timestamptz(3)
  livePayoutChangedBy String?          @db.Uuid
  rankingBonusEnabled Boolean          @default(false)
  rankingBonusAmount  Int              @default(0)
  // 적립금 지급 시점(대표님 결정 2026-10-03): 결제 즉시 또는 배송 완료 후(기본)
  earnTiming          RewardEarnTiming @default(ON_DELIVERY)
  updatedAt           DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

enum RewardEarnTiming {
  ON_PAYMENT
  ON_DELIVERY
}

enum RewardLedgerType {
  EARN
  REVOKE
  USE
  RANKING_BONUS
  ADJUST
  // 소멸(탈퇴 때 남은 잔액, 마지막 적립 뒤 3년). 음수 금액, 바로 SUCCEEDED로 잔액에 반영한다.
  EXPIRE
}

enum RewardLedgerStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model RewardLedger {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String             @db.Uuid
  buyerMemberId  String             @db.Uuid
  orderId        String?            @db.Uuid
  type           RewardLedgerType
  amount         Int
  status         RewardLedgerStatus @default(PENDING)
  testMode       Boolean
  failureReason  String?
  idempotencyKey String
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?          @db.Timestamptz(3)

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])
  order       Order?      @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([sellerId, idempotencyKey])
  @@index([sellerId, buyerMemberId])
}

// balance >= 0 CHECK는 마이그레이션 SQL.
model RewardBalance {
  sellerId      String   @db.Uuid
  buyerMemberId String   @db.Uuid
  balance       Int      @default(0)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@id([sellerId, buyerMemberId])
}

// ───────────── 오버레이·감사 로그 ─────────────

model OverlayToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String    @db.Uuid
  tokenHash String    @unique
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
}

// 추가만 한다. 수정·삭제하지 않는다. 비밀번호 해시·토큰·TOTP 비밀키는 before/after에 넣지 않는다.
model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType   ActorType
  actorId     String?   @db.Uuid
  sellerId    String?   @db.Uuid
  action      String
  targetType  String?
  targetId    String?
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  // 구매자 회원이 행위자·대상인 행: 회원 id를 둘 기한(retainUntil, 기록 시각 + 거래 관련 5년·거래 무관 3개월, audit/log.ts)과
  // 탈퇴 때 거래 관련 행에 다는 분리 보관 표시(legalHoldAt, buyers/legalHold.ts). 기한 뒤 회원 id 비식별은 별도 함수.
  legalHoldAt DateTime? @db.Timestamptz(3)
  retainUntil DateTime? @db.Timestamptz(3)

  seller Seller? @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt])
  @@index([action, createdAt])
}

// ───────────── 플랫폼 구독 (판매자 → 플랫폼) ─────────────

// 요금제. 가격은 코드에 두지 않고 여기서 바꾼다(마스터). 금액은 부가세 포함 원 단위, 청구액은 salePrice.
model SubscriptionPlan {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String   @unique
  name               String
  listPrice          Int
  salePrice          Int
  // 체험하기 중 한도(대표님 결정 2026-10-02). 코드 수정 없이 마스터가 바꾼다.
  trialMessageLimit  Int      @default(100)
  trialIdentityLimit Int      @default(50)
  trialStorageMb     Int      @default(1024)
  // 마스터 승인 시각부터의 체험 일수(오버레이 전용 7, 통합 0 = 체험 없음, ARCHITECTURE 4.8.0)
  trialDays          Int      @default(0)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  subscriptions SellerSubscription[]
  priceChanges  SubscriptionPriceChange[]
  sellers       Seller[]
  pendingFor    SellerSubscription[]  @relation("PendingPlan")
  targetOf      SubscriptionPayment[] @relation("PaymentTargetPlan")
}

// 판매가 변경 기록(대표님 결정 2026-10-02). 새 가입자는 바로 새 가격, 기존 구독자는 구독을 시작할 때 적용되던 가격을 내다가
// 변경 시각 + 30일 이후 첫 결제부터 새 가격을 낸다. 청구 금액은 이 기록으로 계산한다(priceFor).
model SubscriptionPriceChange {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId           String   @db.Uuid
  listPrice        Int
  salePrice        Int
  changedAt        DateTime @db.Timestamptz(3)
  changedByAdminId String?  @db.Uuid

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([planId, changedAt])
}

enum SellerSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

// 쇼핑몰당 하나. 카드 자동결제(빌링키)만 쓴다. 빌링키는 서버 비밀키로 암호화해서만 저장한다.
model SellerSubscription {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId           String                   @unique @db.Uuid
  planId             String                   @db.Uuid
  status             SellerSubscriptionStatus @default(ACTIVE)
  billingKeyCipher   String?
  cardLabel          String?
  currentPeriodStart DateTime?                @db.Timestamptz(3)
  currentPeriodEnd   DateTime?                @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean                  @default(false)
  // 다음 결제(또는 해지 처리)를 할 시각. 예약 실행이 이 시각이 지난 구독을 처리한다. 없으면 할 일 없음.
  nextChargeAt       DateTime?                @db.Timestamptz(3)
  // 매달 기간을 세는 기준 시각(첫 결제 기간의 시작). KST 날짜·시각으로 다음 달 같은 날(없으면 말일)을 센다.
  billingAnchorAt    DateTime?                @db.Timestamptz(3)
  // 지금 구독을 시작한 시각(처음 등록, 또는 해지 뒤 다시 구독). 기존 구독자 가격 판단에 쓴다.
  subscribedAt       DateTime                 @default(now()) @db.Timestamptz(3)
  // 해지(CANCELED)된 시각. 이 뒤에 만든 청구만 구독을 되살릴 수 있다(해지 전 청구가 늦게 확정돼도 되살리지 않음).
  canceledAt         DateTime?                @db.Timestamptz(3)
  // 자동결제 실패 뒤 다시 시도한 횟수(최대 3번)와 계속 쓸 수 있는 유예 끝(실패한 날 + 7일)
  retryCount         Int                      @default(0)
  graceUntil         DateTime?                @db.Timestamptz(3)
  // STANDARD → INTEGRATED 이전 전 가격 스냅숏(ONQ 1-C, ARCHITECTURE 4.8.0). 결제가 이어지는 구독에만 남긴다.
  // 고지 발송 완료 시각(legacyPriceNoticeSentAt) + 30일 전까지는 이 금액으로 청구하고, 발송 전(null)이면 계속 이 금액이다.
  // 해지 뒤 다시 구독하면 비운다(새 가입자 가격).
  legacyPrice             Int?
  legacyPriceNoticeSentAt DateTime?             @db.Timestamptz(3)
  // 다음 결제일에 바꿀 플랜(하위 변경, ONQ 1-C-2). 갱신 결제 직전에 planId로 옮기고 비운다. 다시 지금 플랜을 고르면 비운다.
  pendingPlanId           String?               @db.Uuid
  // 이 구독은 정가로 청구한다(런칭 할인을 이미 쓴 계정이 해지 뒤 다시 구독, 대표님 결정 2026-10-04). 구독이 이어지는 동안 그대로다.
  regularPrice            Boolean               @default(false)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)

  seller      Seller                @relation(fields: [sellerId], references: [id])
  plan        SubscriptionPlan      @relation(fields: [planId], references: [id])
  pendingPlan SubscriptionPlan?     @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  payments    SubscriptionPayment[]

  @@unique([sellerId, id])
  @@index([status, nextChargeAt])
}

// PERIOD: 이용 기간 결제(첫 결제·갱신·재시도·카드 등록·체험 중 상위 변경). PRORATION: 결제 중 상위 변경의 남은 기간 차액(기간을 바꾸지 않음).
enum SubscriptionPaymentKind {
  PERIOD
  PRORATION
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  FAILED
}

// 청구 내역. 같은 구독·같은 이용 기간에는 진행 중이거나 결제된 청구가 하나만 있다(마이그레이션 SQL 부분 유니크).
model SubscriptionPayment {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId          String                    @db.Uuid
  subscriptionId    String                    @db.Uuid
  amount            Int
  status            SubscriptionPaymentStatus @default(PENDING)
  periodStart       DateTime                  @db.Timestamptz(3)
  periodEnd         DateTime                  @db.Timestamptz(3)
  providerPaymentId String?
  receiptUrl        String?
  failureReason     String?
  // 예약 실행이 만든 청구(true)인지, 판매자가 카드 등록으로 직접 낸 청구(false)인지
  scheduled         Boolean                   @default(false)
  kind              SubscriptionPaymentKind   @default(PERIOD)
  // 상위 변경 청구면 결제가 확정될 때 옮길 플랜(실패·대기면 지금 플랜 유지, ONQ 1-C-2)
  targetPlanId      String?                   @db.Uuid
  // 런칭가(판매가)로 낸 청구인지. 확정되면 판매자에 런칭 할인 사용을 남긴다(정가·이전 전 가격 청구는 false)
  launchDiscount    Boolean                   @default(false)
  paidAt            DateTime?                 @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)

  seller       Seller             @relation(fields: [sellerId], references: [id])
  subscription SellerSubscription @relation(fields: [sellerId, subscriptionId], references: [sellerId, id])
  targetPlan   SubscriptionPlan?  @relation("PaymentTargetPlan", fields: [targetPlanId], references: [id])

  @@index([sellerId, createdAt])
}

// 주문 단위 결제 전 동의(대표님 결정 2026-10-02): 「개봉하면 취소·환불이 안 돼요」. 동의하지 않으면 주문을 만들지 않는다.
// 동의 시각은 DB 시계, 고지 문구 버전을 함께 남긴다(법정 동의 기록, ARCHITECTURE).
model OrderConsent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String   @db.Uuid
  orderId       String   @db.Uuid
  kind          String
  noticeVersion String
  agreedAt      DateTime @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([orderId, kind])
  @@index([sellerId, orderId])
}

enum FulfillmentType {
  IMMEDIATE
  STORAGE
}

// 판매자 배송비 정책(판매자당 1행, 없으면 기본값). 금액은 원, 부가세 포함.
// 배송비 = 기본 배송비(상품 금액이 무료 기준 이상이면 0) + 도서산간이면 추가 배송비(무료 기준과 상관없이).
// 도서산간은 우편번호 범위 목록(remoteZipRanges: [[시작, 끝], ...])으로 판정한다.
model SellerShippingPolicy {
  sellerId        String   @id @db.Uuid
  // 무료 배송(0원) 유형. 켜면 기본 배송비·무료 기준을 쓰지 않고, 도서산간 추가비는 그대로 붙는다.
  freeShipping    Boolean  @default(false)
  baseFee         Int      @default(3000)
  freeOverAmount  Int?
  remoteSurcharge Int      @default(3000)
  remoteZipRanges Json     @default("[[63000, 63644], [40200, 40240]]")
  // 반품 배송비(편도)·교환 배송비(왕복). 구매자 사정일 때만 받는다(PRODUCT_SCOPE 「반품·교환 배송비」).
  returnFee       Int      @default(3000)
  exchangeFee     Int      @default(6000)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 주문할 때 받은 배송지(스냅숏). 회원 정보가 바뀌어도 그대로 남는다. 받는 분 이름·연락처·주소는 CUSTOMER_PII_VIEW가 있을 때만 응답에 넣는다.
model OrderShippingAddress {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String  @db.Uuid
  orderId       String  @unique @db.Uuid
  recipientName String
  phone         String
  zipCode       String
  address1      String
  address2      String?
  memo          String?
  isRemote      Boolean @default(false)

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([sellerId, orderId])
}

enum ShipmentStatus {
  READY
  IN_TRANSIT
  DELIVERED
}

// 배송 레코드(즉시 발송은 주문당 1건). 송장은 판매자가 직접 입력한다(택배사 연동은 나중).
model Shipment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId       String         @db.Uuid
  orderId        String         @unique @db.Uuid
  courier        String
  trackingNumber String
  status         ShipmentStatus @default(IN_TRANSIT)
  shippedAt      DateTime       @db.Timestamptz(3)
  deliveredAt    DateTime?      @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
  order  Order  @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([sellerId, orderId])
}

// 판매자 주문 정책(판매자당 1행, 없으면 기본값). PRODUCT_SCOPE 「무통장 입금·구매 제한 기본값」.
model SellerOrderPolicy {
  sellerId                       String    @id @db.Uuid
  // 미입금 자동 취소 사용 여부와 기간(시간). 기본 사용·24시간, 1~720시간(대표님 결정 2026-10-03).
  // 주문할 때 paymentDueAt을 정하는 데만 쓰고(끄면 기한 없음), 이미 만든 주문은 바꾸지 않는다.
  autoCancelEnabled              Boolean   @default(true)
  paymentDueHours                Int       @default(24)
  // 취소·반품 때 재고 자동 복구(기본 켜짐). 결제 전 취소·미입금 자동 취소·발송 전 환불에 적용한다.
  restockOnCancel                Boolean   @default(true)
  // 배송 중 n일 뒤 자동 배송 완료(기본 사용·7일), 배송 완료 n일 뒤 자동 구매 확정(기본 사용·7일). 1~30일(PRODUCT_SCOPE 「배송 완료」·「구매 확정」).
  autoDeliverEnabled             Boolean   @default(true)
  autoDeliverDays                Int       @default(7)
  autoConfirmEnabled             Boolean   @default(true)
  autoConfirmDays                Int       @default(7)
  // 「미입금 자동 취소 3회 → 30일 주문 막기」
  unpaidRestrictionEnabled       Boolean   @default(true)
  // 꺼져 있다가 다시 켠 시각. 이 뒤의 자동 취소만 센다(MASTER 결정).
  unpaidRestrictionEnabledAt     DateTime? @db.Timestamptz(3)
  // 「결제 후 취소 5회 → 30일 주문 막기」(기본 꺼짐). 구매자 사정(refundFault=BUYER)으로 표시한 환불만 센다.
  paidCancelRestrictionEnabled   Boolean   @default(false)
  // 켠 시각. 이 뒤의 환불만 센다(켜기 전 환불은 넣지 않음).
  paidCancelRestrictionEnabledAt DateTime? @db.Timestamptz(3)
  // 판매자별 단조 시계(orders/overdue.ts sellerEventClock)가 마지막으로 찍은 시각. 주문 생성 잠금 아래에서만 바꾼다.
  lastEventClockAt               DateTime? @db.Timestamptz(3)
  updatedAt                      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 쇼핑몰별 구매자 주문 제한. 막는 기간은 startsAt~endsAt이고, 판매자가 풀면 liftedAt을 남긴다.
// 횟수는 마지막 제한의 startsAt(또는 liftedAt) 뒤에 생긴 자동 취소만 센다.
model BuyerPurchaseRestriction {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String    @db.Uuid
  buyerMemberId String    @db.Uuid
  reason        String
  startsAt      DateTime  @db.Timestamptz(3)
  endsAt        DateTime  @db.Timestamptz(3)
  liftedAt      DateTime? @db.Timestamptz(3)
  liftedById    String?   @db.Uuid

  seller      Seller      @relation(fields: [sellerId], references: [id])
  buyerMember BuyerMember @relation(fields: [sellerId, buyerMemberId], references: [sellerId, id])

  @@index([sellerId, buyerMemberId, startsAt])
}

// 주문 알림 발송 기록(중복 발송 방지). 주문·종류마다 1행. 보내기 전에 PENDING으로 먼저 잡고(claim), 보낸 뒤 SENT·FAILED로 바꾼다.
// 실패했거나 PENDING으로 오래 멈춘 기록은 시도 횟수 안에서 다시 잡을 수 있다(lib/server/orders/notifications.ts).
enum OrderNotificationKind {
  PAYMENT_DUE_SOON
}

enum OrderNotificationStatus {
  PENDING
  SENT
  FAILED
}

model OrderNotification {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId      String                  @db.Uuid
  orderId       String                  @db.Uuid
  kind          OrderNotificationKind
  status        OrderNotificationStatus @default(PENDING)
  attempts      Int                     @default(1)
  claimedAt     DateTime                @db.Timestamptz(3)
  sentAt        DateTime?               @db.Timestamptz(3)
  failureReason String?
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [sellerId, orderId], references: [sellerId, id])

  @@unique([orderId, kind])
  @@index([sellerId, kind, status])
}

// 판매자 회원 정책. 재가입 제한(대표님 결정 2026-10-03, 기본 꺼짐): 켜면 탈퇴한 사람(본인확인 기준)이 정한 기간(일) 동안 다시 가입할 수 없다.
model SellerMemberPolicy {
  sellerId                 String   @id @db.Uuid
  rejoinRestrictionEnabled Boolean  @default(false)
  rejoinRestrictionDays    Int      @default(30)
  updatedAt                DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])
}

// 재가입 제한 목적으로만 남기는 탈퇴 회원의 본인확인 식별값 해시. 이름·휴대폰 등 다른 정보는 두지 않는다.
// 재가입 제한이 켜진 쇼핑몰에서 탈퇴할 때만 만들고, expiresAt이 지나거나 판매자가 제한을 끄면 지운다(buyers/rejoin.ts).
model BuyerRejoinBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerId  String   @db.Uuid
  ciHash    String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  seller Seller @relation(fields: [sellerId], references: [id])

  @@unique([sellerId, ciHash])
  @@index([expiresAt])
}

// 앱 안 정기 실행 heartbeat(인스턴스·작업별 마지막 실행). 감시는 앱 밖 수집기(scripts/ops/monitor.mjs)가 이 표를 읽어 판단한다.
// 작업 이름 "scheduler.tick"은 정기 실행 루프 자체(작업을 잠금 때문에 건너뛰어도 남음).
// 앱 인스턴스(이름별) 상태의 유일한 기준(ops/metrics.ts). 프로세스가 시작할 때 등록하며 새 세대 값(uuid)을 쓰고 종료 표시를 비운다.
model OpsInstance {
  name         String    @id
  generation   String
  // 정상 종료(SIGTERM·SIGINT) 때 자기 세대일 때만 남기는 종료 시각. 없으면 아무리 오래돼도 살아 있는 인스턴스로 본다.
  retiredAt    DateTime? @db.Timestamptz(3)
  registeredAt DateTime  @db.Timestamptz(3)
}

// 정기 실행 heartbeat(인스턴스·세대·작업별). 지표는 OpsInstance의 지금 세대 행만 본다.
model OpsHeartbeat {
  instance   String
  generation String
  job        String
  lastRunAt  DateTime  @db.Timestamptz(3)
  // done | skipped | failed
  lastStatus String
  lastError  String?
  // 마지막 성공 시각(실패가 이어져도 언제부터인지 알 수 있게)
  lastOkAt   DateTime? @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@id([instance, generation, job])
}

// 인프라 감시 사건(수집기가 남기는 incident 열기·닫기 등). 마스터 관리자(최고관리자)가 읽는다.
// 쓰기는 내부 토큰(OPS_INGEST_TOKEN)으로 인증한 POST /api/internal/ops/events만. 같은 (source, eventId)는 한 번만 저장한다(재전송 안전).
model OpsEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 들어온 순서(같은 occurredAt끼리 정할 때 늦게 들어온 쪽이 뒤)
  seq        BigInt   @default(autoincrement())
  source     String
  // 수집기가 붙인 사건 id(재전송 중복 제거)
  eventId    String
  // incident_open | incident_close | info 등
  kind       String
  // 같은 사건을 묶는 키(예: health, cert, version_mismatch)
  key        String
  severity   String
  message    String
  detail     Json?
  occurredAt DateTime @db.Timestamptz(3)
  // 서버가 받은 시각(보존 기간 기준)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([source, eventId])
  @@unique([seq])
  @@index([occurredAt])
  // 열린 사건 계산(수집기·key별 마지막으로 받은 사건)
  @@index([source, key, seq])
  // 보존 기간 정리(받은 시각)
  @@index([createdAt])
}

// ───────────── 관리자 화면 브랜딩 (마스터 관리자가 바꿈) ─────────────

// 관리자 화면별 파비콘·공유 카드. target: "admin"(마스터 관리자) | "seller"(파트너스 관리자, 플랫폼 공통 1벌). 값·크기는 마이그레이션 CHECK로 묶는다.
// 이미지는 저장소 결정(A: DB bytea / B: 버킷) 전까지 이 표에 바이트로 둔다. 읽기·쓰기는 lib/server/branding/store.ts 한 곳에서만 한다.
// *Hash는 바이트의 sha256 앞 12자(주소의 버전 값). 이미지가 없으면 데이터·형식·해시가 모두 null이다.
model SiteBranding {
  target        String   @id
  faviconData   Bytes?
  faviconType   String?
  faviconHash   String?
  ogTitle       String?
  ogDescription String?
  ogImageData   Bytes?
  ogImageType   String?
  ogImageHash   String?
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}
